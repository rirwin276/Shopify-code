    border-radius: 12px;
    background:
      linear-gradient(145deg, rgba(183,163,106,.68), rgba(243,222,154,.42));
    flex: 0 0 auto;
  }

  .ss-tool-row strong {
    display: block;
    color: rgba(255,255,255,.92);
    font-size: 14px;
    line-height: 1.1;
  }

  .ss-tool-row small {
    display: block;
    margin-top: 3px;
    color: rgba(255,255,255,.46);
    font-size: 12px;
    line-height: 1.25;
  }

  .ss-floating-card {
    position: absolute;
    padding: 15px 17px;
    border-radius: 20px;
    background: rgba(255,255,255,.78);
    border: 1px solid rgba(255,255,255,.88);
    box-shadow: 0 22px 70px rgba(17,16,14,.16);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .ss-floating-card strong {
    display: block;
    color: #11100e;
    font-size: 26px;
    letter-spacing: -.055em;
    line-height: 1;
  }

  .ss-floating-card span {
    display: block;
    margin-top: 4px;
    color: rgba(17,16,14,.52);
    font-size: 12px;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: .1em;
  }

  .ss-floating-card--top {
    top: 44px;
    right: -12px;
  }

  .ss-floating-card--bottom {
    left: -18px;
    bottom: 62px;
  }

  /* PROOF BAR */

  .ss-proof-bar {
    padding: 0 0 42px;
  }

  .ss-proof-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-radius: 28px;
    overflow: hidden;
    background: rgba(255,255,255,.68);
    border: 1px solid rgba(17,16,14,.08);
    box-shadow: 0 24px 80px rgba(17,16,14,.08);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .ss-proof-item {
    padding: 30px 24px;
    border-right: 1px solid rgba(17,16,14,.075);
    text-align: center;
  }

  .ss-proof-item:last-child {
    border-right: 0;
  }

  .ss-proof-item strong {
    display: block;
    color: #9f8d5a;
    font-size: clamp(34px, 4.4vw, 58px);
    line-height: .92;
    letter-spacing: -.06em;
    font-weight: 950;
  }

  .ss-proof-item span {
    display: block;
    margin-top: 8px;
    color: rgba(17,16,14,.56);
    font-size: 13px;
    line-height: 1.35;
    font-weight: 750;
  }

  /* PAIN / SOLUTION */

  .ss-pain-section {
    background: #fff;
  }

  .ss-compare-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .ss-compare-card {
    min-height: 430px;
    padding: clamp(24px, 4vw, 42px);
    border-radius: 34px;
    border: 1px solid rgba(17,16,14,.09);
    box-shadow: 0 24px 80px rgba(17,16,14,.06);
  }

  .ss-compare-card--old {
    background:
      linear-gradient(180deg, rgba(255,255,255,.88), rgba(250,248,243,.96));
  }

  .ss-compare-card--new {
    color: #fff;
    background:
      radial-gradient(circle at 15% 0%, rgba(183,163,106,.15), transparent 36%),
      linear-gradient(180deg, #171613, #080807);
  }

  .ss-card-label {
    margin-bottom: 22px;
    color: #9f8d5a;
    font-size: 12px;
    font-weight: 950;
    letter-spacing: .14em;
  }

  .ss-compare-card h3 {
    max-width: 500px;
    margin: 0 0 24px;
    font-size: clamp(26px, 3.5vw, 42px);
    line-height: 1;
    letter-spacing: -.05em;
    font-weight: 950;
  }

  .ss-compare-card--old h3 {
    color: #11100e;
  }

  .ss-compare-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 13px;
  }

  .ss-compare-card li {
    position: relative;
    padding-left: 30px;
    color: rgba(17,16,14,.62);
    font-size: 16px;
    line-height: 1.35;
    font-weight: 650;
  }

  .ss-compare-card--new li {
    color: rgba(255,255,255,.72);
  }

  .ss-compare-card li::before {
    content: "";
    position: absolute;
    top: .35em;
    left: 0;
    width: 17px;
    height: 17px;
    border-radius: 999px;
    background: rgba(17,16,14,.11);
  }

  .ss-compare-card--new li::before {
    background: #a9955d;
    box-shadow: 0 0 0 5px rgba(183,163,106,.08);
  }

  /* PROCESS */

  .ss-process-section {
    background: #fbfaf7;
    border-top: 1px solid rgba(17,16,14,.06);
    border-bottom: 1px solid rgba(17,16,14,.06);
  }

  .ss-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .ss-step-card {
    min-height: 310px;
    padding: 28px;
    border-radius: 30px;
    background: rgba(255,255,255,.70);
    border: 1px solid rgba(17,16,14,.08);
    box-shadow: 0 20px 70px rgba(17,16,14,.055);
  }

  .ss-step-num {
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    margin-bottom: 42px;
    border-radius: 18px;
    color: #11100e;
    background: rgba(183,163,106,.12);
    font-size: 14px;
    font-weight: 950;
    letter-spacing: -.02em;
  }

  .ss-step-card h3 {
    margin: 0;
    color: #11100e;
    font-size: 25px;
    line-height: 1.05;
    letter-spacing: -.04em;
    font-weight: 930;
  }

  .ss-step-card p {
    margin: 12px 0 0;
    color: rgba(17,16,14,.61);
    font-size: 15px;
    line-height: 1.52;
    font-weight: 520;
  }

  /* EXAMPLES */

  .ss-examples-section {
    background: #fff;
  }

  .ss-example-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  .ss-example-card {
    padding: 13px;
    border-radius: 30px;
    background: #fff;
    border: 1px solid rgba(17,16,14,.08);
    box-shadow: 0 22px 70px rgba(17,16,14,.06);
  }

  .ss-example-art {
    height: auto;
    aspect-ratio: 1 / 1;
    border-radius: 22px;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .ss-example-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 700ms cubic-bezier(.22, .8, .26, 1);
  }

  /* Photos start zoomed-in and settle into place as the card scrolls into view */
  @media (prefers-reduced-motion: no-preference) {
    .ss-example-card.ss-reveal .ss-example-photo {
      transform: scale(1.18);
      transition: transform 1100ms cubic-bezier(.22, .8, .26, 1);
    }

    .ss-example-card.ss-reveal.is-visible .ss-example-photo {
      transform: scale(1);
    }

    .ss-example-card.ss-reveal.is-visible:hover .ss-example-photo {
      transform: scale(1.06);
    }
  }

  .ss-example-card {
    transition: transform 320ms ease, box-shadow 320ms ease;
  }

  .ss-example-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 32px 90px rgba(17,16,14,.12);
  }

  .ss-example-card:hover .ss-example-photo {
    transform: scale(1.06);
  }

  .ss-step-card {
    transition: transform 320ms ease, box-shadow 320ms ease;
  }

  .ss-step-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 28px 90px rgba(17,16,14,.10);
  }

  .ss-hero-photo-frame {
    border-radius: 25px;
    overflow: hidden;
    min-height: 470px;
    display: grid;
    background: #11100e;
  }

  .ss-hero-photo {
    width: 100%;
    height: 100%;
    min-height: 470px;
    object-fit: cover;
    display: block;
  }

  .ss-admin-panel--photo {
    padding: 12px;
    overflow: hidden;
  }

  .ss-panel-photo {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 24px;
  }

  /* Dashboard section life */
  .ss-store-row {
    transition: background 240ms ease, border-color 240ms ease, transform 240ms ease;
  }

  .ss-store-row:hover {
    background: rgba(255,255,255,.12);
    border-color: rgba(183,163,106,.34);
    transform: translateX(4px);
  }

  .ss-store-dot {
    position: relative;
  }

  .ss-store-dot::after {
    content: "";
    position: absolute;
    top: 5px;
    right: 5px;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #5dd97c;
    box-shadow: 0 0 0 0 rgba(93,217,124,.55);
  }

  .ss-store-dot--gold::after {
    background: #ead892;
    box-shadow: 0 0 0 0 rgba(234,216,146,.55);
  }

  .ss-admin-actions span {
    transition: background 240ms ease, border-color 240ms ease, color 240ms ease;
  }

  .ss-admin-actions span:hover {
    background: rgba(183,163,106,.16);
    border-color: rgba(183,163,106,.36);
    color: #f4e2a6;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ss-store-dot::after {
      animation: ssDotPulse 2.4s ease-out infinite;
    }

    .ss-store-dot--gold::after {
      animation: ssDotPulseGold 2.4s ease-out infinite;
      animation-delay: -1.2s;
    }

    .ss-admin-panel {
      animation: ssPanelFloat 7s ease-in-out infinite alternate;
    }

    .ss-panel-photo {
      transform: scale(1.12);
      transition: transform 1200ms cubic-bezier(.22, .8, .26, 1);
    }

    .ss-admin-panel.is-visible .ss-panel-photo {
      transform: scale(1);
    }
  }

  @keyframes ssDotPulse {
    0%   { box-shadow: 0 0 0 0 rgba(93,217,124,.55); }
    70%  { box-shadow: 0 0 0 9px rgba(93,217,124,0); }
    100% { box-shadow: 0 0 0 0 rgba(93,217,124,0); }
  }

  @keyframes ssDotPulseGold {
    0%   { box-shadow: 0 0 0 0 rgba(234,216,146,.55); }
    70%  { box-shadow: 0 0 0 9px rgba(234,216,146,0); }
    100% { box-shadow: 0 0 0 0 rgba(234,216,146,0); }
  }

  @keyframes ssPanelFloat {
    from { transform: translateY(0); }
    to   { transform: translateY(-10px); }
  }

  .ss-example-art span {
    color: #fff;
    font-size: 31px;
    font-weight: 950;
    letter-spacing: -.06em;
    transform: skewX(-7deg);
    text-shadow: 0 12px 34px rgba(0,0,0,.22);
  }

  .ss-example-art--team {
    background:
      radial-gradient(circle at 50% 40%, rgba(255,255,255,.18), transparent 34%),
      linear-gradient(145deg, #173a7a, #11100e);
  }

  .ss-example-art--unit {
    background:
      radial-gradient(circle at 50% 40%, rgba(183,163,106,.14), transparent 35%),
      linear-gradient(145deg, #293224, #090a08);
  }

  .ss-example-art--trip {
    background:
      radial-gradient(circle at 50% 40%, rgba(255,255,255,.20), transparent 34%),
      linear-gradient(145deg, #b76d45, #22110c);
  }

  .ss-example-art--business {
    background:
      radial-gradient(circle at 50% 40%, rgba(183,163,106,.12), transparent 35%),
      linear-gradient(145deg, #242424, #090909);
  }

  .ss-example-card h3 {
    margin: 20px 12px 0;
    color: #11100e;
    font-size: 19px;
    line-height: 1.1;
    letter-spacing: -.03em;
    font-weight: 920;
  }

  .ss-example-card p {
    margin: 9px 12px 16px;
    color: rgba(17,16,14,.58);
    font-size: 14px;
    line-height: 1.45;
    font-weight: 520;
  }

  /* DASHBOARD */

  .ss-dashboard-section {
    background:
      radial-gradient(circle at 80% 20%, rgba(183,163,106,.09), transparent 27%),
      linear-gradient(180deg, #11100e, #070706);
    color: #fff;
  }

  .ss-dashboard-section .ss-h2 {
    color: #fff;
  }

  .ss-dashboard-section .ss-body {
    color: rgba(255,255,255,.62);
  }

  .ss-dashboard-grid {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(360px, 1fr);
    gap: 52px;
    align-items: center;
  }

  .ss-feature-list {
    display: grid;
    gap: 14px;
    margin-top: 30px;
  }

  .ss-feature-list div {
    padding: 17px 18px;
    border-radius: 20px;
    background: rgba(255,255,255,.07);
    border: 1px solid rgba(255,255,255,.09);
  }

  .ss-feature-list strong {
    display: block;
    color: #fff;
    font-size: 15px;
    font-weight: 900;
  }

  .ss-feature-list span {
    display: block;
    margin-top: 4px;
    color: rgba(255,255,255,.52);
    font-size: 13px;
    line-height: 1.4;
  }

  .ss-admin-panel {
    padding: 22px;
    border-radius: 34px;
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.11);
    box-shadow: 0 40px 120px rgba(0,0,0,.34);
  }

  .ss-admin-top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: flex-start;
    margin-bottom: 20px;
  }

  .ss-admin-top button {
    border: 0;
    border-radius: 999px;
    padding: 11px 15px;
    color: #11100e;
    background: #efe4bf;
    font-size: 12px;
    font-weight: 900;
  }

  .ss-store-row {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 16px;
    border-radius: 22px;
    background: rgba(255,255,255,.075);
    border: 1px solid rgba(255,255,255,.08);
    margin-bottom: 11px;
  }

  .ss-store-row strong {
    display: block;
    color: #fff;
    font-size: 14px;
    font-weight: 900;
  }

  .ss-store-row span {
    display: block;
    margin-top: 3px;
    color: rgba(255,255,255,.48);
    font-size: 12px;
  }

  .ss-store-row em {
    margin-left: auto;
    color: #f4e2a6;
    font-size: 12px;
    font-style: normal;
    font-weight: 850;
  }

  .ss-store-dot {
    width: 38px;
    height: 38px;
    border-radius: 14px;
    background: #244b9b;
  }

  .ss-store-dot--gold {
    background: #a9955d;
  }

  .ss-admin-actions {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-top: 18px;
  }

  .ss-admin-actions span {
    padding: 13px;
    border-radius: 16px;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.08);
    color: rgba(255,255,255,.68);
    font-size: 12px;
    font-weight: 800;
    text-align: center;
  }

  /* ROLES */

  .ss-roles-section {
    background: #fbfaf7;
  }

  .ss-role-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .ss-role-card {
    padding: clamp(24px, 4vw, 40px);
    border-radius: 34px;
    background: rgba(255,255,255,.72);
    border: 1px solid rgba(17,16,14,.08);
    box-shadow: 0 24px 80px rgba(17,16,14,.055);
  }

  .ss-role-card span {
    color: #9f8d5a;
    font-size: 12px;
    font-weight: 950;
    letter-spacing: .14em;
  }

  .ss-role-card h3 {
    margin: 22px 0 0;
    color: #11100e;
    font-size: clamp(25px, 3vw, 38px);
    line-height: 1.02;
    letter-spacing: -.05em;
    font-weight: 950;
  }

  .ss-role-card p {
    margin: 14px 0 0;
    color: rgba(17,16,14,.62);
    font-size: 16px;
    line-height: 1.52;
    font-weight: 520;
  }

  /* TRUST */

  .ss-trust-section {
    background: #fff;
  }

  .ss-trust-shell {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(320px, .75fr);
    gap: 42px;
    align-items: start;
    padding: clamp(28px, 5vw, 54px);
    border-radius: 40px;
    background:
      radial-gradient(circle at 0% 0%, rgba(183,163,106,.10), transparent 35%),
      linear-gradient(180deg, #fbf8ef, #fff);
    border: 1px solid rgba(17,16,14,.08);
    box-shadow: 0 30px 110px rgba(17,16,14,.075);
  }

  .ss-trust-points {
    display: grid;
    gap: 13px;
  }

  .ss-trust-points div {
    padding: 18px;
    border-radius: 22px;
    background: rgba(255,255,255,.78);
    border: 1px solid rgba(17,16,14,.08);
  }

  .ss-trust-points strong {
    display: block;
    color: #11100e;
    font-size: 16px;
    font-weight: 920;
  }

  .ss-trust-points span {
    display: block;
    margin-top: 5px;
    color: rgba(17,16,14,.58);
    font-size: 13px;
    line-height: 1.42;
  }

  /* FAQ */

  .ss-faq-section {
    background: #fbfaf7;
    border-top: 1px solid rgba(17,16,14,.06);
    border-bottom: 1px solid rgba(17,16,14,.06);
  }

  .ss-faq-list {
    display: grid;
    gap: 12px;
    margin-top: 38px;
  }

  .ss-faq-list details {
    border-radius: 22px;
    background: rgba(255,255,255,.72);
    border: 1px solid rgba(17,16,14,.08);
    overflow: hidden;
  }

  .ss-faq-list summary {
    cursor: pointer;
    padding: 20px 22px;
    color: #11100e;
    font-size: 16px;
    font-weight: 900;
    list-style: none;
  }

  .ss-faq-list summary::-webkit-details-marker {
    display: none;
  }

  .ss-faq-list summary::after {
    content: "+";
    float: right;
    color: #9f8d5a;
    font-size: 20px;
    line-height: 1;
  }

  .ss-faq-list details[open] summary::after {
    content: "–";
  }

  .ss-faq-list p {
    margin: 0;
    padding: 0 22px 22px;
    color: rgba(17,16,14,.62);
    font-size: 15px;
    line-height: 1.5;
  }

  /* FINAL CTA */

  .ss-final-cta {
    position: relative;
    padding: 118px 0;
    background:
      radial-gradient(circle at 50% 0%, rgba(183,163,106,.11), transparent 34%),
      linear-gradient(180deg, #fff, #f8f3e8);
  }

  .ss-final-title {
    margin: 0;
    color: #11100e;
    font-size: clamp(42px, 6vw, 82px);
    line-height: .96;
    letter-spacing: -.065em;
    font-weight: 950;
  }

  .ss-final-sub {
    margin: 18px auto 30px;
    max-width: 560px;
    color: rgba(17,16,14,.62);
    font-size: clamp(17px, 2vw, 22px);
    line-height: 1.5;
    font-weight: 500;
  }

  /* LOGGED-IN */

  .ss-member-hero {
    position: relative;
    padding: 94px 0 74px;
  }

  .ss-member-shell {
    padding: clamp(28px, 6vw, 66px);
    border-radius: 40px;
    background:
      radial-gradient(circle at 10% 0%, rgba(183,163,106,.10), transparent 30%),
      linear-gradient(145deg, rgba(255,255,255,.82), rgba(255,255,255,.56));
    border: 1px solid rgba(255,255,255,.8);
    box-shadow: 0 34px 120px rgba(17,16,14,.10);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
  }

  .ss-member-title {
    margin: 0;
    color: #11100e;
    font-size: clamp(44px, 7vw, 90px);
    line-height: .94;
    letter-spacing: -.065em;
    font-weight: 950;
  }

  .ss-member-sub {
    max-width: 680px;
    margin: 18px 0 0;
    color: rgba(17,16,14,.62);
    font-size: clamp(17px, 2vw, 22px);
    line-height: 1.5;
  }

  .ss-action-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .ss-pill {
    min-height: 46px;
    padding: 0 19px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 850;
  }

  .ss-pill--primary {
    color: #fff;
    background: #11100e;
    border: 1px solid rgba(183,163,106,.28);
    box-shadow: 0 16px 44px rgba(17,16,14,.16);
  }

  .ss-pill--primary:hover,
  .ss-pill--glass:hover {
    transform: translateY(-2px);
  }

  .ss-pill--glass {
    color: #11100e;
    background: rgba(255,255,255,.66);
    border: 1px solid rgba(17,16,14,.12);
  }

  /* MARQUEE */

  .ss-marquee-wrap {
    overflow: hidden;
    border-top: 1px solid rgba(17,16,14,.06);
    border-bottom: 1px solid rgba(17,16,14,.06);
    padding: 15px 0;
    background: rgba(255,255,255,.72);
  }

  .ss-marquee-track {
    display: flex;
    gap: 0;
    width: max-content;
    animation: ssMarquee 30s linear infinite;
    white-space: nowrap;
    will-change: transform;
  }

  .ss-marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0 30px;
    color: rgba(17,16,14,.52);
    font-size: 12px;
    font-weight: 850;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .ss-marquee-dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: rgba(159,141,90,.55);
  }

  @keyframes ssMarquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .ss-dashboard-img-hidden {
    display: none;
  }

  /* RESPONSIVE */

  @media (max-width: 980px) {
    .ss-hero {
      padding-top: 78px;
    }

    .ss-hero-grid,
