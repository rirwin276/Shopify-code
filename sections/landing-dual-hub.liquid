      margin-right: auto;
    }

    .ss-hero-actions,
    .ss-hero-proofline {
      justify-content: center;
    }

    .ss-hero-visual {
      min-height: auto;
      max-width: 560px;
      margin: 12px auto 0;
    }

    .ss-floating-card--top {
      right: 10px;
    }

    .ss-floating-card--bottom {
      left: 10px;
      bottom: 34px;
    }

    .ss-example-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .ss-steps-grid {
      grid-template-columns: 1fr;
    }

    .ss-step-card {
      min-height: auto;
    }

    .ss-step-num {
      margin-bottom: 26px;
    }
  }

  @media (max-width: 720px) {
    .ss-wrap {
      width: min(100% - 32px, 1180px);
    }

    .ss-section {
      padding: 74px 0;
    }

    .ss-hero {
      padding: 58px 0 46px;
    }

    .ss-hero-title {
      font-size: clamp(48px, 14vw, 70px);
      letter-spacing: -.07em;
    }

    .ss-hero-sub {
      font-size: 17px;
    }

    .ss-hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .ss-btn {
      width: 100%;
    }

    .ss-device-card {
      border-radius: 28px;
      padding: 10px;
    }

    .ss-dashboard-preview {
      min-height: auto;
      padding: 18px;
      border-radius: 22px;
    }

    .ss-hero-photo-frame,
    .ss-hero-photo {
      min-height: 300px;
      border-radius: 22px;
    }

    .ss-preview-head h3,
    .ss-admin-top h3 {
      font-size: 24px;
    }

    .ss-product-strip {
      grid-template-columns: 1fr 1fr;
    }

    .ss-product-card:nth-child(3) {
      grid-column: 1 / -1;
      min-height: 128px;
    }

    .ss-floating-card {
      display: none;
    }

    .ss-proof-grid,
    .ss-compare-grid,
    .ss-role-grid,
    .ss-example-grid {
      grid-template-columns: 1fr;
    }

    .ss-proof-item {
      border-right: 0;
      border-bottom: 1px solid rgba(17,16,14,.075);
    }

    .ss-proof-item:last-child {
      border-bottom: 0;
    }

    .ss-compare-card {
      min-height: auto;
    }

    .ss-admin-actions {
      grid-template-columns: 1fr;
    }

    .ss-member-hero {
      padding: 54px 0 48px;
    }

    .ss-action-row {
      flex-direction: column;
      align-items: stretch;
    }

    .ss-pill {
      width: 100%;
    }
  }

  @media (max-width: 420px) {
    .ss-hero-title {
      font-size: 47px;
    }

    .ss-h2 {
      font-size: 36px;
    }

    .ss-final-title {
      font-size: 42px;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .ss-reveal {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }

    .ss-marquee-track,
    .ss-bg-orb,
    .ss-floating-card,
    .ss-hero-photo {
      animation: none;
    }

    .ss-btn,
    .ss-pill {
      transition: none;
    }
  }
</style>

<script>
(function() {
  var root = document.getElementById('ss-home-{{ section.id }}');
  if (!root) return;

  var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var revealEls = root.querySelectorAll('.ss-reveal');

  if (prefersReducedMotion) {
    revealEls.forEach(function(el) {
      el.classList.add('is-visible');
    });
    return;
  }

  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (!entry.isIntersecting) return;

        var delay = parseInt(entry.target.getAttribute('data-delay') || '0', 10);
        window.setTimeout(function() {
          entry.target.classList.add('is-visible');
        }, delay);

        io.unobserve(entry.target);
      });
    }, {
      threshold: 0.12,
      rootMargin: '0px 0px -40px 0px'
    });

    revealEls.forEach(function(el) {
      io.observe(el);
    });
  } else {
    revealEls.forEach(function(el) {
      el.classList.add('is-visible');
    });
  }
})();
</script>

{% endif %}

