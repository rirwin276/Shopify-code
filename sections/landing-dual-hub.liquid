<style>
  /* =========================
     STELLA & SAGE PREMIUM HOME
  ========================== */

  .ss-home,
  .ss-home * {
    box-sizing: border-box;
  }

  .ss-home {
    position: relative;
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Helvetica, Arial, sans-serif;
    color: #11100e;
    background:
      radial-gradient(circle at 18% 5%, rgba(183, 163, 106, 0.10), transparent 30%),
      radial-gradient(circle at 80% 8%, rgba(255, 255, 255, 0.85), transparent 22%),
      linear-gradient(180deg, #fbf8f1 0%, #fffdf9 22%, #ffffff 50%, #fbfaf7 100%);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .ss-wrap {
    width: min(1180px, calc(100% - 44px));
    margin: 0 auto;
  }

  .ss-wrap--narrow {
    max-width: 760px;
  }

  .ss-wrap--medium {
    max-width: 920px;
  }

  .ss-center {
    text-align: center;
  }

  .ss-bg-orb {
    position: absolute;
    border-radius: 999px;
    pointer-events: none;
    filter: blur(12px);
    opacity: .34;
  }

  .ss-bg-orb--one {
    width: 420px;
    height: 420px;
    top: -160px;
    left: -120px;
    background: rgba(183, 163, 106, 0.10);
  }

  .ss-bg-orb--two {
    width: 520px;
    height: 520px;
    top: 240px;
    right: -220px;
    background: rgba(14, 14, 14, 0.08);
  }

  @media (prefers-reduced-motion: no-preference) {
    .ss-reveal {
      opacity: 0;
      transform: translateY(26px) scale(.985);
      filter: blur(5px);
      transition:
        opacity 720ms cubic-bezier(.22, .8, .26, 1),
        transform 720ms cubic-bezier(.22, .8, .26, 1),
        filter 720ms cubic-bezier(.22, .8, .26, 1);
    }

    .ss-reveal.is-visible {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }

    .ss-bg-orb {
      animation: ssOrbFloat 14s ease-in-out infinite alternate;
    }

    .ss-bg-orb--two {
      animation-duration: 18s;
      animation-delay: -6s;
    }

    .ss-floating-card {
      animation: ssCardFloat 6s ease-in-out infinite alternate;
    }

    .ss-floating-card--bottom {
      animation-delay: -3s;
    }

    .ss-hero-photo {
      animation: ssKenBurns 22s ease-in-out infinite alternate;
    }
  }

  @keyframes ssOrbFloat {
    from { transform: translate(0, 0); }
    to { transform: translate(34px, 26px); }
  }

  @keyframes ssCardFloat {
    from { transform: translateY(0); }
    to { transform: translateY(-12px); }
  }

  @keyframes ssKenBurns {
    from { transform: scale(1); }
    to { transform: scale(1.07); }
  }

  .ss-eyebrow,
  .ss-mini-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
