{% comment %}
  LANDING — Stella & Sage Premium Front Page (V13 toned gold)
  - Built from existing V11 homepage file.
  - Keeps existing logged-in customer/store tag logic.
  - Logged-out: mobile offer + real team gallery → existing reviews → setup → organizer benefits → existing catalog → FAQ → CTA.
  - Logged-in: Premium welcome → store links → second store CTA → marquee.
  - No backend required.
  - Existing schema IDs preserved so current theme settings keep working.
  - V13 tones down gold intensity for a cleaner Apple-grade look.
{% endcomment %}

{%- assign dashboard_url = section.settings.dashboard_url | default: '/pages/portal' -%}
{%- assign request_url = section.settings.request_url | default: '/pages/private-storefronts' -%}
{%- assign mo_type = section.settings.metaobject_type | default: 'storefront' | strip -%}
{%- capture login_url -%}{{ routes.storefront_login_url }}?return_to={{ dashboard_url | url_encode }}{%- endcapture -%}

{%- comment -%}Logged-in: parse storefront tags & metaobjects, same core logic as previous homepage.{%- endcomment -%}
{%- assign has_storefront = false -%}
{%- assign store_count = 0 -%}
{%- assign storefront_tags = '' -%}
{%- assign admin_handles = '' -%}

{%- if customer -%}
  {%- for tag in customer.tags -%}
    {%- assign tag_down = tag | downcase | strip -%}
    {%- if tag_down contains 'b2b-admin-' -%}
      {%- assign ah = tag_down | remove: 'b2b-admin-' | strip -%}
      {%- if ah != blank -%}
        {%- assign admin_handles = admin_handles | append: '||' | append: ah | append: '||' -%}
      {%- endif -%}
    {%- elsif tag_down contains 'b2b-' -%}
      {%- assign has_storefront = true -%}
      {%- assign storefront_tags = storefront_tags | append: tag_down | append: '||' -%}
      {%- assign store_count = store_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- assign store_meta = blank -%}
{%- if shop.metaobjects[mo_type] and shop.metaobjects[mo_type].values != blank -%}
  {%- assign store_meta = shop.metaobjects[mo_type].values -%}
{%- endif -%}

{%- assign welcome_name = customer.first_name | strip -%}
{%- if welcome_name == blank and customer -%}
  {%- assign welcome_name = customer.email | split: '@' | first -%}
{%- endif -%}

<section class="ss-home{% unless customer %} ss-ad-home{% endunless %}" data-ss-home id="ss-home-{{ section.id }}">

  {%- if customer -%}

    {{ 'ss-member-home.css' | asset_url | stylesheet_tag }}

    {%- comment -%} =========================
      LOGGED-IN VIEW
    ========================== {%- endcomment -%}

    <div class="ss-bg-orb ss-bg-orb--one"></div>
    <div class="ss-bg-orb ss-bg-orb--two"></div>

    <section class="ss-member-hero ss-reveal">
      <div class="ss-wrap">
        <div class="ss-member-shell">
          <div class="ss-eyebrow">
            <span class="ss-eyebrow-dot"></span>
            STELLA & SAGE DASHBOARD
          </div>

          <h1 class="ss-member-title">{{ section.settings.welcome_prefix | escape }}{{ welcome_name | escape }}.</h1>
          <p class="ss-member-sub">{{ section.settings.greeting_sub | escape }}</p>

          <div class="ss-action-row">
            {%- if has_storefront -%}
              {%- assign tags_arr = storefront_tags | split: '||' -%}
              {%- for t in tags_arr -%}
                {%- if t != blank -%}
                  {%- assign s_handle = t | remove: 'b2b-' | strip -%}
                  {%- assign s_url = '/pages/' | append: s_handle -%}
                  {%- assign s_name = s_handle | replace: '-', ' ' | capitalize -%}

                  {%- if store_meta != blank -%}
                    {%- for mo in store_meta -%}
                      {%- assign mo_page = mo.page.value | default: mo.page -%}
                      {%- assign mo_slug = mo.slug.value | default: mo.slug -%}
                      {%- assign mo_h = '' -%}

                      {%- if mo_page != blank and mo_page.handle != blank -%}
                        {%- assign mo_h = mo_page.handle | downcase | strip -%}
                      {%- elsif mo_slug != blank -%}
                        {%- assign mo_h = mo_slug | downcase | strip -%}
                      {%- endif -%}

                      {%- if mo_h == s_handle -%}
                        {%- assign mo_name = mo.display_name.value | default: mo.display_name -%}
                        {%- if mo_name != blank -%}{%- assign s_name = mo_name -%}{%- endif -%}
                        {%- if mo_page != blank and mo_page.url != blank -%}{%- assign s_url = mo_page.url -%}{%- endif -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}

                  <a class="ss-pill ss-pill--primary" href="{{ s_url }}">Open {{ s_name | escape }} →</a>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            <a class="ss-pill ss-pill--glass" href="{{ dashboard_url }}?stay=1">{{ section.settings.dashboard_label | escape }}</a>
            <a class="ss-pill ss-pill--glass" href="{{ routes.account_url }}">{{ section.settings.orders_label | escape }}</a>
          </div>
        </div>
      </div>
    </section>

    {%- comment -%}
      Placement slots. Sections that live outside this one (approved reviews,
      the public catalog) move themselves into these anchors at runtime, so the
      order on screen is decided here rather than by whichever script wins the
      race. See ss-home-catalog-controller.js and ss-featured-store-reviews.
    {%- endcomment -%}
    <div class="ss-home-slot" data-ss-home-slot="reviews"></div>

    <section class="ss-section ss-reveal">
      <div class="ss-wrap ss-wrap--narrow ss-center">
        <div class="ss-mini-kicker">CREATE ANOTHER STORE</div>
        <h2 class="ss-h2">{{ section.settings.second_store_headline | escape }}</h2>
        <p class="ss-body">{{ section.settings.second_store_body | escape }}</p>
        <a class="ss-btn ss-btn--dark" href="{{ request_url }}">{{ section.settings.second_store_cta | escape }} →</a>
      </div>
    </section>

  {%- else -%}

    {%- comment -%}
      One label for one action. This page had five calls to action under four
      different names — "Build my free team store", "Create my free store",
      "Start my free store" — which reads as three offers and makes it
      impossible to tell which placement is doing the work.
    {%- endcomment -%}
    {%- assign cta_label = section.settings.cta_label | default: 'Build my free team store' -%}
    <div class="ss-ad" data-ss-ad>
      <section class="ad-hero">
        <div class="ad-wrap ad-hero-grid">
          <div>
            <p class="ad-kicker">{{ section.settings.hero_kicker | escape }}</p>
            <h1>{{ section.settings.hero_headline | escape }}<br><em>{{ section.settings.hero_headline_em | escape }}</em></h1>
            <p class="ad-intro">{{ section.settings.hero_intro }}</p>
            {%- comment -%}
              The price line. "Free" appears a dozen times on this page and the
              question it leaves unanswered is "free store, but what does a
              hoodie cost?" — twelve frees with no number starts to read like a
              catch. These come from the same catalogue the product section
              further down renders, so the page cannot quote two prices.
            {%- endcomment -%}
            <p class="ad-pricenote">{{ section.settings.hero_price_line | escape }}<span class="ad-pricenote-ship">Free US shipping</span></p>
            <a class="ad-start" data-ad-hero-cta href="{{ request_url | escape }}">{{ cta_label | escape }} <span aria-hidden="true">→</span></a>
            <p class="ad-micro">{{ section.settings.hero_micro | escape }}</p>
            <a class="ad-secondary" href="#ad-store-{{ section.id }}">Explore a demo store <span aria-hidden="true">↗</span></a><p class="ad-signin">Always free to create. You only pay for gear you order.</p>
          </div>
          <div class="ad-stage" aria-label="Team gear examples">
            <div class="ad-stage-top"><span>YOUR LOGO. THEIR FAVORITE GEAR.</span><span>Real team stores</span></div>
            <figure class="ad-gallery-panel" data-ad-panel="cashmere">
              <img src="{{ 'ss-home-cashmere-showcase.webp' | asset_url }}" alt="Cashmere Youth Football gray hoodie and white coaches polo, shown as 3D product mockups" width="1200" height="800" loading="eager" fetchpriority="high">
              <figcaption class="ad-gallery-caption">Cashmere Youth Football<small>Youth hoodies to coaches polos. One team store.</small></figcaption>
            </figure>
            <figure class="ad-gallery-panel" data-ad-panel="sapphire" hidden>
              <div class="ad-sapphire-images">
                <img src="{{ 'ss-home-sapphire-hoodie.webp' | asset_url }}" alt="Sapphire Shooters navy hoodie with turquoise team artwork" width="800" height="800" loading="lazy">
                <img src="{{ 'ss-home-sapphire-tee.webp' | asset_url }}" alt="Sapphire Shooters navy team T-shirt" width="800" height="800" loading="lazy">
              </div>
              <figcaption class="ad-gallery-caption">Sapphire Shooters<small>Soccer spirit. Sideline-ready shirts and hoodies.</small></figcaption>
            </figure>
            <div class="ad-gallery-tabs" role="group" aria-label="Choose a team example">
              <button type="button" data-ad-team="cashmere" aria-pressed="true">Cashmere Football</button>
              <button type="button" data-ad-team="sapphire" aria-pressed="false">Sapphire Shooters</button>
            </div>
          </div>
        </div>
      </section>
      {%- comment -%}
        Veteran owned sits here rather than in 11px grey at the bottom of the
        page. Three of the four audiences this store serves — units, stations,
        and San Diego youth sports — read it as a reason to trust the company,
        which makes it a headline fact, not a footer credit.
      {%- endcomment -%}
      <div class="ad-benefits"><div class="ad-wrap ad-benefit-row"><span class="ad-benefit-vet">★ Veteran owned &amp; operated</span><span>Free US shipping</span><span>No setup fees</span><span>No minimums</span><span>No deadlines</span><span>Made &amp; shipped for you</span></div></div>
      {%- comment -%}
        How it works, before the demos rather than after them. A coach who has
        never heard of us needs the mechanism first: two of these interactive
        demos used to land before anyone had said what actually happens, and
        the demo hits much harder once you already know your store is fifteen
        minutes away.
      {%- endcomment -%}
      <section class="ad-section">
        <div class="ad-wrap">
          <p class="ad-kicker">Self-service. Start to finish.</p>
          <h2>From team logo<br>to team store.</h2>
          <p class="ad-section-intro">No website to design. No boxes of shirts to buy. Just a simpler way to get your team geared up.</p>
          <ol class="ad-steps">
            <li><span class="ad-step-num">01</span><h3>Add your logo &amp; colors</h3><p>Sign in, add your team name, upload your logo, and choose your colors. About 2 minutes.</p></li>
            <li><span class="ad-step-num">02</span><h3>Your store builds automatically</h3><p>Your logo goes on your gear. Your private store is ready in about 15 minutes, with no setup fee.</p></li>
            <li><span class="ad-step-num">03</span><h3>Make it yours. Share the link.</h3><p>Parents pick their own size and color, pay online, and get their order shipped directly to them.</p></li>
          </ol>
        </div>
      </section>

      {%- comment -%}
        Proof sits between "here is how it works" and "here, try it". A coach
        who has just read the three steps is asking whether it actually works
        for people like them; that question is better answered before the demo
        than after it. Renders nothing until there are approved reviews.
      {%- endcomment -%}
      <div class="ss-home-slot" data-ss-home-slot="reviews"></div>

      <section class="ad-section ad-store-section" id="ad-store-{{ section.id }}" data-ad-store data-catalog-url="{{ 'ss-raptors-demo.json' | asset_url }}">
        <div class="ad-wrap">
          <div class="ad-section-heading"><div><p class="ad-kicker">Don't picture it. Step inside.</p><h2>This could be<br>your team's store.</h2></div><p class="ad-section-intro">Browse the Raptors gear. Open a product. Try the colors. This is how easy shopping your team store can feel.</p></div>
          <div class="ad-store-window">
            <div class="ad-store-chrome"><span class="ad-window-dots" aria-hidden="true">● ● ●</span><span>YOUR TEAM STORE</span><span class="ad-demo-tag">Demo · Browse only</span></div>
            <div class="ad-store-banner"><div><p>THE TEAM. THE FAMILIES. THE FANS.</p><h3>RAPTORS<br><span>GEAR UP.</span></h3></div><div class="ad-store-banner-note">A whole team look.<br>Zero group orders.</div></div>
            <div class="ad-store-toolbar"><strong>The team shop</strong><div role="group" aria-label="Filter demo products"><button type="button" data-store-filter="all" aria-pressed="true">All gear</button><button type="button" data-store-filter="adult" aria-pressed="false">Adults</button><button type="button" data-store-filter="youth" aria-pressed="false">Kids</button><button type="button" data-store-filter="extras" aria-pressed="false">Extras</button></div></div>
            <div class="ad-store-grid" data-store-grid><p>Loading the Raptors gear…</p></div>
            <p class="ad-store-footnote">Real Raptors product photos. A demo you can explore freely—no sign-in, cart, or checkout.</p>
          </div>
          <div class="ad-store-after"><p><strong>Your logo goes here next.</strong> Create your store, choose your gear, and share one link.</p><a class="ad-start" href="{{ request_url | escape }}">{{ cta_label | escape }} <span aria-hidden="true">→</span></a></div>
        </div>
        <dialog class="ad-product-dialog" data-store-dialog aria-label="Demo product details"><button class="ad-dialog-close" type="button" data-store-close aria-label="Close product preview">×</button><div data-store-detail></div></dialog>
      </section>
      {%- comment -%}
        The six lettering faces the Pro Builder actually offers, so each picker
        button previews in the face it selects instead of naming it. Loaded
        non-render-blocking: the buttons show a fallback for a moment rather
        than holding up the page for six display fonts.
      {%- endcomment -%}
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link rel="stylesheet" media="print" onload="this.media='all'"
            href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,900&family=Changa+One:ital@1&family=Graduate&family=Russo+One&family=Saira+Stencil+One&family=Teko:wght@700&display=swap">
      <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,900&family=Changa+One:ital@1&family=Graduate&family=Russo+One&family=Saira+Stencil+One&family=Teko:wght@700&display=swap"></noscript>
      <section class="ad-section ad-play-section" id="ad-try-{{ section.id }}">
        <div class="ad-wrap">
          <p class="ad-kicker">One design. Every player. Every proud parent.</p>
          <h2>Their name.<br>Their number. Their shirt.</h2>
          <p class="ad-section-intro">Pick a look, then try your own name. Add a second line or leave the number blank. Everyone gets to make it theirs.</p>
          <div class="ad-experience">
            {%- comment -%}Original Printful BC3413 ghost photo. The ghost print zone follows the finished NAME/00 product mockup; shared name/number layout and font presets come from the product renderer.{%- endcomment -%}
            <div data-ad-demo-panel="personalize" class="ad-demo-layout" data-ss-pers data-ss-pers-demo="true"
              data-initial-color="Athletic Grey Triblend"
              data-font-family="Graduate" data-font-weight="400" data-font-style="normal"
              data-ink-fit="true" data-ink-stroke-ratio="0.045" data-name-stroke-min="0.06" data-name-stroke-cap="0.12"
              data-color-hex="#ffffff" data-outline-color-hex="#0d9488" data-outline-ratio="0.035"
              data-max-name="14" data-max-number="3"
              data-bbox-left="34" data-bbox-top="10" data-bbox-width="32" data-bbox-height="42.67"
              data-top-offset-pct="0.10" data-lift-pct="0" data-center-alone="0"
              data-name-zone-pct="0.28" data-name2-zone-pct="0.21" data-line-gap-pct="0.02" data-gap-pct="0.04" data-number-min-share="0.20"
              data-mockup-image-url="{{ 'ss-triblend-ghost.webp' | asset_url }}">
              <div class="ad-print-stage">
                <canvas data-ss-pers-canvas width="640" height="640" role="img" aria-label="Live back preview of an athletic grey tri-blend shirt with your name and number in white with a teal outline">Try your name and number on a tri-blend shirt.</canvas>
                <span class="ad-demo-badge">Tri-blend tee · Live back preview</span>
              </div>
              <div class="ad-demo-controls">
                <p class="ad-demo-eyebrow">Try the name &amp; number experience</p>
                <h3>Make it personal.</h3>
                <div class="ad-style-controls">
                  <div class="ad-pickgroup">
                    <span class="ad-picklabel" id="ad-font-label-{{ section.id }}">Lettering</span>
                    <div class="ad-fontrow" role="group" aria-labelledby="ad-font-label-{{ section.id }}"><button type="button" class="ad-fontpick ad-font-varsity_prime" data-ss-pers-demo-font="varsity_prime" aria-pressed="true">Varsity Prime</button><button type="button" class="ad-fontpick ad-font-courtside" data-ss-pers-demo-font="courtside" aria-pressed="false">Courtside</button><button type="button" class="ad-fontpick ad-font-afterburner" data-ss-pers-demo-font="afterburner" aria-pressed="false">Afterburner</button><button type="button" class="ad-fontpick ad-font-battalion" data-ss-pers-demo-font="battalion" aria-pressed="false">Battalion</button><button type="button" class="ad-fontpick ad-font-ironclad" data-ss-pers-demo-font="ironclad" aria-pressed="false">Ironclad</button><button type="button" class="ad-fontpick ad-font-rally" data-ss-pers-demo-font="rally" aria-pressed="false">Rally</button></div>
                  </div>
                  <div class="ad-pickgroup">
                    <span class="ad-picklabel" id="ad-fill-label-{{ section.id }}">Inside color</span>
                    <div class="ad-inkrow" role="group" aria-labelledby="ad-fill-label-{{ section.id }}"><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#ffffff" aria-pressed="true" title="White"><span class="ad-ink-dot" style="--ink:#ffffff" aria-hidden="true"></span><span class="ad-ink-name">White</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#141414" aria-pressed="false" title="Black"><span class="ad-ink-dot" style="--ink:#141414" aria-hidden="true"></span><span class="ad-ink-name">Black</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#b7a36a" aria-pressed="false" title="Gold"><span class="ad-ink-dot" style="--ink:#b7a36a" aria-hidden="true"></span><span class="ad-ink-name">Gold</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#1e2a4a" aria-pressed="false" title="Navy"><span class="ad-ink-dot" style="--ink:#1e2a4a" aria-hidden="true"></span><span class="ad-ink-name">Navy</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#2456c4" aria-pressed="false" title="Royal Blue"><span class="ad-ink-dot" style="--ink:#2456c4" aria-hidden="true"></span><span class="ad-ink-name">Royal Blue</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#c8102e" aria-pressed="false" title="Red"><span class="ad-ink-dot" style="--ink:#c8102e" aria-hidden="true"></span><span class="ad-ink-name">Red</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#14532d" aria-pressed="false" title="Forest"><span class="ad-ink-dot" style="--ink:#14532d" aria-hidden="true"></span><span class="ad-ink-name">Forest</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#e56ca5" aria-pressed="false" title="Pink"><span class="ad-ink-dot" style="--ink:#e56ca5" aria-hidden="true"></span><span class="ad-ink-name">Pink</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#ea6a1e" aria-pressed="false" title="Orange"><span class="ad-ink-dot" style="--ink:#ea6a1e" aria-hidden="true"></span><span class="ad-ink-name">Orange</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#6d28d9" aria-pressed="false" title="Purple"><span class="ad-ink-dot" style="--ink:#6d28d9" aria-hidden="true"></span><span class="ad-ink-name">Purple</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#0d9488" aria-pressed="false" title="Teal"><span class="ad-ink-dot" style="--ink:#0d9488" aria-hidden="true"></span><span class="ad-ink-name">Teal</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#7a1f2b" aria-pressed="false" title="Maroon"><span class="ad-ink-dot" style="--ink:#7a1f2b" aria-hidden="true"></span><span class="ad-ink-name">Maroon</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#38a9e0" aria-pressed="false" title="Sky Blue"><span class="ad-ink-dot" style="--ink:#38a9e0" aria-hidden="true"></span><span class="ad-ink-name">Sky Blue</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#ede6d6" aria-pressed="false" title="Bone"><span class="ad-ink-dot" style="--ink:#ede6d6" aria-hidden="true"></span><span class="ad-ink-name">Bone</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#d8c3a0" aria-pressed="false" title="Sand"><span class="ad-ink-dot" style="--ink:#d8c3a0" aria-hidden="true"></span><span class="ad-ink-name">Sand</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#b06a4f" aria-pressed="false" title="Clay"><span class="ad-ink-dot" style="--ink:#b06a4f" aria-hidden="true"></span><span class="ad-ink-name">Clay</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#92a38b" aria-pressed="false" title="Sage"><span class="ad-ink-dot" style="--ink:#92a38b" aria-hidden="true"></span><span class="ad-ink-name">Sage</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#8a8279" aria-pressed="false" title="Stone"><span class="ad-ink-dot" style="--ink:#8a8279" aria-hidden="true"></span><span class="ad-ink-name">Stone</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#5d6b3c" data-tile="{{ 'ss-camo-regular.webp' | asset_url }}" aria-pressed="false" title="Camo"><span class="ad-ink-dot ad-ink-dot-camo" style="--ink:#5d6b3c" data-camo="regular" aria-hidden="true"></span><span class="ad-ink-name">Camo</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#f2aec4" data-tile="{{ 'ss-camo-pink.webp' | asset_url }}" aria-pressed="false" title="Pink Camo"><span class="ad-ink-dot ad-ink-dot-camo" style="--ink:#f2aec4" data-camo="pink" aria-hidden="true"></span><span class="ad-ink-name">Pink Camo</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#6d8fc7" data-tile="{{ 'ss-camo-blue.webp' | asset_url }}" aria-pressed="false" title="Blue Camo"><span class="ad-ink-dot ad-ink-dot-camo" style="--ink:#6d8fc7" data-camo="blue" aria-hidden="true"></span><span class="ad-ink-name">Blue Camo</span></button><button type="button" class="ad-ink" data-ss-pers-demo-fill data-hex="#e4e4e6" data-tile="{{ 'ss-camo-snow.webp' | asset_url }}" aria-pressed="false" title="Snow Camo"><span class="ad-ink-dot ad-ink-dot-camo" style="--ink:#e4e4e6" data-camo="snow" aria-hidden="true"></span><span class="ad-ink-name">Snow Camo</span></button></div>
                  </div>
                  <div class="ad-pickgroup">
