{%- liquid
  assign word_count = article.content | strip_html | split: ' ' | size
  assign read_time = word_count | divided_by: 220
  assign read_remainder = word_count | modulo: 220
  if read_remainder > 0
    assign read_time = read_time | plus: 1
  endif
  if read_time < 1
    assign read_time = 1
  endif

  assign article_label = 'Team Store Guide'
  if article.tags.size > 0
    assign article_label = article.tags.first
  endif
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ article.title | json }},
    "description": {{ article.excerpt_or_content | strip_html | truncate: 300 | json }},
    "url": {{ request.origin | append: article.url | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    {% if article.image %}"image": {{ article.image | image_url: width: 1600 | prepend: 'https:' | json }},{% endif %}
    "author": {
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }}
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }}
    }
  }
</script>

<article class="ss-article" data-ss-article>
  <div class="ss-article__progress" data-ss-reading-progress aria-hidden="true"></div>

  <header class="ss-article__hero">
    <div class="ss-article__hero-glow ss-article__hero-glow--one"></div>
    <div class="ss-article__hero-glow ss-article__hero-glow--two"></div>

    <div class="ss-article__hero-inner">
      <nav class="ss-article__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">/</span>
        <a href="{{ blog.url }}">Resources</a>
      </nav>

      <div class="ss-article__meta-row">
        <span class="ss-article__tag">{{ article_label | escape }}</span>
        <span>{{ article.published_at | date: '%B %d, %Y' }}</span>
        <span>{{ read_time }} min read</span>
      </div>

      <h1>{{ article.title | escape }}</h1>

      <p class="ss-article__dek">
        {%- if article.excerpt != blank -%}
          {{ article.excerpt | strip_html | escape }}
        {%- else -%}
          {{ article.content | strip_html | truncatewords: 34 | escape }}
        {%- endif -%}
      </p>

      <div class="ss-article__byline">
        <span class="ss-article__byline-mark" aria-hidden="true">S&amp;S</span>
        <span>
          <strong>Stella &amp; Sage Co.</strong>
          <small>Practical guides for easier team merch</small>
        </span>
      </div>
    </div>
  </header>

  {%- if article.image -%}
    <div class="ss-article__image-wrap">
      {{ article.image
        | image_url: width: 1800
        | image_tag:
          class: 'ss-article__image',
          widths: '600, 900, 1200, 1500, 1800',
          sizes: '(max-width: 800px) 94vw, 1160px',
          loading: 'eager',
          fetchpriority: 'high',
          alt: article.image.alt | default: article.title
      }}
    </div>
  {%- endif -%}

  <div class="ss-article__layout">
    <aside class="ss-article__sidebar" aria-label="Article navigation">
      <div class="ss-article__toc-card" data-ss-toc-card hidden>
        <p>IN THIS GUIDE</p>
        <nav data-ss-toc></nav>
      </div>

      <div class="ss-article__sidebar-cta">
        <span>FREE TEAM STORE</span>
        <strong>Stop collecting sizes and payments.</strong>
        <p>Build an always-open store where every buyer orders directly.</p>
        <a href="/pages/storefront">Create your store <span aria-hidden="true">→</span></a>
      </div>
    </aside>

    <div class="ss-article__main">
      <div class="ss-article__content rte" data-ss-article-content>
        {{ article.content }}
      </div>

      <div class="ss-article__share">
        <div>
          <span>Found this useful?</span>
          <strong>Share it with another coach or organizer.</strong>
        </div>
        <button type="button" data-ss-share>Share article</button>
      </div>

      <section class="ss-article__end-cta">
        <div>
          <span>THE EASY BUTTON FOR TEAM MERCH</span>
          <h2>Your store can be live in about 15 minutes.</h2>
          <p>No minimums, no upfront inventory, no closing date, and no organizer collecting money or sizes.</p>
        </div>
        <a href="/pages/storefront">Start a free team store <span aria-hidden="true">→</span></a>
      </section>

      {% content_for 'blocks' %}

      {% if blog.comments_enabled? %}
        <section class="ss-article__comments">
          <h2>{{ 'blogs.article.comments_heading' | t: count: article.comments_count }}</h2>

          {% paginate article.comments by 10 %}
            <div class="ss-article__comment-list">
              {% for comment in article.comments %}
                <article class="ss-article__comment">
                  {{ comment.content }}
                  <footer>
                    <strong>{{ comment.author }}</strong>
                    <span>{{ comment.created_at | time_tag: format: 'date' }}</span>
                  </footer>
                </article>
              {% endfor %}
            </div>
            <div class="ss-article__comment-pagination">{{ paginate | default_pagination }}</div>
          {% endpaginate %}

          {% render 'blog-comment-form', article: article, section_id: section.id %}
        </section>
      {% endif %}
    </div>
  </div>

  <section class="ss-article__related">
    <div class="ss-article__related-head">
      <div>
        <span>KEEP READING</span>
        <h2>More team-store resources</h2>
      </div>
      <a href="{{ blog.url }}">View all articles <span aria-hidden="true">→</span></a>
    </div>

    <div class="ss-article__related-grid">
      {%- assign related_count = 0 -%}
      {%- for related in blog.articles -%}
        {%- unless related.id == article.id -%}
          <a class="ss-article__related-card" href="{{ related.url }}">
            <div class="ss-article__related-image">
              {%- if related.image -%}
                {{ related.image
                  | image_url: width: 700
                  | image_tag:
                    widths: '360, 540, 700',
                    sizes: '(max-width: 760px) 92vw, 31vw',
                    loading: 'lazy',
                    alt: related.image.alt | default: related.title
                }}
              {%- else -%}
                <span aria-hidden="true">S&amp;S</span>
              {%- endif -%}
            </div>
            <div class="ss-article__related-copy">
              <small>{{ related.published_at | date: '%B %d, %Y' }}</small>
              <strong>{{ related.title }}</strong>
              <span>Read article →</span>
            </div>
          </a>
          {%- assign related_count = related_count | plus: 1 -%}
          {%- if related_count == 3 -%}{%- break -%}{%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </section>
</article>

<script>
  (() => {
    const root = document.querySelector('[data-ss-article]');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const content = root.querySelector('[data-ss-article-content]');
    const toc = root.querySelector('[data-ss-toc]');
    const tocCard = root.querySelector('[data-ss-toc-card]');
    const headings = content ? Array.from(content.querySelectorAll('h2, h3')) : [];

    if (toc && tocCard && headings.length) {
      headings.forEach((heading, index) => {
        if (!heading.id) heading.id = `section-${index + 1}`;
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent.trim();
        if (heading.tagName === 'H3') link.classList.add('is-subheading');
        toc.appendChild(link);
      });
      tocCard.hidden = false;
    }

    const progress = root.querySelector('[data-ss-reading-progress]');
    const updateProgress = () => {
      if (!progress || !content) return;
      const rect = content.getBoundingClientRect();
      const total = Math.max(1, content.offsetHeight - window.innerHeight * 0.45);
      const traveled = Math.min(total, Math.max(0, -rect.top + window.innerHeight * 0.25));
      progress.style.transform = `scaleX(${traveled / total})`;
    };
    updateProgress();
    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);

    root.querySelector('[data-ss-share]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      try {
        if (navigator.share) {
          await navigator.share({ title: document.title, url: window.location.href });
        } else {
          await navigator.clipboard.writeText(window.location.href);
          const original = button.textContent;
          button.textContent = 'Link copied';
          setTimeout(() => { button.textContent = original; }, 1800);
        }
      } catch (_) {}
    });
  })();
</script>

