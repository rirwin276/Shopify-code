{% comment %}
  Minimal storefront appearance layer.
  When settings are absent or disabled, this section renders nothing and the
  existing collection remains pixel-for-pixel unchanged.
{% endcomment %}

{%- assign ssa_handle = collection.handle | downcase | strip -%}
{%- assign ssa_entry = shop.metaobjects.custom_shop[ssa_handle] -%}
{%- assign ssa_settings = ssa_entry.storefront_settings.value | default: ssa_entry.storefront_settings -%}
{%- assign ssa_enabled = ssa_settings.enabled | default: false -%}

{%- if ssa_enabled -%}
  {%- assign ssa_pattern = ssa_settings.pattern | default: 'none' | downcase -%}
  {%- unless ssa_pattern == 'diagonal' or ssa_pattern == 'stripes' -%}{%- assign ssa_pattern = 'none' -%}{%- endunless -%}
  {%- assign ssa_primary = ssa_settings.primary_color | default: '#1f2937' -%}
  {%- assign ssa_secondary = ssa_settings.secondary_color | default: '#d4af37' -%}
  {%- assign ssa_primary_text = ssa_settings.primary_text | default: '#ffffff' -%}
  {%- assign ssa_announcement = ssa_settings.announcement | default: '' | strip -%}
  {%- assign ssa_show_announcement = ssa_settings.show_announcement | default: false -%}

  {%- if ssa_show_announcement and ssa_announcement != blank -%}
    <div class="ssa-announcement" role="status"><span>{{ ssa_announcement }}</span></div>
  {%- endif -%}

  <style>
    html.ss-storefront-themed {
      --ss-team-primary: {{ ssa_primary }};
      --ss-team-secondary: {{ ssa_secondary }};
      --ss-team-primary-text: {{ ssa_primary_text }};
    }

    html.ss-storefront-themed results-list.product-grid-container {
      position: relative;
      background: linear-gradient(180deg,color-mix(in srgb,var(--ss-team-primary) 5%,#fff),#fff 68%) !important;
      box-shadow: inset 0 4px 0 var(--ss-team-primary);
    }
    html.ss-storefront-themed results-list.product-grid-container .collection-wrapper,
    html.ss-storefront-themed results-list.product-grid-container .product-grid {
      position: relative;
      z-index: 1;
      background: transparent !important;
    }
    html.ss-storefront-pattern-diagonal results-list.product-grid-container {
      background: linear-gradient(135deg,color-mix(in srgb,var(--ss-team-primary) 16%,#fff) 0 47%,color-mix(in srgb,var(--ss-team-secondary) 58%,#fff) 47% 53%,color-mix(in srgb,var(--ss-team-secondary) 14%,#fff) 53% 100%) !important;
    }
    html.ss-storefront-pattern-stripes results-list.product-grid-container {
      background: linear-gradient(135deg,#fff 0 34%,color-mix(in srgb,var(--ss-team-primary) 62%,#fff) 34% 39%,color-mix(in srgb,var(--ss-team-secondary) 68%,#fff) 39% 44%,#fff 44% 100%) !important;
    }

    .ssa-announcement {
      width: min(1440px,calc(100% - 40px));
      margin: 8px auto 18px;
      padding: 12px 18px;
      border-radius: 12px;
      border-bottom: 4px solid var(--ss-team-secondary);
      background: var(--ss-team-primary);
      color: var(--ss-team-primary-text);
      font: 800 13px/1.35 -apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",sans-serif;
      text-align: center;
      box-shadow: 0 10px 28px color-mix(in srgb,var(--ss-team-primary) 18%,transparent);
    }
    @media(max-width:749px){
      .ssa-announcement{width:calc(100% - 20px);margin:5px auto 12px;padding:10px 12px;border-radius:10px;font-size:12px}
      html.ss-storefront-themed results-list.product-grid-container{box-shadow:inset 0 3px 0 var(--ss-team-primary)}
    }
  </style>

  <script>
    (function(){
      var html=document.documentElement;
      html.classList.add('ss-storefront-themed');
      html.classList.add('ss-storefront-pattern-{{ ssa_pattern | escape }}');
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Private store appearance",
  "enabled_on": { "templates": ["collection"] },
  "settings": []
}
{% endschema %}
