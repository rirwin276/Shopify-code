{% comment %}
  Optional featured row + conditional catalog tabs. Product classification is
  deliberately forgiving: it reads product type, title, and tags so existing
  stores work without a migration. Tabs only render when a matching category
  exists. The original Shopify collection grid remains the source of truth.
{% endcomment %}

{%- assign ssc_handle = collection.handle | downcase | strip -%}
{%- capture ssc_access -%}{%- render 'private-store-access', handle: ssc_handle -%}{%- endcapture -%}
{%- assign ssc_access = ssc_access | strip -%}
{%- assign ssc_entry = shop.metaobjects.custom_shop[ssc_handle] -%}
{%- assign ssc_settings = ssc_entry.storefront_settings.value | default: ssc_entry.storefront_settings -%}
{%- assign ssc_enabled = ssc_settings.enabled | default: false -%}
{%- assign ssc_catalog_enabled = true -%}
{%- if ssc_settings.catalog_enabled == false -%}{%- assign ssc_catalog_enabled = false -%}{%- endif -%}
{%- assign ssc_featured_enabled = true -%}
{%- if ssc_settings.featured_enabled == false -%}{%- assign ssc_featured_enabled = false -%}{%- endif -%}

{%- if ssc_access != blank and ssc_enabled and ssc_catalog_enabled -%}
  {%- assign ssc_adult_count = 0 -%}
  {%- assign ssc_youth_count = 0 -%}
  {%- assign ssc_hoodie_count = 0 -%}
  {%- assign ssc_personalized_count = 0 -%}
  {%- assign ssc_tank_count = 0 -%}
  {%- assign ssc_accessory_count = 0 -%}

  {%- for ssc_product in collection.products -%}
    {%- assign ssc_tags = ssc_product.tags | join: ' ' -%}
    {%- assign ssc_haystack = ssc_product.title | append: ' ' | append: ssc_product.type | append: ' ' | append: ssc_tags | downcase -%}
    {%- if ssc_haystack contains 'name and number' or ssc_haystack contains 'name & number' or ssc_haystack contains 'personalized' or ssc_haystack contains 'custom name' -%}
      {%- assign ssc_personalized_count = ssc_personalized_count | plus: 1 -%}
    {%- elsif ssc_haystack contains 'youth' or ssc_haystack contains 'kids' or ssc_haystack contains 'kid ' -%}
      {%- assign ssc_youth_count = ssc_youth_count | plus: 1 -%}
    {%- elsif ssc_haystack contains 'hoodie' or ssc_haystack contains 'sweatshirt' or ssc_haystack contains 'crewneck' -%}
      {%- assign ssc_hoodie_count = ssc_hoodie_count | plus: 1 -%}
    {%- elsif ssc_haystack contains 'tank' -%}
      {%- assign ssc_tank_count = ssc_tank_count | plus: 1 -%}
    {%- elsif ssc_haystack contains 'shirt' or ssc_haystack contains 'tee' or ssc_haystack contains 't-shirt' -%}
      {%- assign ssc_adult_count = ssc_adult_count | plus: 1 -%}
    {%- else -%}
      {%- assign ssc_accessory_count = ssc_accessory_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  <section class="ssc-catalog-tools" id="ssc-catalog-tools-{{ section.id }}">
    {%- if ssc_featured_enabled -%}
      <div class="ssc-featured">
        <div class="ssc-heading-row">
          <div>
            <span class="ssc-eyebrow">Featured gear</span>
            <h2>Team favorites</h2>
          </div>
          <a href="#ResultsList">View all gear ↓</a>
        </div>
        <div class="ssc-featured-grid">
          {%- for ssc_product in collection.products limit: 4 -%}
            <a class="ssc-featured-card" href="{{ ssc_product.url }}">
              <div class="ssc-featured-card__image">
                {%- if ssc_product.featured_image -%}
                  {{ ssc_product.featured_image | image_url: width: 760 | image_tag: loading: 'lazy', alt: ssc_product.title }}
                {%- endif -%}
              </div>
              <div class="ssc-featured-card__copy">
                <strong>{{ ssc_product.title }}</strong>
                <span>{{ ssc_product.price | money }}</span>
              </div>
            </a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <div class="ssc-catalog-nav">
      <div class="ssc-heading-row ssc-heading-row--catalog">
        <div>
          <span class="ssc-eyebrow">Complete catalog</span>
          <h2>Shop by product</h2>
        </div>
        <span class="ssc-result-count" data-ssc-count>{{ collection.products_count }} products</span>
      </div>
      <div class="ssc-tabs" role="tablist" aria-label="Product categories">
        <button class="active" type="button" role="tab" aria-selected="true" data-ssc-category="all">All gear</button>
        {%- if ssc_adult_count > 0 -%}<button type="button" role="tab" aria-selected="false" data-ssc-category="adult">Adult shirts <small>{{ ssc_adult_count }}</small></button>{%- endif -%}
        {%- if ssc_youth_count > 0 -%}<button type="button" role="tab" aria-selected="false" data-ssc-category="youth">Youth <small>{{ ssc_youth_count }}</small></button>{%- endif -%}
        {%- if ssc_hoodie_count > 0 -%}<button type="button" role="tab" aria-selected="false" data-ssc-category="hoodie">Hoodies <small>{{ ssc_hoodie_count }}</small></button>{%- endif -%}
        {%- if ssc_personalized_count > 0 -%}<button type="button" role="tab" aria-selected="false" data-ssc-category="personalized">Name + number <small>{{ ssc_personalized_count }}</small></button>{%- endif -%}
        {%- if ssc_tank_count > 0 -%}<button type="button" role="tab" aria-selected="false" data-ssc-category="tank">Tanks <small>{{ ssc_tank_count }}</small></button>{%- endif -%}
        {%- if ssc_accessory_count > 0 -%}<button type="button" role="tab" aria-selected="false" data-ssc-category="other">More gear <small>{{ ssc_accessory_count }}</small></button>{%- endif -%}
      </div>
    </div>
  </section>

  <script type="application/json" id="ssc-product-categories-{{ section.id }}">
    {
      {%- for ssc_product in collection.products -%}
        {%- assign ssc_tags = ssc_product.tags | join: ' ' -%}
        {%- assign ssc_haystack = ssc_product.title | append: ' ' | append: ssc_product.type | append: ' ' | append: ssc_tags | downcase -%}
        {%- assign ssc_category = 'other' -%}
        {%- if ssc_haystack contains 'name and number' or ssc_haystack contains 'name & number' or ssc_haystack contains 'personalized' or ssc_haystack contains 'custom name' -%}
          {%- assign ssc_category = 'personalized' -%}
        {%- elsif ssc_haystack contains 'youth' or ssc_haystack contains 'kids' or ssc_haystack contains 'kid ' -%}
          {%- assign ssc_category = 'youth' -%}
        {%- elsif ssc_haystack contains 'hoodie' or ssc_haystack contains 'sweatshirt' or ssc_haystack contains 'crewneck' -%}
          {%- assign ssc_category = 'hoodie' -%}
        {%- elsif ssc_haystack contains 'tank' -%}
          {%- assign ssc_category = 'tank' -%}
        {%- elsif ssc_haystack contains 'shirt' or ssc_haystack contains 'tee' or ssc_haystack contains 't-shirt' -%}
          {%- assign ssc_category = 'adult' -%}
        {%- endif -%}
        "{{ ssc_product.id }}": {{ ssc_category | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  </script>

  <style>
    #ssc-catalog-tools-{{ section.id }}, #ssc-catalog-tools-{{ section.id }} * { box-sizing:border-box; }
    #ssc-catalog-tools-{{ section.id }} { width:min(1440px,calc(100% - 40px)); margin:22px auto 4px; color:#15130f; font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",sans-serif; }
    .ssc-featured,.ssc-catalog-nav { padding:clamp(18px,3vw,32px); border:1px solid color-mix(in srgb,var(--ss-team-primary,#1f2937) 13%, #e7e1d7); border-radius:28px; background:#fff; box-shadow:0 18px 55px rgba(17,16,14,.07); }
    .ssc-catalog-nav { margin-top:16px; padding-bottom:18px; }
    .ssc-heading-row { display:flex; align-items:flex-end; justify-content:space-between; gap:18px; margin-bottom:18px; }
    .ssc-heading-row h2 { margin:3px 0 0; font-size:clamp(22px,2.6vw,34px); line-height:1; }
    .ssc-eyebrow { display:block; color:var(--ss-team-primary,#7e6b40); font-size:11px; font-weight:850; letter-spacing:.1em; text-transform:uppercase; }
    .ssc-heading-row > a { color:var(--ss-team-primary,#17150f); font-size:13px; font-weight:800; text-decoration:none; }
    .ssc-featured-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; }
    .ssc-featured-card { min-width:0; overflow:hidden; border:1px solid #e7e2d9; border-radius:18px; background:#fff; color:inherit; text-decoration:none; transition:transform .2s ease,box-shadow .2s ease; }
    .ssc-featured-card:hover { transform:translateY(-3px); box-shadow:0 16px 34px rgba(17,16,14,.11); }
    .ssc-featured-card__image { aspect-ratio:1/1.03; overflow:hidden; background:#f2efe8; }
    .ssc-featured-card__image img { width:100%; height:100%; object-fit:cover; transition:transform .25s ease; }
    .ssc-featured-card:hover img { transform:scale(1.025); }
    .ssc-featured-card__copy { padding:12px 13px 14px; }
    .ssc-featured-card__copy strong,.ssc-featured-card__copy span { display:block; }
    .ssc-featured-card__copy strong { overflow:hidden; white-space:nowrap; text-overflow:ellipsis; font-size:14px; }
    .ssc-featured-card__copy span { margin-top:3px; color:#746e63; font-size:12px; }
    .ssc-heading-row--catalog { margin-bottom:13px; }
    .ssc-result-count { padding:7px 11px; border-radius:999px; background:#f1eee8; color:#686156; font-size:11px; font-weight:750; }
    .ssc-tabs { display:flex; gap:8px; overflow-x:auto; padding:2px 1px 5px; scrollbar-width:none; -webkit-overflow-scrolling:touch; }
    .ssc-tabs::-webkit-scrollbar { display:none; }
    .ssc-tabs button { flex:0 0 auto; min-height:40px; padding:0 14px; border:1px solid #ded9d0; border-radius:999px; background:#fff; color:#625c52; font:800 12px/1 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; cursor:pointer; }
    .ssc-tabs button small { margin-left:4px; opacity:.65; font-size:9px; }
    .ssc-tabs button.active { border-color:var(--ss-team-primary,#17150f); background:var(--ss-team-primary,#17150f); color:var(--ss-team-primary-text,#fff); box-shadow:0 8px 18px color-mix(in srgb,var(--ss-team-primary,#17150f) 22%, transparent); }
    html.ss-storefront-style-dark .ssc-featured,html.ss-storefront-style-dark .ssc-catalog-nav { border-color:#2c3038; background:#171a20; color:#fff; }
    html.ss-storefront-style-dark .ssc-featured-card { border-color:#30343d; background:#1d2027; color:#fff; }
    html.ss-storefront-style-dark .ssc-featured-card__image { background:#252932; }
    html.ss-storefront-style-dark .ssc-featured-card__copy span { color:#b8bdc7; }
    html.ss-storefront-style-dark .ssc-tabs button { border-color:#353944; background:#1d2027; color:#d4d7dd; }
    html.ss-storefront-style-dark .ssc-result-count { background:#252932; color:#c6cad2; }
    li.product-grid__item.ssc-hidden { display:none !important; }
    @media (max-width: 900px) { .ssc-featured-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @media (max-width: 749px) {
      #ssc-catalog-tools-{{ section.id }} { width:calc(100% - 20px); margin:12px auto 0; }
      .ssc-featured,.ssc-catalog-nav { padding:16px; border-radius:20px; }
      .ssc-heading-row { align-items:center; margin-bottom:13px; }
      .ssc-heading-row h2 { font-size:22px; }
      .ssc-heading-row > a { font-size:11px; }
      .ssc-featured-grid { gap:9px; }
      .ssc-featured-card { border-radius:14px; }
      .ssc-featured-card__copy { padding:9px 10px 11px; }
      .ssc-featured-card__copy strong { font-size:12px; }
      .ssc-tabs { margin-inline:-16px; padding-inline:16px; }
      .ssc-tabs button { min-height:38px; padding:0 12px; font-size:11px; }
    }
  </style>

  <script>
    (function(){
      var root = document.getElementById('ssc-catalog-tools-{{ section.id }}');
      if(!root) return;
      var map = {};
      try { map = JSON.parse(document.getElementById('ssc-product-categories-{{ section.id }}').textContent || '{}'); } catch(_e){}
      var active = 'all';
      var countEl = root.querySelector('[data-ssc-count]');

      function apply(){
        var visible = 0;
        document.querySelectorAll('li.product-grid__item[data-product-id]').forEach(function(card){
          var category = map[String(card.getAttribute('data-product-id'))] || 'other';
          var show = active === 'all' || category === active;
          card.classList.toggle('ssc-hidden', !show);
          if(show) visible++;
        });
        if(countEl) countEl.textContent = visible + (visible === 1 ? ' product' : ' products');
      }
      root.querySelectorAll('[data-ssc-category]').forEach(function(button){
        button.addEventListener('click', function(){
          active = button.dataset.sscCategory || 'all';
          root.querySelectorAll('[data-ssc-category]').forEach(function(item){
            var selected = item === button;
            item.classList.toggle('active', selected);
            item.setAttribute('aria-selected', selected ? 'true' : 'false');
          });
          apply();
          var results = document.getElementById('ResultsList') || document.querySelector('results-list');
          if(results) results.scrollIntoView({behavior:'smooth',block:'start'});
        });
      });
      if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', apply, {once:true}); else apply();
      var resultsList = document.querySelector('results-list');
      if(resultsList && window.MutationObserver) new MutationObserver(apply).observe(resultsList,{childList:true,subtree:true});
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Private store catalog tools",
  "enabled_on": { "templates": ["collection"] },
  "settings": []
}
{% endschema %}
