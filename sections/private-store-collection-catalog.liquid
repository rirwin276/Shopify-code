{% comment %}
  PRIVATE STORE COLLECTION CATALOG
  The category controls are the first row of the actual product collection
  wrapper. They intentionally use catalog-only hooks so legacy storefront
  relocation scripts cannot move them back outside the product wrapper.
{% endcomment %}

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign hide_private_store_collection = false
  assign private_handle = collection.handle | downcase | strip
  capture private_access
    render 'private-store-access', handle: private_handle
  endcapture
  assign private_access = private_access | strip

  unless private_access != blank
    assign hide_private_store_collection = true
  endunless
%}

{% unless hide_private_store_collection %}
  <results-list
    class="section product-grid-container ss-private-catalog"
    style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
    section-id="{{ section.id }}"
    infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
    data-ss-private-catalog
  >
    {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

    <div class="collection-wrapper grid gap-style">
      <div class="ss-catalog-controls" data-ss-catalog-controls role="tablist" aria-label="Shop by product type">
        <button type="button" class="ss-category-tab active" data-ss-category="all" role="tab" aria-selected="true">All gear</button>
        <button type="button" class="ss-category-tab" data-ss-category="shirts" role="tab" aria-selected="false">Shirts</button>
        <button type="button" class="ss-category-tab" data-ss-category="youth" role="tab" aria-selected="false">Youth</button>
        <button type="button" class="ss-category-tab" data-ss-category="hoodies" role="tab" aria-selected="false">Hoodies</button>
        <button type="button" class="ss-category-tab" data-ss-category="tanks" role="tab" aria-selected="false">Tanks</button>
        <button type="button" class="ss-category-tab" data-ss-category="headwear" role="tab" aria-selected="false">Hats</button>
        <button type="button" class="ss-category-tab" data-ss-category="personalized" role="tab" aria-selected="false">Personalized</button>
        <button type="button" class="ss-category-tab" data-ss-category="accessories" role="tab" aria-selected="false">Accessories</button>
        <button type="button" class="ss-category-tab" data-ss-category="other" role="tab" aria-selected="false">More</button>
      </div>

      {% content_for 'block',
        type: 'filters',
        id: 'filters',
        results: collection,
        results_size: collection.products_count
      %}

      {%- comment -%}
        50 is Shopify's per-page ceiling for pagination, and is set deliberately.
        A pinned product is sorted to the front with CSS `order`, which can only
        reorder within the page that is currently rendered — so a pin on page 2
        would not reach the top of page 1. At 50 a whole private store fits on
        one page in every realistic case (these carry roughly a dozen products),
        which makes the pin globally correct rather than page-local.

        Past 50 products the pin is page-local again: with auto-load on, the
        pinned card jumps to the front as soon as its page loads, because the
        appended cards join the same grid. Fixing that properly needs the sort
        to happen before pagination, which Liquid cannot express over a smart
        collection — it would need the order stored somewhere Shopify can sort
        on, and a smart collection cannot hold a manual product order at all.
      {%- endcomment -%}
      {% assign products_per_page = 50 %}
      {% if section.settings.enable_infinite_scroll == false %}
        {% assign products_per_page = section.settings.products_per_page %}
      {% endif %}

      {% paginate collection.products by products_per_page %}
        {% capture children %}
          {% for product in collection.products %}
            {%- comment -%}
              One garment type per product, decided by priority.

              These used to be independent `contains` tests over the title AND
              the tags joined together, which put hoodies in Shirts two ways
              over: "sweatshirt" contains "shirt", and "crewneck" was mapped to
              shirts outright. The tags made it worse — pro-builder products
              carry routing tags like pro-shirt, so a hoodie matched "shirt"
              even when its title never said it.

              Garment type is now read from the title only and resolved as a
              chain, so the first match wins and nothing lands in two garment
              tabs. Youth and Personalized stay additive on top, because those
              genuinely cross-cut: a youth tee belongs in both.
            {%- endcomment -%}
            {% assign ss_title = product.title | downcase %}
            {% assign ss_tags_text = product.tags | join: ' ' | downcase %}
            {% assign ss_categories = '' %}

            {% if ss_title contains 'hat' or ss_title contains 'cap' or ss_title contains 'beanie' or ss_title contains 'trucker' %}
              {% assign ss_categories = 'headwear' %}
            {% elsif ss_title contains 'tote' or ss_title contains 'bag' or ss_title contains 'mug' or ss_title contains 'bottle' or ss_title contains 'blanket' %}
              {% assign ss_categories = 'accessories' %}
            {% elsif ss_title contains 'tank' or ss_title contains 'racerback' %}
              {% assign ss_categories = 'tanks' %}
            {% elsif ss_title contains 'hoodie' or ss_title contains 'sweatshirt' or ss_title contains 'pullover' or ss_title contains 'crewneck' %}
              {% assign ss_categories = 'hoodies' %}
            {% elsif ss_title contains 'tee' or ss_title contains 't-shirt' or ss_title contains 'shirt' or ss_title contains 'long sleeve' or ss_title contains 'jersey' %}
              {% assign ss_categories = 'shirts' %}
            {% else %}
              {% assign ss_categories = 'other' %}
            {% endif %}

            {% if ss_title contains 'youth' or ss_title contains 'toddler' or ss_title contains 'kids' %}
              {% assign ss_categories = ss_categories | append: ' youth' %}
            {% endif %}

            {%- comment -%}
              personalized-back is the tag the publisher writes, so it is the
              authoritative signal rather than hoping the words appear.
            {%- endcomment -%}
            {% if ss_tags_text contains 'personalized-back' or ss_title contains 'name & number' or ss_title contains 'name and number' or ss_title contains 'personalized' %}
              {% assign ss_categories = ss_categories | append: ' personalized' %}
            {% endif %}

            {%- comment -%}
              A store admin can pin a product to show first. It is a tag
              (pinned--<shop handle>) rather than a collection position because
              each store's collection is a SMART collection, which Shopify
              cannot hold a manual product order for. The order is applied here
              with CSS `order`, so it costs no extra Liquid work and survives
              the category filter below, which only toggles `hidden`.
            {%- endcomment -%}
            {%- comment -%} private_handle is collection.handle, and provisioning sets the
                collection handle, the membership tag and the shop handle to the
                same value (shopify_provision.py: tag_value = handle), so this is
                the same string the admin writes. {%- endcomment -%}
            {% assign ss_pin_tag = 'pinned--' | append: private_handle | downcase %}
            {% assign ss_is_pinned = false %}
            {% for ss_tag in product.tags %}
              {% if ss_tag | downcase | strip == ss_pin_tag %}
                {% assign ss_is_pinned = true %}
                {% break %}
              {% endif %}
            {% endfor %}

            <li
              id="{{ section.id }}-{{ product.id }}"
              class="product-grid__item product-grid__item--{{ forloop.index0 }}{% if ss_is_pinned %} ss-pinned{% endif %}"
              data-page="{{ paginate.current_page }}"
              data-product-id="{{ product.id }}"
              data-ss-categories="{{ ss_categories | strip | escape }}"
              {% if ss_is_pinned %}data-ss-pinned="true"{% endif %}
              ref="cards[]"
            >
              {%- comment -%}
                No "what this listing includes" badge is drawn here.

                The theme's own card already renders one — product-card-badges
                calls the same pro-listing-includes rule — so adding a second
                produced two stacked pills on every personalised and
                front-and-back product. The shared rule exists precisely so the
                two cards cannot disagree; the mistake was rendering it twice
                rather than trusting the card.
              {%- endcomment -%}
              {% # theme-check-disable %}
              {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
              {% # theme-check-enable %}

              {%- comment -%}
                No swatch row here either.

                The theme's card block already carries a swatches block, so
                this drew a second row below the price — visible as a half-cut
                strip at the bottom edge of every card. Same mistake as the
                badge: the component was already doing the job, and the honest
                fix is to delete the copy rather than style around it.
              {%- endcomment -%}
            </li>
          {% endfor %}
        {% endcapture %}

        {% render 'product-grid',
          section: section,
          children: children,
          products: collection.products,
          paginate: paginate,
          enable_infinite_scroll: section.settings.enable_infinite_scroll
        %}
      {% endpaginate %}
    </div>
  </results-list>

  <script>
    (function(){
      var root = document.querySelector('[data-ss-private-catalog]');
      if (!root || root.dataset.ssCategoryReady === '1') return;
      root.dataset.ssCategoryReady = '1';

      var controls = root.querySelector('[data-ss-catalog-controls]');
      var buttons = Array.from(root.querySelectorAll('[data-ss-category]'));
      var active = 'all';

      function items(){
        return Array.from(root.querySelectorAll('.product-grid__item[data-product-id]'));
      }

      function apply(){
        var available = {};
        var productItems = items();

        productItems.forEach(function(item){
          var categories = (item.dataset.ssCategories || 'other').split(/\s+/).filter(Boolean);
          categories.forEach(function(category){ available[category] = true; });
          item.hidden = active !== 'all' && categories.indexOf(active) === -1;
        });

        buttons.forEach(function(button){
          var category = button.dataset.ssCategory || 'all';
          if (category !== 'all') button.hidden = !available[category];
          var selected = category === active;
          button.classList.toggle('active', selected);
          button.setAttribute('aria-selected', selected ? 'true' : 'false');
        });

        if (controls) controls.hidden = !productItems.length;
      }

      buttons.forEach(function(button){
        button.addEventListener('click', function(){
          if (button.hidden) return;
          active = button.dataset.ssCategory || 'all';
          apply();
        });
      });

      apply();
      new MutationObserver(apply).observe(root, { childList: true, subtree: true });
    })();
  </script>
{% endunless %}

{% stylesheet %}
  .ss-private-catalog .collection-wrapper {
    @media screen and (min-width: 750px) {
      grid-template-columns:
        1fr repeat(
          var(--centered-column-number),
          minmax(0, calc((var(--page-width) - var(--page-margin) * 2) / var(--centered-column-number)))
        )
        1fr;
    }
  }

  /* Catalog controls are a real first row of the same wrapper as the products. */
  .ss-private-catalog .collection-wrapper > .ss-catalog-controls {
    grid-column: 1 / -1;
    width: min(var(--ss-layout-page-width, 1320px), calc(100% - 40px));
    max-width: min(var(--ss-layout-page-width, 1320px), calc(100% - 40px));
    min-width: 0;
    margin: 0 auto;
    padding: 10px 0 11px;
    display: flex;
    align-items: center;
    gap: 7px;
    overflow-x: auto;
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  .ss-private-catalog :is(.facets-block-wrapper, .facets-container, facet-filters-form, .product-grid__item-count, .sorting-filter, .grid-density-controls) {
    display: none !important;
  }

  /*
    The grid item is deliberately NOT a positioning context.

    It was made one for the badge this section used to draw. That badge is
    gone — the theme's card already renders it — but the rule outlived it, and
    the theme's badge is absolutely positioned, so it started resolving
    against the <li> instead of the card's media box. It landed on the card's
    rounded corner, half outside the tile, which is what looked like a second
    box on hover.
  */

{% endstylesheet %}

{% render 'product-tile-transparency' %}

{% schema %}
{
  "name": "Store collection catalog",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "organic", "label": "Editorial" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "Card size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "extra-large", "label": "Extra large" }
      ],
      "default": "small"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "Mobile card size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "large", "label": "Large" }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "Auto-load products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "Width",
      "options": [
        { "value": "centered", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "Full width on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "Horizontal gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "Vertical gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": []
}
{% endschema %}
