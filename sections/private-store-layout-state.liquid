{% comment %}
  PRIVATE STORE TEMPLATE STATE
  The assigned Shopify collection template is the source of truth for layout.
  Colors/message still come from custom_shop.storefront_settings, but a saved
  design no longer morphs one base page at runtime.

  Template suffixes:
    private-store            -> original
    private-store-classic    -> classic
    private-store-split      -> split
    private-store-gradient   -> gradient
    private-store-spray      -> spray
    private-store-pro        -> pro
    private-store-heritage   -> heritage
{% endcomment %}

{% assign ss_handle = collection.handle | downcase | strip %}
{% assign ss_entry = shop.metaobjects.custom_shop[ss_handle] %}
{% assign ss_settings = ss_entry.storefront_settings.value | default: ss_entry.storefront_settings %}

{% assign ss_template_suffix = template.suffix | default: 'private-store' | downcase %}
{% assign ss_enabled = false %}
{% assign ss_layout = 'original' %}

{% case ss_template_suffix %}
  {% when 'private-store-classic' %}
    {% assign ss_enabled = true %}
    {% assign ss_layout = 'classic' %}
  {% when 'private-store-split' %}
    {% assign ss_enabled = true %}
    {% assign ss_layout = 'split' %}
  {% when 'private-store-gradient' %}
    {% assign ss_enabled = true %}
    {% assign ss_layout = 'gradient' %}
  {% when 'private-store-spray' %}
    {% assign ss_enabled = true %}
    {% assign ss_layout = 'spray' %}
  {% when 'private-store-pro' %}
    {% assign ss_enabled = true %}
    {% assign ss_layout = 'pro' %}
  {% when 'private-store-heritage' %}
    {% assign ss_enabled = true %}
    {% assign ss_layout = 'heritage' %}
{% endcase %}

{% comment %}
  If the template suffix did not name a design, the saved one does.

  Provisioning writes COLLECTION_TEMPLATE_SUFFIX, which is the bare
  "private-store", and nothing in any backend ever changes it again — not
  wakeup, and not saving a design. So every store resolved to "original" no
  matter which design its owner had chosen and saved, and the appearance
  builder truthfully reported "Pro Dark" while the storefront rendered light.
  Reading only the suffix meant the feature could not work for any store,
  including ones set up long before this.

  The suffix still wins when it names a design, so assigning a template stays
  an explicit override. This only fills in the case it left blank.

  Safe because all seven private-store templates render the same section list
  — the suffix encodes appearance, never structure — so nothing about the page
  differs here except which stylesheet block applies. Still server-rendered:
  no runtime morphing, no DOM relocation.
{% endcomment %}
{% if ss_enabled == false and ss_settings %}
  {% assign ss_saved_enabled = ss_settings.enabled %}

  {% if ss_saved_enabled == true or ss_saved_enabled == 'true' %}
    {% assign ss_saved_layout = ss_settings.layout | default: '' | downcase | strip %}
    {% assign ss_known_layouts = 'classic,split,gradient,spray,pro,heritage' | split: ',' %}

    {% comment %}
      Saved records mostly do not contain `layout` at all.

      The stored shape is the older style + pattern pair, and the appearance
      builder converts it to a layout in JavaScript as it reads it
      (normalizeLegacyDesign in storefront-appearance-builder.js). That is why
      the designer could show "Pro Dark" while the storefront rendered light:
      the builder did the conversion, and nothing on the storefront did.

      Reading `layout` alone therefore matched almost nothing. The same
      mapping has to exist here, against the same pairs, or the two surfaces
      disagree about what the store is set to.
    {% endcomment %}
    {% unless ss_known_layouts contains ss_saved_layout %}
      {% assign ss_style = ss_settings.style | default: 'clean' | downcase | strip %}
      {% assign ss_pattern = ss_settings.pattern | default: 'none' | downcase | strip %}

      {% comment %} Retired pairing, still present on older records. {% endcomment %}
      {% if ss_style == 'dark' and ss_pattern == 'dots' %}
        {% assign ss_pattern = 'grid' %}
      {% endif %}

      {% if ss_style == 'clean' and ss_pattern == 'diagonal' %}
        {% assign ss_saved_layout = 'split' %}
      {% elsif ss_style == 'bold' and ss_pattern == 'none' %}
        {% assign ss_saved_layout = 'gradient' %}
      {% elsif ss_style == 'bold' and ss_pattern == 'dots' %}
        {% assign ss_saved_layout = 'spray' %}
      {% elsif ss_style == 'dark' and ss_pattern == 'grid' %}
        {% assign ss_saved_layout = 'pro' %}
      {% elsif ss_style == 'clean' and ss_pattern == 'stripes' %}
        {% assign ss_saved_layout = 'heritage' %}
      {% else %}
        {% assign ss_saved_layout = 'classic' %}
      {% endif %}
    {% endunless %}

    {% if ss_known_layouts contains ss_saved_layout %}
      {% assign ss_enabled = true %}
      {% assign ss_layout = ss_saved_layout %}
    {% endif %}
  {% endif %}
{% endif %}

{% comment %}
  A store that has never been near the designer still gets a design.

  "Original" was the old bare collection page — the one this whole feature
  replaced — so leaving it as the default meant every store nobody had
  customised kept shipping the version we stopped wanting anyone to see. An
  organiser should not have to open a settings panel to stop looking dated.

  Classic Team is the fallback because it is the restrained one: white, with
  the team colours only as accents. The default colours below are a neutral
  slate and gold, so an untouched store reads as deliberate rather than as a
  half-configured one.

  Anyone who explicitly wants the plain page still gets it — saving with the
  design switched off writes enabled=false, and that is honoured above.
{% endcomment %}
{% if ss_enabled == false and ss_settings == blank %}
  {% assign ss_enabled = true %}
  {% assign ss_layout = 'classic' %}
{% endif %}

{% assign ss_primary = '#1f2937' %}
{% assign ss_secondary = '#d4af37' %}
{% assign ss_primary_text = '#ffffff' %}
{% assign ss_secondary_text = '#111111' %}
{% assign ss_message = '' %}
{% assign ss_show_message = false %}

{% if ss_settings %}
  {% assign ss_primary = ss_settings.primary_color | default: ss_primary %}
  {% assign ss_secondary = ss_settings.secondary_color | default: ss_secondary %}
  {% assign ss_primary_text = ss_settings.primary_text | default: ss_primary_text %}
  {% assign ss_secondary_text = ss_settings.secondary_text | default: ss_secondary_text %}
  {% assign ss_message = ss_settings.announcement | default: '' | strip %}
  {% if ss_settings.show_announcement == true and ss_message != blank %}
    {% assign ss_show_message = true %}
  {% endif %}
{% endif %}

{{ 'storefront-fixed-layouts.css' | asset_url | stylesheet_tag }}
{{ 'storefront-template-structure.css' | asset_url | stylesheet_tag }}

<div
  id="ss-private-store-state"
  hidden
  data-enabled="{{ ss_enabled }}"
  data-layout="{{ ss_layout }}"
  {%- comment -%}
    What the saved record actually held, so a design that fails to apply can
    be diagnosed from the page instead of by guessing at the metaobject.
  {%- endcomment -%}
  data-saved-enabled="{{ ss_settings.enabled }}"
  data-saved-layout="{{ ss_settings.layout }}"
  data-saved-style="{{ ss_settings.style }}"
  data-saved-pattern="{{ ss_settings.pattern }}"
  data-template-suffix="{{ ss_template_suffix | escape }}"
  data-show-message="{{ ss_show_message }}"
  data-message="{{ ss_message | escape }}"
></div>

<style>
  #MainContent {
    --ss-team-primary: {{ ss_primary }};
    --ss-team-secondary: {{ ss_secondary }};
    --ss-team-primary-text: {{ ss_primary_text }};
    --ss-team-secondary-text: {{ ss_secondary_text }};
  }
  #shopify-section-{{ section.id }} {
    height: 0 !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    border: 0 !important;
  }

  /* Gradient Glow keeps inclusion badges high-contrast, matching the
     dark/white treatment used on the dark storefront designs. */
  #MainContent:has(#ss-private-store-state[data-layout="gradient"]) .product-badges__badge--pro-extra {
    background: rgb(17 16 14 / 0.88) !important;
    color: #ffffff !important;
  }
</style>

<script>
  (function(){
    function installStoreMessage(){
      var state = document.getElementById('ss-private-store-state');
      var copy = document.querySelector('.ps-hero .ps-copy');
      if (!state || !copy) return;

      var show = state.dataset.showMessage === 'true';
      var text = (state.dataset.message || '').trim();
      var message = copy.querySelector('.ss-hero-message');

      if (!show || !text) {
        if (message) message.hidden = true;
        return;
      }

      if (!message) {
        message = document.createElement('div');
        message.className = 'ss-hero-message';
        copy.appendChild(message);
      }
      message.textContent = text;
      message.hidden = false;
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', installStoreMessage, { once: true });
    else installStoreMessage();
    document.addEventListener('shopify:section:load', installStoreMessage);
  })();
</script>

{% schema %}
{
  "name": "Store template state",
  "enabled_on": { "templates": ["collection"] },
  "settings": []
}
{% endschema %}
