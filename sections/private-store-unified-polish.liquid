{{ 'storefront-unified-polish.css' | asset_url | stylesheet_tag }}
{{ 'storefront-tab-strip-fix.css' | asset_url | stylesheet_tag }}
{{ 'storefront-final-tune.css' | asset_url | stylesheet_tag }}

<style>
  /*
    FINAL INLINE STOREFRONT TUNE
    This intentionally lives in the collection HTML so the storefront snapshot
    and the real draft collection use the exact same last-loaded rules.
  */

  /* Remove the category container structurally. Only the buttons remain. */
  #MainContent .shopify-section:has(.ss-category-nav),
  #MainContent .ss-storefront-enhancements,
  #MainContent .ss-category-nav {
    display: contents !important;
    background: transparent !important;
    background-image: none !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
  }

  #MainContent .ss-category-tabs {
    width: min(1320px, calc(100% - 40px)) !important;
    margin: 9px auto 10px !important;
    padding: 0 !important;
    display: flex !important;
    align-items: center !important;
    gap: 7px !important;
    overflow-x: auto !important;
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    scrollbar-width: none !important;
  }

  #MainContent .ss-category-tabs::-webkit-scrollbar {
    display: none !important;
  }

  #MainContent .ss-category-tab {
    flex: 0 0 auto !important;
    border-radius: 999px !important;
  }

  /* Prevent Shopify section backgrounds from creating a strip behind the tabs. */
  #MainContent .shopify-section:has(.ss-category-nav) > .section-background,
  #MainContent .ss-storefront-enhancements > .section-background {
    display: none !important;
  }

  /* GRADIENT GLOW — vivid primary from top-left, secondary from bottom-right. */
  html.ss-store-custom.ss-style-bold.ss-pattern-none #MainContent {
    background:
      radial-gradient(ellipse 86% 72% at -12% -12%,
        color-mix(in srgb, var(--ss-team-primary) 96%, #ffffff) 0%,
        color-mix(in srgb, var(--ss-team-primary) 78%, #ffffff) 24%,
        color-mix(in srgb, var(--ss-team-primary) 46%, #ffffff) 46%,
        color-mix(in srgb, var(--ss-team-primary) 18%, #ffffff) 66%,
        transparent 79%),
      radial-gradient(ellipse 92% 76% at 112% 112%,
        color-mix(in srgb, var(--ss-team-secondary) 96%, #ffffff) 0%,
        color-mix(in srgb, var(--ss-team-secondary) 76%, #ffffff) 25%,
        color-mix(in srgb, var(--ss-team-secondary) 44%, #ffffff) 49%,
        color-mix(in srgb, var(--ss-team-secondary) 18%, #ffffff) 68%,
        transparent 81%),
      linear-gradient(145deg, #fff 0%, #fbfbfd 48%, #fff 100%) !important;
  }

  html.ss-store-custom.ss-style-bold.ss-pattern-none #MainContent .section-background,
  html.ss-store-custom.ss-style-bold.ss-pattern-none .ps-hero,
  html.ss-store-custom.ss-style-bold.ss-pattern-none results-list {
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
  }

  html.ss-store-custom.ss-style-bold.ss-pattern-none .ps-hero-card {
    border: 1px solid rgba(255,255,255,.76) !important;
    background:
      linear-gradient(145deg, rgba(255,255,255,.84), rgba(255,255,255,.66)) !important;
    box-shadow:
      0 30px 90px rgba(17,16,14,.12),
      inset 0 1px 0 rgba(255,255,255,.72) !important;
    backdrop-filter: blur(18px) saturate(1.12) !important;
    -webkit-backdrop-filter: blur(18px) saturate(1.12) !important;
  }

  /* PRO DARK — one continuous command-center environment. */
  html.ss-store-custom.ss-style-dark.ss-pattern-grid #MainContent {
    position: relative !important;
    isolation: isolate !important;
    background-color: #050b12 !important;
    background-image:
      linear-gradient(rgba(117,145,176,.040) 1px, transparent 1px),
      linear-gradient(90deg, rgba(117,145,176,.040) 1px, transparent 1px),
      radial-gradient(ellipse 64% 46% at -10% -8%, color-mix(in srgb, var(--ss-team-primary) 42%, transparent), transparent 68%),
      radial-gradient(ellipse 54% 42% at 108% 4%, color-mix(in srgb, var(--ss-team-secondary) 30%, transparent), transparent 69%),
      linear-gradient(145deg, #050b12 0%, #09121e 50%, #06101a 100%) !important;
    background-size: 30px 30px, 30px 30px, auto, auto, auto !important;
  }

  html.ss-store-custom.ss-style-dark.ss-pattern-grid #MainContent::before {
    content: '' !important;
    position: absolute !important;
    inset: 0 !important;
    z-index: -1 !important;
    pointer-events: none !important;
    background:
      linear-gradient(90deg, transparent 0%, rgba(255,255,255,.018) 50%, transparent 100%) 0 145px / 100% 1px no-repeat,
      linear-gradient(90deg, transparent 0%, color-mix(in srgb, var(--ss-team-secondary) 28%, transparent) 50%, transparent 100%) 0 146px / 100% 1px no-repeat,
      repeating-linear-gradient(180deg, transparent 0 11px, rgba(255,255,255,.008) 12px 13px) !important;
  }

  html.ss-store-custom.ss-style-dark.ss-pattern-grid #MainContent .section-background,
  html.ss-store-custom.ss-style-dark.ss-pattern-grid .ps-hero,
  html.ss-store-custom.ss-style-dark.ss-pattern-grid results-list {
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
  }

  html.ss-store-custom.ss-style-dark.ss-pattern-grid .ps-hero-card {
    position: relative !important;
    overflow: hidden !important;
    border: 1px solid rgba(151,177,205,.20) !important;
    border-top: 2px solid color-mix(in srgb, var(--ss-team-secondary) 84%, #ffffff) !important;
    background:
      radial-gradient(circle at 0% 0%, color-mix(in srgb, var(--ss-team-primary) 20%, transparent), transparent 40%),
      linear-gradient(145deg, rgba(16,27,41,.96), rgba(7,14,24,.95)) !important;
    box-shadow:
      0 32px 100px rgba(0,0,0,.46),
      inset 0 1px 0 rgba(255,255,255,.05),
      0 0 70px color-mix(in srgb, var(--ss-team-secondary) 8%, transparent) !important;
  }

  html.ss-store-custom.ss-style-dark.ss-pattern-grid .ps-hero-card::before {
    content: '' !important;
    position: absolute !important;
    inset: 10px !important;
    z-index: 0 !important;
    pointer-events: none !important;
    opacity: .62 !important;
    background:
      linear-gradient(var(--ss-team-secondary), var(--ss-team-secondary)) top left / 62px 2px no-repeat,
      linear-gradient(var(--ss-team-secondary), var(--ss-team-secondary)) top left / 2px 34px no-repeat,
      linear-gradient(var(--ss-team-primary), var(--ss-team-primary)) bottom right / 62px 2px no-repeat,
      linear-gradient(var(--ss-team-primary), var(--ss-team-primary)) bottom right / 2px 34px no-repeat !important;
  }

  html.ss-store-custom.ss-style-dark.ss-pattern-grid .ps-hero-card > * {
    position: relative !important;
    z-index: 1 !important;
  }

  html.ss-store-custom.ss-style-dark.ss-pattern-grid .ps-eyebrow {
    border: 1px solid color-mix(in srgb, var(--ss-team-secondary) 34%, rgba(255,255,255,.10)) !important;
    background: color-mix(in srgb, var(--ss-team-secondary) 11%, rgba(255,255,255,.035)) !important;
    color: color-mix(in srgb, var(--ss-team-secondary) 82%, #ffffff) !important;
    box-shadow: 0 0 18px color-mix(in srgb, var(--ss-team-secondary) 9%, transparent) !important;
  }

  html.ss-store-custom.ss-style-dark.ss-pattern-grid .ps-title {
    color: #f8fbff !important;
    text-shadow: 0 2px 20px rgba(0,0,0,.28) !important;
  }

  html.ss-store-custom.ss-style-dark.ss-pattern-grid .ps-sub {
    color: #afbdcc !important;
    opacity: 1 !important;
  }

  html.ss-store-custom.ss-style-dark.ss-pattern-grid .ps-action-panel {
    border: 1px solid rgba(151,177,205,.20) !important;
    background: linear-gradient(180deg, rgba(20,32,47,.92), rgba(7,14,23,.90)) !important;
    box-shadow: inset 0 1px rgba(255,255,255,.04), 0 18px 46px rgba(0,0,0,.28) !important;
  }

  html.ss-store-custom.ss-style-dark.ss-pattern-grid .ps-action-panel-title {
    color: color-mix(in srgb, var(--ss-team-secondary) 78%, #dbe8f5) !important;
  }

  html.ss-store-custom.ss-style-dark.ss-pattern-grid .ps-meta-row span {
    border-color: rgba(151,177,205,.18) !important;
    background: rgba(133,157,184,.08) !important;
    color: #dce6f0 !important;
  }

  html.ss-store-custom.ss-style-dark.ss-pattern-grid .ps-btn-ghost {
    border-color: rgba(190,205,221,.30) !important;
    background: rgba(235,241,247,.94) !important;
    color: #07101a !important;
  }

  html.ss-store-custom.ss-style-dark.ss-pattern-grid .ps-btn-soft,
  html.ss-store-custom.ss-style-dark.ss-pattern-grid button.ps-btn-soft {
    border-color: color-mix(in srgb, var(--ss-team-secondary) 52%, rgba(255,255,255,.20)) !important;
    background: color-mix(in srgb, var(--ss-team-secondary) 22%, rgba(255,255,255,.08)) !important;
    color: #ffffff !important;
    font-weight: 900 !important;
    text-shadow: 0 1px 9px rgba(0,0,0,.42) !important;
    box-shadow: inset 0 1px rgba(255,255,255,.06), 0 8px 24px rgba(0,0,0,.18) !important;
  }

  html.ss-store-custom.ss-style-dark.ss-pattern-grid .ss-category-tab {
    border-color: rgba(151,177,205,.22) !important;
    background: rgba(15,27,42,.88) !important;
    color: #d3deea !important;
    box-shadow: inset 0 1px rgba(255,255,255,.03) !important;
  }

  html.ss-store-custom.ss-style-dark.ss-pattern-grid .ss-category-tab.active {
    border-color: var(--ss-team-secondary) !important;
    background: var(--ss-team-secondary) !important;
    color: var(--ss-team-secondary-text) !important;
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--ss-team-secondary) 34%, transparent),
      0 0 26px color-mix(in srgb, var(--ss-team-secondary) 24%, transparent) !important;
  }

  html.ss-store-custom.ss-style-dark.ss-pattern-grid .ss-hero-message {
    border-color: rgba(151,177,205,.18) !important;
    border-left-color: var(--ss-team-secondary) !important;
    background: rgba(4,11,19,.58) !important;
    color: #e9f0f7 !important;
  }

  @media (max-width: 768px) {
    #MainContent .ss-category-tabs {
      width: 100% !important;
      margin: 6px auto 7px !important;
      padding: 0 8px !important;
    }

    html.ss-store-custom.ss-style-bold.ss-pattern-none #MainContent {
      background:
        radial-gradient(ellipse 112% 62% at -12% -9%,
          color-mix(in srgb, var(--ss-team-primary) 92%, #ffffff) 0%,
          color-mix(in srgb, var(--ss-team-primary) 58%, #ffffff) 34%,
          transparent 72%),
        radial-gradient(ellipse 112% 64% at 112% 110%,
          color-mix(in srgb, var(--ss-team-secondary) 92%, #ffffff) 0%,
          color-mix(in srgb, var(--ss-team-secondary) 56%, #ffffff) 36%,
          transparent 74%),
        #ffffff !important;
    }

    html.ss-store-custom.ss-style-dark.ss-pattern-grid #MainContent {
      background-size: 24px 24px, 24px 24px, auto, auto, auto !important;
    }

    html.ss-store-custom.ss-style-dark.ss-pattern-grid .ps-hero-card::before {
      inset: 6px !important;
      opacity: .42 !important;
      background:
        linear-gradient(var(--ss-team-secondary), var(--ss-team-secondary)) top left / 34px 1px no-repeat,
        linear-gradient(var(--ss-team-secondary), var(--ss-team-secondary)) top left / 1px 21px no-repeat,
        linear-gradient(var(--ss-team-primary), var(--ss-team-primary)) bottom right / 34px 1px no-repeat,
        linear-gradient(var(--ss-team-primary), var(--ss-team-primary)) bottom right / 1px 21px no-repeat !important;
    }
  }
</style>

<script src="{{ 'storefront-live-structure.js' | asset_url }}" defer></script>
<script src="{{ 'storefront-tab-runtime-fix.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Storefront unified polish",
  "enabled_on": { "templates": ["collection"] },
  "settings": []
}
{% endschema %}
