{% comment %}
  VISUAL POLISH FOR PRIVATE STOREFRONT PRESETS
  Loaded after the base enhancement section so these preset-specific styles
  can be adjusted or removed independently.
{% endcomment %}

<style>
  /* Make category navigation feel connected to the storefront rather than a separate section. */
  .ss-category-nav {
    width: min(1320px, calc(100% - 40px));
    margin: 0 auto 8px;
    padding: 6px 8px 3px;
    border: 1px solid rgba(17,16,14,.08);
    border-radius: 18px;
    background: rgba(255,255,255,.90);
    box-shadow: 0 12px 34px rgba(17,16,14,.07);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .ss-category-tabs {
    padding: 0 1px 3px;
  }

  .ss-category-tab {
    min-height: 35px;
    transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  .ss-category-tab:hover {
    transform: translateY(-1px);
  }

  /* Shared product-card treatment for the two dark visual systems. */
  html.ss-store-custom:is(.ss-style-bold.ss-pattern-dots,.ss-style-dark.ss-pattern-grid) results-list {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #ffffff;
  }

  html.ss-store-custom:is(.ss-style-bold.ss-pattern-dots,.ss-style-dark.ss-pattern-grid) results-list > * {
    position: relative;
    z-index: 2;
  }

  html.ss-store-custom:is(.ss-style-bold.ss-pattern-dots,.ss-style-dark.ss-pattern-grid) results-list .facets-block-wrapper,
  html.ss-store-custom:is(.ss-style-bold.ss-pattern-dots,.ss-style-dark.ss-pattern-grid) results-list .facets,
  html.ss-store-custom:is(.ss-style-bold.ss-pattern-dots,.ss-style-dark.ss-pattern-grid) results-list .sorting-filter,
  html.ss-store-custom:is(.ss-style-bold.ss-pattern-dots,.ss-style-dark.ss-pattern-grid) results-list .product-count {
    color: #ffffff !important;
  }

  html.ss-store-custom:is(.ss-style-bold.ss-pattern-dots,.ss-style-dark.ss-pattern-grid) results-list .product-grid__item {
    overflow: hidden;
    padding: 9px;
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 18px;
    background: rgba(255,255,255,.96);
    color: #11100e !important;
    box-shadow: 0 18px 46px rgba(0,0,0,.22);
  }

  html.ss-store-custom:is(.ss-style-bold.ss-pattern-dots,.ss-style-dark.ss-pattern-grid) results-list .product-grid__item a,
  html.ss-store-custom:is(.ss-style-bold.ss-pattern-dots,.ss-style-dark.ss-pattern-grid) results-list .product-grid__item span,
  html.ss-store-custom:is(.ss-style-bold.ss-pattern-dots,.ss-style-dark.ss-pattern-grid) results-list .product-grid__item p {
    color: #11100e !important;
  }

  /* TRUE PAINT SPRAY — a full dark store with organic team-color spray. */
  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ps-hero {
    position: relative;
    isolation: isolate;
    background:
      linear-gradient(135deg,
        color-mix(in srgb, var(--ss-team-primary) 20%, #070b12),
        #070b12 58%,
        color-mix(in srgb, var(--ss-team-secondary) 10%, #070b12)) !important;
  }

  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ps-hero::before,
  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ps-hero::after,
  html.ss-store-custom.ss-style-bold.ss-pattern-dots results-list::before,
  html.ss-store-custom.ss-style-bold.ss-pattern-dots results-list::after {
    content: '';
    position: absolute;
    pointer-events: none;
    z-index: 0;
  }

  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ps-hero::before {
    inset: -28% 28% -34% -18%;
    opacity: .88;
    transform: rotate(-10deg);
    background:
      radial-gradient(circle at 8% 38%, color-mix(in srgb,var(--ss-team-primary) 92%,transparent) 0 2px, transparent 3px),
      radial-gradient(circle at 13% 28%, color-mix(in srgb,var(--ss-team-primary) 86%,transparent) 0 4px, transparent 5px),
      radial-gradient(circle at 17% 62%, color-mix(in srgb,var(--ss-team-primary) 86%,transparent) 0 3px, transparent 4px),
      radial-gradient(circle at 22% 18%, color-mix(in srgb,var(--ss-team-primary) 82%,transparent) 0 6px, transparent 7px),
      radial-gradient(circle at 27% 73%, color-mix(in srgb,var(--ss-team-primary) 88%,transparent) 0 5px, transparent 6px),
      radial-gradient(circle at 34% 24%, color-mix(in srgb,var(--ss-team-primary) 86%,transparent) 0 3px, transparent 4px),
      radial-gradient(circle at 40% 66%, color-mix(in srgb,var(--ss-team-primary) 82%,transparent) 0 7px, transparent 8px),
      radial-gradient(circle at 48% 35%, color-mix(in srgb,var(--ss-team-primary) 76%,transparent) 0 4px, transparent 5px),
      radial-gradient(ellipse at 33% 48%, color-mix(in srgb,var(--ss-team-primary) 76%,transparent) 0 18%, transparent 58%),
      radial-gradient(ellipse at 46% 54%, color-mix(in srgb,var(--ss-team-primary) 48%,transparent) 0 14%, transparent 58%);
    filter: saturate(1.2);
  }

  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ps-hero::after {
    inset: -34% -12% -26% 58%;
    opacity: .72;
    transform: rotate(12deg);
    background:
      radial-gradient(circle at 18% 22%, color-mix(in srgb,var(--ss-team-secondary) 94%,transparent) 0 3px, transparent 4px),
      radial-gradient(circle at 31% 67%, color-mix(in srgb,var(--ss-team-secondary) 86%,transparent) 0 5px, transparent 6px),
      radial-gradient(circle at 42% 30%, color-mix(in srgb,var(--ss-team-secondary) 82%,transparent) 0 2px, transparent 3px),
      radial-gradient(circle at 56% 75%, color-mix(in srgb,var(--ss-team-secondary) 84%,transparent) 0 4px, transparent 5px),
      radial-gradient(circle at 72% 40%, color-mix(in srgb,var(--ss-team-secondary) 82%,transparent) 0 6px, transparent 7px),
      radial-gradient(ellipse at 48% 48%, color-mix(in srgb,var(--ss-team-secondary) 48%,transparent) 0 18%, transparent 58%);
  }

  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ps-hero > * {
    position: relative;
    z-index: 2;
  }

  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ps-hero-card {
    background: rgba(7,11,18,.72) !important;
    border-color: rgba(255,255,255,.15) !important;
    box-shadow: 0 30px 100px rgba(0,0,0,.38) !important;
    backdrop-filter: blur(18px) saturate(1.1) !important;
    -webkit-backdrop-filter: blur(18px) saturate(1.1) !important;
  }

  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ps-title,
  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ps-sub,
  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ps-eyebrow,
  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ps-action-panel-title {
    color: #ffffff !important;
  }

  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ps-sub {
    opacity: .72;
  }

  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ps-meta-row span,
  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ps-action-panel {
    border-color: rgba(255,255,255,.14) !important;
    background: rgba(255,255,255,.08) !important;
    color: #ffffff !important;
  }

  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ps-btn-ghost,
  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ps-btn-soft {
    border-color: rgba(255,255,255,.18) !important;
    background: rgba(255,255,255,.10) !important;
    color: #ffffff !important;
  }

  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ss-hero-message {
    border-color: rgba(255,255,255,.14);
    border-left-color: var(--ss-team-secondary);
    background: rgba(255,255,255,.09);
    color: #ffffff;
  }

  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ss-category-nav {
    border-color: rgba(255,255,255,.13);
    background: rgba(11,16,25,.90);
    box-shadow: 0 16px 44px rgba(0,0,0,.30);
  }

  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ss-category-tab {
    border-color: rgba(255,255,255,.15);
    background: rgba(255,255,255,.08);
    color: rgba(255,255,255,.82);
  }

  html.ss-store-custom.ss-style-bold.ss-pattern-dots .ss-category-tab.active {
    border-color: var(--ss-team-secondary);
    background: var(--ss-team-secondary);
    color: var(--ss-team-secondary-text);
    box-shadow: 0 10px 24px color-mix(in srgb,var(--ss-team-secondary) 34%,transparent);
  }

  html.ss-store-custom.ss-style-bold.ss-pattern-dots results-list {
    background:
      linear-gradient(180deg,
        color-mix(in srgb,var(--ss-team-primary) 12%,#080d15),
        #080d15 46%,
        color-mix(in srgb,var(--ss-team-secondary) 7%,#080d15)) !important;
  }

  html.ss-store-custom.ss-style-bold.ss-pattern-dots results-list::before {
    inset: -12% 38% 20% -18%;
    opacity: .74;
    transform: rotate(-8deg);
    background:
      radial-gradient(circle at 12% 31%, color-mix(in srgb,var(--ss-team-primary) 88%,transparent) 0 3px, transparent 4px),
      radial-gradient(circle at 18% 62%, color-mix(in srgb,var(--ss-team-primary) 82%,transparent) 0 5px, transparent 6px),
      radial-gradient(circle at 28% 24%, color-mix(in srgb,var(--ss-team-primary) 84%,transparent) 0 7px, transparent 8px),
      radial-gradient(circle at 38% 69%, color-mix(in srgb,var(--ss-team-primary) 76%,transparent) 0 4px, transparent 5px),
      radial-gradient(ellipse at 32% 48%, color-mix(in srgb,var(--ss-team-primary) 46%,transparent) 0 19%, transparent 60%);
  }

  html.ss-store-custom.ss-style-bold.ss-pattern-dots results-list::after {
    inset: 42% -12% -18% 58%;
    opacity: .52;
    transform: rotate(15deg);
    background:
      radial-gradient(circle at 24% 25%, color-mix(in srgb,var(--ss-team-secondary) 84%,transparent) 0 4px, transparent 5px),
      radial-gradient(circle at 42% 64%, color-mix(in srgb,var(--ss-team-secondary) 82%,transparent) 0 6px, transparent 7px),
      radial-gradient(circle at 68% 35%, color-mix(in srgb,var(--ss-team-secondary) 78%,transparent) 0 3px, transparent 4px),
      radial-gradient(ellipse at 48% 50%, color-mix(in srgb,var(--ss-team-secondary) 36%,transparent) 0 18%, transparent 62%);
  }

  /* PRO DARK — cleaner, quieter, more professional than Paint Spray. */
  html.ss-store-custom.ss-style-dark.ss-pattern-grid .ps-hero-card {
    border-top: 3px solid var(--ss-team-secondary) !important;
  }

  html.ss-store-custom.ss-style-dark.ss-pattern-grid .ss-category-nav {
    background: rgba(17,22,30,.94);
    box-shadow: 0 16px 44px rgba(0,0,0,.28);
  }

  html.ss-store-custom.ss-style-dark.ss-pattern-grid results-list {
    background-color: #11161e !important;
    background-image:
      linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px),
      radial-gradient(circle at 12% 0%, color-mix(in srgb,var(--ss-team-primary) 22%,transparent), transparent 34%) !important;
    background-size: 34px 34px, 34px 34px, auto !important;
  }

  @media (max-width: 768px) {
    .ss-category-nav {
      width: calc(100% - 16px);
      margin-bottom: 5px;
      padding: 5px 6px 2px;
      border-radius: 14px;
      box-shadow: 0 8px 24px rgba(17,16,14,.07);
    }

    .ss-category-tab {
      min-height: 31px;
      padding: 0 10px;
      font-size: 10px;
    }

    html.ss-store-custom:is(.ss-style-bold.ss-pattern-dots,.ss-style-dark.ss-pattern-grid) results-list .product-grid__item {
      padding: 6px;
      border-radius: 13px;
      box-shadow: 0 10px 28px rgba(0,0,0,.20);
    }

    html.ss-store-custom.ss-style-bold.ss-pattern-dots .ps-hero::before {
      inset: -20% 4% -24% -30%;
      opacity: .72;
    }

    html.ss-store-custom.ss-style-bold.ss-pattern-dots .ps-hero::after {
      inset: -24% -24% -18% 48%;
      opacity: .55;
    }
  }
</style>

{% schema %}
{
  "name": "Storefront visual polish",
  "enabled_on": { "templates": ["collection"] },
  "settings": []
}
{% endschema %}