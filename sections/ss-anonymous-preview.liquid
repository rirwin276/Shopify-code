<section class="ss-preview" data-ss-private-preview data-api="{{ section.settings.api_base | escape }}" data-login="{{ routes.storefront_login_url | escape }}" data-signed-in="{% if customer %}true{% else %}false{% endif %}">
  <div class="ss-preview__notice"><span>YOUR PRIVATE PREVIEW · NO ACCOUNT NEEDED TO EXPLORE</span><button data-activate>Keep this store →</button></div>
  <div class="ss-preview__error" data-error role="alert" hidden></div>
  <div class="ss-preview__loading" data-loading role="status">Opening your team store…</div>
  <div data-content hidden>
    <header class="ss-preview__hero"><img data-logo alt="Your team logo" hidden width="100" height="100"><p>MADE FOR YOUR TEAM</p><h1 data-store-name></h1><div data-welcome></div></header>
    <nav class="ss-preview__tabs" aria-label="Preview tools"><button data-tab="store" aria-selected="true">Your store</button><button data-tab="admin">Manage & design</button><button data-tab="appearance">Store style</button></nav>
    <div data-panel="store"><div class="ss-preview__intro"><h2>Your team. Your gear.</h2><p>Browse your real designs. Ordering unlocks when you activate your free store.</p></div><div class="ss-preview__grid" data-products></div></div>
    <div data-panel="admin" hidden><div class="ss-preview__intro ss-preview__row"><div><h2>Make it your own.</h2><p>Add designs, change artwork and colors, or choose what’s shown in your store.</p></div><button class="ss-preview__primary" data-add>Add a product +</button></div><p data-build-note role="status"></p><div class="ss-preview__grid" data-admin-products></div><div class="ss-preview__locked"><strong>Bring your team along when you’re ready.</strong><p>Sharing, invitations and ordering unlock after you sign in and keep this store.</p><button data-activate>Activate my free store →</button></div></div>
    <div data-panel="appearance" hidden><form data-appearance class="ss-preview__form"><h2>Give your store its team colors.</h2><p>Preview changes here as you make them, then save when it feels right.</p><label>Store name<input name="name" required maxlength="120"></label><div class="ss-preview__row"><label>Primary color<input name="primary_color" type="color" value="#142a3e"></label><label>Accent color<input name="secondary_color" type="color" value="#c6ae70"></label></div><label>Welcome message<textarea name="welcome_message" maxlength="180" rows="3"></textarea></label><button class="ss-preview__primary" type="submit">Save store style</button><span data-style-status role="status"></span></form></div>
    <div data-panel="activate" hidden class="ss-preview__activate"><p>THIS ONE’S YOURS</p><h2>Keep your store. Keep every design.</h2><p>Sign in to activate this same store for free. Then invite your team and let parents order for themselves.</p><ul><li>Your saved artwork, colors and products stay right here.</li><li>No upfront fees or minimum orders.</li><li>Each customer pays for their own order.</li></ul><button class="ss-preview__primary" data-claim>{% if customer %}Activate my free store{% else %}Sign in & keep my store{% endif %}</button><p data-claim-status role="status"></p><button data-tab="store">Keep exploring</button></div>
    <footer class="ss-preview__footer"><span data-expiry></span><button data-activate>Keep this store free →</button></footer>
  </div>
  <dialog data-catalog class="ss-preview__dialog"><div class="ss-preview__row"><h2>What will you make next?</h2><button data-close aria-label="Close product catalog">Close ✕</button></div><p>Pick your gear, then try artwork, colors and placement in the design studio.</p><div class="ss-preview__grid" data-catalog-grid></div></dialog>
  <dialog data-product class="ss-preview__dialog"><div class="ss-preview__row"><h2 data-product-title></h2><button data-close aria-label="Close product preview">Close ✕</button></div><div class="ss-preview__product-detail"><div><img data-product-image alt="Product preview"><div data-product-thumbs class="ss-preview__thumbs"></div></div><div><p data-product-price></p><label>Color & size<select data-variant></select></label><p data-product-description></p><button class="ss-preview__primary" data-activate>Activate store to enable ordering</button><p>This is your private preview. No purchases can be made yet.</p></div></div></dialog>
  <dialog data-editor class="ss-preview__dialog ss-preview__dialog--editor"><div class="ss-preview__row"><strong>Your design studio</strong><button data-editor-close>Back to my store ✕</button></div><p>Save your design in the studio, then return here to see it build.</p><iframe title="Product design studio" referrerpolicy="no-referrer"></iframe></dialog>
  <dialog data-delete class="ss-preview__dialog"><h2>Remove this preview product?</h2><p>You can create a new design at any time. This only removes the selected product from your preview.</p><button class="ss-preview__primary" data-delete-confirm>Remove product</button><button data-close>Keep it</button></dialog>
</section>
{{ 'ss-anonymous-preview.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ss-anonymous-preview.js' | asset_url }}" defer></script>
{% schema %}
{"name":"Private store preview","settings":[{"type":"text","id":"api_base","label":"Preview API URL","default":"https://anonymous-demo-preview-production.up.railway.app"}]}
{% endschema %}
