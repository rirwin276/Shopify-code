{% comment %}How it works: server-rendered guide with existing signed-in request routing.{% endcomment %}
{% assign form_page_url = '/pages/request-storefront-form' %}
{% assign dashboard_url = '/pages/portal' %}
{% if customer %}
  {% assign request_cta_url = form_page_url %}
{% else %}
  {% assign encoded_return = form_page_url | url_encode %}
  {% assign request_cta_url = routes.storefront_login_url | append: '?return_to=' | append: encoded_return %}
{% endif %}
{{ 'ss-guide-pages.css' | asset_url | stylesheet_tag }}

<section class="ss-guide" data-ss-exp>
  <div class="ss-guide__wrap">
    <header class="ss-guide__hero">
      <div>
        <p class="ss-guide__eyebrow">HOW IT WORKS</p>
        <h1>Your group. Your gear.<br>One simple store.</h1>
        <p class="ss-guide__lead">Create a private apparel store for your team, unit, business, or group. Everyone chooses their own gear and orders online. We make it and ship it directly to them.</p>
        <div class="ss-guide__actions">
          <a class="ss-guide__button" href="{{ request_cta_url }}">Create a free store <span aria-hidden="true">→</span></a>
          {% if customer %}<a class="ss-guide__button ss-guide__button--secondary" href="{{ dashboard_url }}">Open my dashboard</a>{% else %}<a class="ss-guide__button ss-guide__button--secondary" href="#the-process">See the steps</a>{% endif %}
        </div>
        <ul class="ss-guide__benefits" aria-label="Store benefits"><li>Free store setup</li><li>No minimums</li><li>No order deadlines</li></ul>
      </div>
      <figure class="ss-guide__photo">
        <img src="{{ 'ss-home-cashmere-showcase.webp' | asset_url }}" alt="Cashmere Youth Football hoodie and coaches polo with team artwork" width="1200" height="800" loading="eager">
        <figcaption><span>BUILT AROUND YOUR GROUP</span><strong>Your logo. A whole team’s worth of possibilities.</strong><p>Shirts, hoodies, hats, and more in one place.</p></figcaption>
      </figure>
    </header>

    <nav class="ss-guide__nav" aria-label="On this page">
      <a href="#the-process">The process</a><a href="#store-access">Managing your store</a><a href="#personalization">Personalization</a><a href="#common-questions">Common questions</a>
    </nav>

    <section class="ss-guide__section" id="the-process" aria-labelledby="ss-process-title">
      <div class="ss-guide__heading"><p class="ss-guide__eyebrow">FROM IDEA TO OPEN STORE</p><h2 id="ss-process-title">A few steps. Then you’re ready.</h2><p>The request takes about two minutes. Most stores are built in about fifteen.</p></div>
      <ol class="ss-guide__steps">
        <li><span aria-hidden="true">01</span><h3>Tell us about your group</h3><p>Add your group name, logo, colors, and a few details. You don’t need everyone’s sizes or a collected payment.</p></li>
        <li><span aria-hidden="true">02</span><h3>Review your store</h3><p>We prepare your storefront and branded products. Once it’s ready, review the gear and use Admin Powers to refine your designs.</p></li>
        <li><span aria-hidden="true">03</span><h3>Share with your people</h3><p>Send your store link or invite members. Each person picks their products, chooses a size and color, and pays online.</p></li>
        <li><span aria-hidden="true">04</span><h3>We make it and ship it</h3><p>Items are made to order and delivered directly to each buyer. Your store stays available for the next order, too.</p></li>
      </ol>
    </section>

    <section class="ss-guide__section ss-guide__split" id="store-access" aria-labelledby="ss-manage-title">
      <div class="ss-guide__heading"><p class="ss-guide__eyebrow">YOUR DASHBOARD</p><h2 id="ss-manage-title">One place to come back to.</h2><p>The stores you create or join live in your dashboard. Your access determines the tools you see.</p><a class="ss-guide__text-link" href="{{ dashboard_url }}">Go to the dashboard <span aria-hidden="true">→</span></a></div>
      <div class="ss-guide__roles">
        <article class="ss-guide__card"><p class="ss-guide__eyebrow">FOR ORGANIZERS</p><h3>Keep your store up to date</h3><p>Use Admin Powers to add products, adjust artwork and colors, manage product visibility, and share access with your group.</p></article>
        <article class="ss-guide__card"><p class="ss-guide__eyebrow">FOR MEMBERS</p><h3>Find your store and shop</h3><p>Open the link from your organizer and sign in with the invited email when needed. Choose your store from the dashboard whenever you want to return.</p></article>
      </div>
    </section>

    <section class="ss-guide__section ss-guide__personalization" id="personalization" aria-labelledby="ss-personalization-title">
      <div><p class="ss-guide__eyebrow">OPTIONAL NAME + NUMBER</p><h2 id="ss-personalization-title">Team gear with a personal touch.</h2><p>When an organizer enables personalization on an eligible product, each buyer enters their own name, number, or both while ordering.</p><p>Review spelling, number, size, and color before checkout. The details travel with the order into production.</p></div>
      <aside class="ss-guide__checklist" aria-label="Before you place an order"><h3>A quick check before checkout</h3><ul><li>Use the product’s size chart</li><li>Confirm your color and design</li><li>Double-check names and numbers</li><li>Allow time for production and shipping</li></ul><a class="ss-guide__text-link" href="/pages/support#shipping">Shipping &amp; delivery details <span aria-hidden="true">→</span></a></aside>
    </section>

    <section class="ss-guide__section ss-guide__split" id="common-questions" aria-labelledby="ss-questions-title">
      <div class="ss-guide__heading"><p class="ss-guide__eyebrow">GOOD TO KNOW</p><h2 id="ss-questions-title">A few common questions.</h2><p>Need help with an existing store or order?</p><a class="ss-guide__text-link" href="/pages/support">Visit support <span aria-hidden="true">→</span></a></div>
      <div class="ss-guide__faq">
        <details><summary>Does a store cost anything to set up?</summary><p>Store setup is free. Members pay for the products they order, with no minimum group order or upfront inventory to purchase.</p></details>
        <details><summary>Do I collect sizes, payments, or orders?</summary><p>No. Each buyer chooses their size and color, enters any available personalization, and pays directly online. Products ship to the buyer.</p></details>
        <details><summary>Can I change products after the store opens?</summary><p>Yes. Store admins can use Admin Powers to adjust artwork and colors, add more products, and change which products are available.</p></details>
        <details><summary>Can new members order later?</summary><p>Yes. There is no group order deadline. Share your store with new members so they can order when they’re ready.</p></details>
        <details><summary>How long will an order take?</summary><p>Allow 3–5 business days for fulfillment, followed by up to one week for shipping. These are estimates, so order early for a fixed event date. <a href="/pages/support#shipping">See delivery details.</a></p></details>
      </div>
    </section>

    <section class="ss-guide__finish">
      <div><p class="ss-guide__eyebrow">READY WHEN YOU ARE</p><h2>Give your group a store of its own.</h2><p>Bring your logo. We’ll help turn it into your group’s next favorite gear.</p></div>
      <a class="ss-guide__button" href="{{ request_cta_url }}">Create a free store <span aria-hidden="true">→</span></a>
    </section>
  </div>
</section>

{% schema %}
{
  "name": "Explainer - Simple",
  "settings": [
    { "type": "text", "id": "title", "label": "Main Title", "default": "Stop collecting money. Stop tallying sizes." },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "The platform built to let the Team Mom, the Unit Supply Guy, and the Office Assistant retire from the custom gear business." },
    { "type": "text", "id": "btn_request", "label": "CTA Button", "default": "Request a Storefront" },
    { "type": "text", "id": "btn_back", "label": "Back Button", "default": "Back to Dashboard" },

    { "type": "text", "id": "problem_title", "label": "Problem Title", "default": "Fire the \"Middleman\"" },
    { "type": "textarea", "id": "problem_text", "label": "Problem Text", "default": "Coordinating group orders is a nightmare of spreadsheets, loose cash, and wrong sizes. Our platform removes you from the transaction entirely." },

    { "type": "text", "id": "access_title", "label": "Access Title", "default": "You control the door." },
    { "type": "textarea", "id": "access_text", "label": "Access Text", "default": "Whether you need military-grade exclusivity or casual group sharing, we give you the keys." }
  ],
  "presets": [ { "name": "Explainer - Simple" } ]
}
{% endschema %}
