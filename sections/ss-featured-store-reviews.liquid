{%- comment -%}
  Stella & Sage — approved store-experience proof.
  The service returns only hand-featured, already-approved reviews (max five).
  No placeholder testimonials: the whole section stays hidden until real ones
  are available.

  Placement: on the homepage the landing hub relocates itself around at runtime
  (the catalog is moved up into it), so a top-level section left where the JSON
  order puts it ends up below the entire landing hub. This section therefore
  moves itself into the hub's `reviews` slot, which sits directly above the
  catalog. Off the homepage, or on an older landing section with no slot, it
  simply renders in place.
{%- endcomment -%}
{%- assign review_api = section.settings.review_api | default: 'https://social-engine-production-68da.up.railway.app' -%}

<section class="ss-proof" id="ss-proof-{{ section.id }}" data-review-api="{{ review_api | escape }}" hidden>
  <div class="ss-proof__inner">
    <div class="ss-proof__heading">
      <p class="ss-proof__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.subheading | escape }}</p>
      <div class="ss-proof__summary" data-proof-summary hidden>
        <span class="ss-proof__avg" data-proof-avg></span>
        <span class="ss-proof__avgstars" data-proof-avgstars aria-hidden="true"></span>
        <span class="ss-proof__total" data-proof-total></span>
      </div>
    </div>
    <div class="ss-proof__viewport">
      <div class="ss-proof__track" data-proof-grid tabindex="0" role="region"
           aria-label="Customer reviews, scrollable"></div>
      <div class="ss-proof__nav" data-proof-nav hidden>
        <button type="button" class="ss-proof__arrow" data-proof-prev aria-label="Previous reviews">‹</button>
        <span class="ss-proof__count" data-proof-count></span>
        <button type="button" class="ss-proof__arrow" data-proof-next aria-label="More reviews">›</button>
      </div>
    </div>
  </div>
</section>

<style>
  /* This is the only place on the page where somebody other than us is
     talking, so it gets its own ground and its own weight rather than sitting
     in the same flat cream as everything above it. */
  #ss-proof-{{ section.id }} { padding:52px 0 58px; background:linear-gradient(180deg,#f6f1e6 0%,#fbf9f4 68%,#faf9f5 100%); border-top:1px solid rgba(183,163,106,.3); border-bottom:1px solid rgba(183,163,106,.22); }
  #ss-proof-{{ section.id }} .ss-proof__inner { width:min(1180px,calc(100% - 44px)); margin:0 auto; display:grid; grid-template-columns:minmax(240px,.72fr) minmax(0,1.28fr); gap:38px; align-items:center; padding:34px 34px 36px; border:1px solid rgba(183,163,106,.32); border-radius:28px; background:#fff; box-shadow:0 26px 70px rgba(17,16,14,.09); }
  #ss-proof-{{ section.id }} .ss-proof__heading { max-width:380px; }
  #ss-proof-{{ section.id }} .ss-proof__eyebrow { margin:0 0 11px; color:#8a6a1c; font-size:10px; font-weight:900; letter-spacing:.16em; }
  #ss-proof-{{ section.id }} h2 { margin:0; color:#11100e; font-size:clamp(29px,3.3vw,42px); line-height:1.02; letter-spacing:-.055em; font-weight:950; }

  /* The one number a stranger is scanning for. Computed from the reviews the
     service actually returned — never shown when there are too few to mean
     anything. */
  #ss-proof-{{ section.id }} .ss-proof__summary { display:flex; align-items:center; gap:9px; margin-top:15px; flex-wrap:wrap; }
  #ss-proof-{{ section.id }} .ss-proof__summary[hidden] { display:none; }
  #ss-proof-{{ section.id }} .ss-proof__avg { color:#11100e; font-size:31px; font-weight:950; letter-spacing:-.04em; line-height:1; }
  #ss-proof-{{ section.id }} .ss-proof__avgstars { color:#b98c16; font-size:17px; letter-spacing:1.5px; }
  #ss-proof-{{ section.id }} .ss-proof__total { width:100%; color:rgba(17,16,14,.56); font-size:12.5px; font-weight:700; }
  #ss-proof-{{ section.id }} .ss-proof__heading > p:last-child { margin:11px 0 0; color:rgba(17,16,14,.56); font-size:14px; line-height:1.5; font-weight:600; }
  /* A carousel rather than a grid: this fills up over time and a grid of
     thirty reviews is a wall nobody reads. Native scroll-snap does the work —
     it drags on a phone, wheels on a trackpad, and keeps working with the
     arrows hidden or JS not yet run. */
  #ss-proof-{{ section.id }} .ss-proof__viewport { position:relative; min-width:0; }
  #ss-proof-{{ section.id }} .ss-proof__track { display:flex; gap:12px; overflow-x:auto; scroll-snap-type:x mandatory; scroll-behavior:smooth; scroll-padding-left:2px; padding:2px 2px 12px; -webkit-overflow-scrolling:touch; scrollbar-width:none; }
  #ss-proof-{{ section.id }} .ss-proof__track::-webkit-scrollbar { display:none; }
  #ss-proof-{{ section.id }} .ss-proof__track:focus-visible { outline:2px solid #9f8d5a; outline-offset:3px; border-radius:20px; }
  #ss-proof-{{ section.id }} .ss-proof__card { position:relative; flex:0 0 clamp(240px,76vw,284px); scroll-snap-align:start; min-height:178px; display:flex; flex-direction:column; padding:21px 22px; border:1px solid rgba(183,163,106,.34); border-radius:20px; background:linear-gradient(180deg,#fffdf8 0%,#fff 42%); box-shadow:0 8px 26px rgba(17,16,14,.07); overflow:hidden; }
  #ss-proof-{{ section.id }} .ss-proof__nav { display:flex; align-items:center; gap:10px; margin-top:2px; }
  #ss-proof-{{ section.id }} .ss-proof__nav[hidden] { display:none; }
  #ss-proof-{{ section.id }} .ss-proof__arrow { width:38px; height:38px; display:grid; place-items:center; padding:0; border:1px solid rgba(17,16,14,.14); border-radius:50%; background:#fff; color:#11100e; font:inherit; font-size:21px; line-height:1; cursor:pointer; }
  #ss-proof-{{ section.id }} .ss-proof__arrow:disabled { opacity:.32; cursor:default; }
  #ss-proof-{{ section.id }} .ss-proof__count { color:rgba(17,16,14,.5); font-size:12px; font-weight:700; letter-spacing:.02em; }
  @media (prefers-reduced-motion: reduce) {
    #ss-proof-{{ section.id }} .ss-proof__track { scroll-behavior:auto; }
  }
  #ss-proof-{{ section.id }} .ss-proof__stars { color:#b98c16; font-size:16px; letter-spacing:2.5px; }
  #ss-proof-{{ section.id }} .ss-proof__stars i { color:rgba(17,16,14,.16); font-style:normal; }
  /* A real pull quote, not a caption. */
  #ss-proof-{{ section.id }} blockquote { position:relative; z-index:1; margin:12px 0 16px; color:#1d1e19; font-size:15.5px; line-height:1.5; font-weight:500; letter-spacing:-.008em; }
  #ss-proof-{{ section.id }} .ss-proof__card:before { content:"\201C"; position:absolute; top:-22px; right:8px; color:rgba(183,163,106,.22); font-family:Georgia,"Times New Roman",serif; font-size:118px; line-height:1; pointer-events:none; }
  #ss-proof-{{ section.id }} .ss-proof__person { display:flex; align-items:center; gap:10px; margin-top:auto; min-width:0; }
  #ss-proof-{{ section.id }} .ss-proof__avatar, #ss-proof-{{ section.id }} .ss-proof__photo { flex:0 0 46px; width:46px; height:46px; border-radius:50%; }
  #ss-proof-{{ section.id }} .ss-proof__avatar { display:grid; place-items:center; background:#20211b; color:#fff; font-size:15px; font-weight:800; }
  #ss-proof-{{ section.id }} .ss-proof__photo { object-fit:cover; border:2px solid #fff; box-shadow:0 1px 6px rgba(0,0,0,.13); }
  #ss-proof-{{ section.id }} .ss-proof__name { color:#21221c; font-size:13px; font-weight:800; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  #ss-proof-{{ section.id }} .ss-proof__meta { color:#74766f; font-size:12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  @media (max-width:700px) {
    #ss-proof-{{ section.id }} .ss-proof__inner { grid-template-columns:1fr; gap:20px; padding:26px 20px 28px; border-radius:24px; }
    #ss-proof-{{ section.id }} .ss-proof__heading { max-width:460px; }
    #ss-proof-{{ section.id }} .ss-proof__card { flex-basis:clamp(232px,80vw,300px); }
  }
</style>

<script>
(() => {
  const SECTION_ID = '{{ section.id }}';

  // Move into the landing hub's reviews slot when one is on the page, so the
  // section lands above the catalog instead of below the whole hub.
  const place = (root) => {
    const slot = document.querySelector('.ss-home [data-ss-home-slot="reviews"]');
    if (!slot || root.parentElement === slot) return;
    // The emptied .shopify-section shell is left in place: it collapses to zero
    // height and the theme editor can still target this section through it.
    slot.appendChild(root);
  };

  const render = (root) => {
    const grid = root.querySelector('[data-proof-grid]');
    const api = (root.dataset.reviewApi || '').replace(/\/$/, '');
    if (!grid || !api) return;

    const el = (name, className, value) => {
      const node = document.createElement(name);
      if (className) node.className = className;
      node.textContent = value || '';
      return node;
    };
    const initials = (name) => String(name || 'S').trim().split(/\s+/).slice(0, 2).map(part => part[0]).join('').toUpperCase();
    const stars = (value) => {
      const rating = Math.max(0, Math.min(5, Math.round(Number(value) || 0)));
      const node = el('div', 'ss-proof__stars', '★'.repeat(rating));
      // Show the empty stars too, so a 4 does not read as a 4-out-of-4.
      if (rating < 5) {
        const rest = document.createElement('i');
        rest.textContent = '★'.repeat(5 - rating);
        node.appendChild(rest);
      }
      node.setAttribute('role', 'img');
      node.setAttribute('aria-label', rating + ' out of 5 stars');
      return node;
    };

    const controller = typeof AbortController === 'function' ? new AbortController() : null;
    const timer = controller ? window.setTimeout(() => controller.abort(), 8000) : null;

    fetch(api + '/reviews/featured?limit=40', {
      headers: { 'Accept': 'application/json' },
      signal: controller ? controller.signal : undefined
    })
      .then(response => response.ok ? response.json() : Promise.reject(new Error('reviews unavailable')))
      .then(data => {
        const reviews = Array.isArray(data.reviews) ? data.reviews : [];
        if (!reviews.length) return;

        const cards = document.createDocumentFragment();
        reviews.forEach(review => {
          const body = String(review.body || '').trim();
          if (!body) return;

          const card = el('article', 'ss-proof__card');
          card.appendChild(stars(review.rating));
          card.appendChild(el('blockquote', '', '“' + body + '”'));

          const person = el('div', 'ss-proof__person');
          if (review.image_url) {
            const photo = document.createElement('img');
            photo.className = 'ss-proof__photo';
            photo.src = review.image_url;
            photo.alt = '';
            photo.loading = 'lazy';
            photo.decoding = 'async';
            photo.width = 46;
            photo.height = 46;
            photo.addEventListener('error', () => {
              photo.replaceWith(el('div', 'ss-proof__avatar', initials(review.reviewer_name)));
            }, { once: true });
            person.appendChild(photo);
          } else {
            person.appendChild(el('div', 'ss-proof__avatar', initials(review.reviewer_name)));
          }

          const byline = el('div', '');
          byline.appendChild(el('div', 'ss-proof__name', review.reviewer_name || 'Stella & Sage customer'));
          byline.appendChild(el('div', 'ss-proof__meta', review.group_name || review.store_name || 'Store experience'));
          person.appendChild(byline);
          card.appendChild(person);
          cards.appendChild(card);
        });

        if (!cards.childNodes.length) return;
        grid.replaceChildren(cards);

        // The average, from the reviews that were actually returned. Held back
        // below three: an average of one is not an average, and a big "5.0"
        // over a single card reads as a thinner claim than the card itself.
        const rated = reviews
          .map((review) => Number(review.rating))
          .filter((value) => Number.isFinite(value) && value > 0);
        const summary = root.querySelector('[data-proof-summary]');
        if (summary && rated.length >= 3) {
          const average = rated.reduce((a, b) => a + b, 0) / rated.length;
          const rounded = Math.round(average * 10) / 10;
          root.querySelector('[data-proof-avg]').textContent = rounded.toFixed(1);
          root.querySelector('[data-proof-avgstars]').textContent =
            '★'.repeat(Math.round(average)) + '☆'.repeat(5 - Math.round(average));
          root.querySelector('[data-proof-total]').textContent =
            'from ' + rated.length + ' store ' + (rated.length === 1 ? 'review' : 'reviews');
          summary.hidden = false;
          summary.setAttribute('aria-label',
            rounded.toFixed(1) + ' out of 5, from ' + rated.length + ' reviews');
        }

        root.hidden = false;
        wireCarousel(root, grid);
      })
      .catch(() => {})
      .then(() => { if (timer) window.clearTimeout(timer); });
  };

  // Arrows and a position readout. The track scrolls perfectly well without
  // any of this — that is the point of using native scroll-snap — so nothing
  // here is load-bearing, and the nav stays hidden when every review already
  // fits on screen.
  const wireCarousel = (root, track) => {
    const nav = root.querySelector('[data-proof-nav]');
    const prev = root.querySelector('[data-proof-prev]');
    const next = root.querySelector('[data-proof-next]');
    const count = root.querySelector('[data-proof-count]');
    if (!nav || !prev || !next) return;

    const total = track.children.length;
    const step = () => {
      const card = track.firstElementChild;
      if (!card) return track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap || '12') || 12;
      // Move by whole cards, and never by more than a screenful.
      const perView = Math.max(1, Math.floor(track.clientWidth / (card.offsetWidth + gap)));
      return (card.offsetWidth + gap) * perView;
    };

    const sync = () => {
      // A one-pixel tolerance: fractional scroll widths otherwise leave the
      // last arrow enabled forever on some zoom levels.
      const max = track.scrollWidth - track.clientWidth;
      const overflowing = max > 1;
      nav.hidden = !overflowing;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
      if (count && overflowing) {
        const card = track.firstElementChild;
        const gap = parseFloat(getComputedStyle(track).columnGap || '12') || 12;
        const first = Math.round(track.scrollLeft / (card.offsetWidth + gap)) + 1;
        const perView = Math.max(1, Math.round(track.clientWidth / (card.offsetWidth + gap)));
        const last = Math.min(total, first + perView - 1);
        count.textContent = (first === last ? first : first + '–' + last) + ' of ' + total;
      }
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step() }));
    next.addEventListener('click', () => track.scrollBy({ left: step() }));
    track.addEventListener('scroll', () => {
      window.clearTimeout(track._proofTick);
      track._proofTick = window.setTimeout(sync, 90);
    }, { passive: true });

    // Arrow keys move the track when it has focus, so the carousel is usable
    // without a mouse. Home/End jump to the ends.
    track.addEventListener('keydown', (event) => {
      const moves = { ArrowRight: 1, ArrowLeft: -1 };
      if (event.key in moves) {
        event.preventDefault();
        track.scrollBy({ left: step() * moves[event.key] });
      } else if (event.key === 'Home') {
        event.preventDefault();
        track.scrollTo({ left: 0 });
      } else if (event.key === 'End') {
        event.preventDefault();
        track.scrollTo({ left: track.scrollWidth });
      }
    });

    if (typeof ResizeObserver === 'function') {
      new ResizeObserver(sync).observe(track);
    } else {
      window.addEventListener('resize', sync);
    }
    sync();
  };

  const start = () => {
    const root = document.getElementById('ss-proof-' + SECTION_ID);
    if (!root || root.dataset.proofReady === '1') return;
    root.dataset.proofReady = '1';
    place(root);
    render(root);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start, { once: true });
  } else {
    start();
  }

  // The theme editor re-renders the section into its original shell.
  document.addEventListener('shopify:section:load', (event) => {
    if (event.detail && event.detail.sectionId === SECTION_ID) start();
  });
})();
</script>

{% schema %}
{
  "name": "Approved store reviews",
  "settings": [
    { "type": "text", "id": "review_api", "label": "Review service URL", "default": "https://social-engine-production-68da.up.railway.app" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "REAL GROUPS · REAL WORDS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made to make group gear easier." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "What early Stella & Sage groups have to say." }
  ],
  "presets": [{ "name": "Approved store reviews" }]
}
{% endschema %}
