{%- comment -%}
  Garment feedback is shared only by the exact product title / blank. This is
  not a review of another group's art: it is fit, comfort, print and quality
  feedback from actual Stella & Sage customers or product testers.
{%- endcomment -%}
{%- assign review_api = section.settings.review_api | default: 'https://social-engine-production-68da.up.railway.app' -%}

<section class="ss-garment-reviews" id="ss-garment-reviews-{{ section.id }}" data-review-api="{{ review_api | escape }}" data-product-title="{{ product.title | escape }}" hidden>
  <div class="ss-garment-reviews__inner">
    <div class="ss-garment-reviews__head">
      <p class="ss-garment-reviews__eyebrow">GARMENT FEEDBACK</p>
      <h2>What people say about this product.</h2>
      <div class="ss-garment-reviews__summary" data-review-summary></div>
      <p>Reviews cover comfort, fit and print quality—not another group’s design.</p>
    </div>
    <div class="ss-garment-reviews__grid" data-review-grid></div>
  </div>
</section>

<style>
  #ss-garment-reviews-{{ section.id }} { background:#faf9f5; border-top:1px solid #ece9e0; margin-top:38px; }
  #ss-garment-reviews-{{ section.id }} .ss-garment-reviews__inner { max-width:1200px; margin:0 auto; padding:58px 26px 66px; }
  #ss-garment-reviews-{{ section.id }} .ss-garment-reviews__head { max-width:680px; margin-bottom:28px; }
  #ss-garment-reviews-{{ section.id }} .ss-garment-reviews__eyebrow { margin:0 0 10px; color:#ad9150; font-size:11px; font-weight:850; letter-spacing:.14em; }
  #ss-garment-reviews-{{ section.id }} h2 { margin:0; color:#171812; font-size:clamp(28px,3.4vw,42px); letter-spacing:-.045em; line-height:1.02; }
  #ss-garment-reviews-{{ section.id }} .ss-garment-reviews__head > p:last-child { margin:12px 0 0; color:#6b6d65; font-size:14px; line-height:1.5; }
  #ss-garment-reviews-{{ section.id }} .ss-garment-reviews__summary { margin-top:13px; color:#a87c12; font-size:15px; font-weight:800; }
  #ss-garment-reviews-{{ section.id }} .ss-garment-reviews__grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(270px,1fr)); gap:14px; }
  #ss-garment-reviews-{{ section.id }} .ss-garment-reviews__card { padding:20px; background:#fff; border:1px solid #e5e2d8; border-radius:16px; }
  #ss-garment-reviews-{{ section.id }} .ss-garment-reviews__stars { color:#b5881b; letter-spacing:2px; font-size:14px; }
  #ss-garment-reviews-{{ section.id }} blockquote { margin:13px 0 17px; color:#272821; font-size:14px; line-height:1.56; }
  #ss-garment-reviews-{{ section.id }} .ss-garment-reviews__photo { display:block; width:100%; max-height:240px; object-fit:cover; border-radius:10px; margin:0 0 15px; }
  #ss-garment-reviews-{{ section.id }} .ss-garment-reviews__name { color:#292a23; font-size:13px; font-weight:800; }
  #ss-garment-reviews-{{ section.id }} .ss-garment-reviews__type { margin-top:2px; color:#787a72; font-size:12px; }
  @media(max-width:700px) { #ss-garment-reviews-{{ section.id }} .ss-garment-reviews__inner { padding:46px 18px 52px; } }
</style>

<script>
(() => {
  const root = document.getElementById('ss-garment-reviews-{{ section.id }}');
  if (!root) return;
  const title = root.dataset.productTitle || '';
  const key = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 120);
  if (!key) return;
  const grid = root.querySelector('[data-review-grid]');
  const summary = root.querySelector('[data-review-summary]');
  const api = (root.dataset.reviewApi || '').replace(/\/$/, '');
  const el = (name, className, text) => { const node = document.createElement(name); if (className) node.className = className; node.textContent = text || ''; return node; };
  fetch(api + '/reviews/products/' + encodeURIComponent(key), { headers:{'Accept':'application/json'} })
    .then(response => response.ok ? response.json() : Promise.reject(new Error('reviews unavailable')))
    .then(data => {
      const reviews = Array.isArray(data.reviews) ? data.reviews : [];
      if (!reviews.length) return;
      const count = reviews.length;
      summary.textContent = (data.average_rating || '') + ' / 5 from ' + count + ' ' + (count === 1 ? 'review' : 'reviews');
      reviews.forEach(review => {
        const card = el('article', 'ss-garment-reviews__card');
        card.appendChild(el('div', 'ss-garment-reviews__stars', '★★★★★'.slice(0, Math.max(0, Math.min(5, Number(review.rating) || 0))));
        if (review.image_url) { const image = document.createElement('img'); image.className = 'ss-garment-reviews__photo'; image.src = review.image_url; image.alt = ''; image.loading = 'lazy'; card.appendChild(image); }
        card.appendChild(el('blockquote', '', '“' + String(review.body || '').trim() + '”'));
        card.appendChild(el('div', 'ss-garment-reviews__name', review.reviewer_name || 'Stella & Sage customer'));
        card.appendChild(el('div', 'ss-garment-reviews__type', review.reviewer_type || 'Customer feedback'));
        grid.appendChild(card);
      });
      root.hidden = false;
    })
    .catch(() => {});
})();
</script>

{% schema %}
{
  "name": "Garment reviews",
  "settings": [
    { "type": "text", "id": "review_api", "label": "Review service URL", "default": "https://social-engine-production-68da.up.railway.app" }
  ],
  "presets": [{ "name": "Garment reviews" }]
}
{% endschema %}
