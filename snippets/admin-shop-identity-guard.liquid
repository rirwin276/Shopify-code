{%- comment -%}
  Admin Powers safety guard + visual polish.
  The guard refuses to leave the admin page usable if Shopify serves a render
  for a different store than the ?shop= value in the address bar.
{%- endcomment -%}
<script>
  (function () {
    var expected = '';
    try { expected = new URLSearchParams(window.location.search).get('shop') || ''; }
    catch (e) { return; }
    expected = expected.trim().toLowerCase();
    if (!expected) return;

    var served = String((window.SSAP && window.SSAP.shopHandle) || '').trim().toLowerCase();
    if (!served || served === expected) return;

    var FLAG = 'ss_admin_shop_retry';
    var already = '';
    try { already = sessionStorage.getItem(FLAG) || ''; } catch (e) {}

    if (already !== expected) {
      try { sessionStorage.setItem(FLAG, expected); } catch (e) {}
      var url = new URL(window.location.href);
      url.searchParams.set('_ssr', Date.now().toString(36));
      window.location.replace(url.toString());
      return;
    }

    try { sessionStorage.removeItem(FLAG); } catch (e) {}
    var wrap = document.querySelector('.ap-wrap');
    if (wrap) wrap.setAttribute('hidden', 'hidden');

    var notice = document.createElement('div');
    notice.setAttribute('role', 'alert');
    notice.style.cssText =
      'max-width:640px;margin:64px auto;padding:26px 28px;border-radius:18px;' +
      'border:1px solid rgba(180,35,24,.28);background:#fff6f5;color:#3d1512;' +
      'font:500 15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;';
    notice.innerHTML =
      '<div style="font-weight:800;font-size:18px;margin-bottom:8px;">This page loaded the wrong store</div>' +
      '<p style="margin:0 0 14px;">You asked for <strong>' + expected.replace(/[<>&]/g, '') +
      '</strong> but the page came back for <strong>' + served.replace(/[<>&]/g, '') +
      '</strong>, so it has been stopped.</p>' +
      '<p style="margin:0 0 18px;">Open it again from your dashboard. If this keeps happening, tell us which store.</p>' +
      '<a href="/pages/portal" style="display:inline-block;padding:11px 18px;border-radius:999px;' +
      'background:#11100e;color:#fff;text-decoration:none;font-weight:700;">← Back to dashboard</a>';
    (document.body || document.documentElement).appendChild(notice);
  })();
</script>

<script>
  (function () {
    document.documentElement.classList.add('ss-admin-command-center');
    var mq = window.matchMedia('(max-width: 700px)');

    function rememberAndSet(el, mobileText) {
      if (!el) return;
      if (!el.dataset.ssDesktopLabel) el.dataset.ssDesktopLabel = (el.textContent || '').trim();
      if (!el.getAttribute('aria-label')) el.setAttribute('aria-label', el.dataset.ssDesktopLabel || mobileText);
      var wanted = mq.matches ? mobileText : el.dataset.ssDesktopLabel;
      if ((el.textContent || '').trim() !== wanted) el.textContent = wanted;
    }

    function syncMobileHero() {
      var actions = document.querySelector('.ap-hero-actions');
      if (!actions) return;
      var links = actions.querySelectorAll('a.ap-btn');
      rememberAndSet(document.getElementById('apBtnShareStore'), 'Share');
      rememberAndSet(links.length > 0 ? links[0] : null, 'Shop');
      rememberAndSet(links.length > 1 ? links[1] : null, 'Dashboard');
      rememberAndSet(document.getElementById('apFrLaunchBtn'), 'Fundraiser');
      rememberAndSet(document.getElementById('apFrDetailsBtn'), 'Fundraiser');
    }

    function hardenHeroRoutes() {
      var actions = document.querySelector('.ap-hero-actions');
      if (!actions) return;
      var links = actions.querySelectorAll('a.ap-btn');
      if (links[0] && window.SSAP && SSAP.collectionHandle) {
        links[0].setAttribute('href', '/collections/' + encodeURIComponent(SSAP.collectionHandle));
      }
      if (links[1]) links[1].setAttribute('href', (window.SSAP && SSAP.dashboardUrl) || '/pages/portal');
    }

    function compactProductName(raw) {
      var s = String(raw || '').replace(/\s+/g, ' ').trim();
      var l = s.toLowerCase();
      if (/39165|trucker hat|snapback|\bcap\b|\bhat\b/.test(l)) return 'Trucker Hat';
      if (/full[- ]?zip/.test(l) && /hood/.test(l)) return 'Full-Zip Hoodie';
      if (/youth/.test(l) && /hood/.test(l)) return 'Youth Hoodie';
      if (/youth/.test(l) && /(tee|t-shirt|shirt)/.test(l)) return 'Youth Tee';
      if (/(women|womens|women's)/.test(l) && /(racerback|tank)/.test(l)) return "Women's Tank";
      if (/(men|mens|men's)/.test(l) && /tank/.test(l)) return "Men's Tank";
      if (/crewneck|sweatshirt|m2480/.test(l)) return 'Crewneck';
      if (/hoodie|hooded|m2580|g3719|ls14003/.test(l)) return 'Hoodie';
      if (/1717|garment[- ]?dyed/.test(l)) return 'Garment-Dyed Tee';
      if (/3413|tri[- ]?blend/.test(l)) return 'Tri-Blend Tee';
      if (/long sleeve/.test(l)) return 'Long Sleeve Tee';
      if (/racerback/.test(l)) return 'Racerback Tank';
      if (/tank|6733|1790/.test(l)) return 'Tank';
      if (/3001|tee|t-shirt|shirt/.test(l)) return 'Unisex Tee';

      var cleaned = s
        .replace(/bella\s*\+?\s*canvas/ig, '')
        .replace(/comfort colors/ig, '')
        .replace(/independent trading co\.?/ig, '')
        .replace(/cotton heritage/ig, '')
        .replace(/lane seven/ig, '')
        .replace(/next level/ig, '')
        .replace(/econscious/ig, '')
        .replace(/\b(?:bc|cc|nl|mc|ls|ec|m|g)?\d{4,5}[a-z]?\b/ig, '')
        .replace(/[|·–—-]+/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
      if (!cleaned) cleaned = s;
      return cleaned.length > 24 ? cleaned.slice(0, 22).trim() + '…' : cleaned;
    }

    function syncProductTitles() {
      document.querySelectorAll('.ap-product-title').forEach(function (el) {
        if (!el.dataset.ssFullTitle) {
          el.dataset.ssFullTitle = (el.textContent || '').trim();
          if (el.dataset.ssFullTitle) el.setAttribute('title', el.dataset.ssFullTitle);
        }
        var wanted = mq.matches ? compactProductName(el.dataset.ssFullTitle) : el.dataset.ssFullTitle;
        if ((el.textContent || '').trim() !== wanted) el.textContent = wanted;
      });
    }

    function installHeroFallbacks() {
      var share = document.getElementById('apBtnShareStore');
      var shareOverlay = document.getElementById('apShareOverlay');
      if (share && shareOverlay && !share.dataset.ssFallbackBound) {
        share.dataset.ssFallbackBound = '1';
        share.addEventListener('click', function () {
          window.setTimeout(function () {
            if (!shareOverlay.classList.contains('open')) {
              shareOverlay.classList.add('open');
              shareOverlay.setAttribute('aria-hidden', 'false');
            }
          }, 0);
        });
      }

      var fundraiser = document.getElementById('apFrLaunchBtn');
      var fundraiserOverlay = document.getElementById('apFrwOverlay');
      if (fundraiser && fundraiserOverlay && !fundraiser.dataset.ssFallbackBound) {
        fundraiser.dataset.ssFallbackBound = '1';
        fundraiser.addEventListener('click', function () {
          window.setTimeout(function () {
            if (!fundraiserOverlay.classList.contains('open')) {
              fundraiserOverlay.classList.add('open');
              fundraiserOverlay.setAttribute('aria-hidden', 'false');
              var active = fundraiserOverlay.querySelector('.ap-frw-step.ap-frw-active');
              if (!active) {
                var first = fundraiserOverlay.querySelector('.ap-frw-step');
                if (first) first.classList.add('ap-frw-active');
              }
              document.body.style.overflow = 'hidden';
            }
          }, 0);
        });
      }
    }

    function installTabFallback() {
      if (document.documentElement.dataset.ssAdminTabsFallback === '1') return;
      document.documentElement.dataset.ssAdminTabsFallback = '1';
      document.addEventListener('click', function (event) {
        var btn = event.target.closest && event.target.closest('.ap-main-tab-btn[data-main-tab]');
        if (!btn) return;
        window.setTimeout(function () {
          var targetId = btn.getAttribute('data-main-tab');
          var target = targetId && document.getElementById(targetId);
          if (!target || target.classList.contains('active')) return;
          document.querySelectorAll('.ap-main-tab-btn[data-main-tab]').forEach(function (b) {
            var on = b === btn;
            b.classList.toggle('active', on);
            b.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          document.querySelectorAll('.ap-main-panel').forEach(function (panel) {
            panel.classList.toggle('active', panel === target);
          });
        }, 0);
      });
    }

    function boot() {
      syncMobileHero();
      hardenHeroRoutes();
      syncProductTitles();
      installHeroFallbacks();
      installTabFallback();
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, { once: true });
    else boot();

    function onBreakpointChange() {
      syncMobileHero();
      syncProductTitles();
    }
    if (mq.addEventListener) mq.addEventListener('change', onBreakpointChange);
    else if (mq.addListener) mq.addListener(onBreakpointChange);

    var queued = false;
    new MutationObserver(function () {
      if (queued) return;
      queued = true;
      requestAnimationFrame(function () {
        queued = false;
        syncMobileHero();
        hardenHeroRoutes();
        syncProductTitles();
        installHeroFallbacks();
      });
    }).observe(document.documentElement, { childList: true, subtree: true });
  })();
</script>

