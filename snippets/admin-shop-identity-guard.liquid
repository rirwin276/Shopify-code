{%- doc -%}
  Refuses to show an admin page for a store the URL did not ask for.

  The symptom: /pages/admin-powers?shop=raptors-3978 rendered another store's
  control centre entirely — its name, its logo, its products, and its handle in
  the hero pill. That pill is server-rendered from shop_handle, so the page had
  genuinely been built for a different store and served against this URL. The
  page itself is self-consistent — the permission check and the content both
  come from the same shop_handle — so this is not a case of a gate being
  bypassed within one render. It is a render being reused for a request that
  did not ask for it.

  That distinction matters for what this can and cannot promise. It cannot make
  a reused render safe; only the server can stop reusing it. What it can do is
  refuse to let a wrong one stand: an admin page silently showing someone
  else's store is the worst outcome, because everything on it — products,
  members, danger-zone actions — then applies to a store the person did not
  intend to open.

  So the handle the server used is compared against the handle in the address
  bar. On a mismatch the page is reloaded once with a cache-busting parameter;
  if the second attempt still disagrees, it stops and says so instead of
  rendering. One retry, tracked in sessionStorage, so a persistent mismatch
  cannot become a reload loop.
{%- enddoc -%}
<script>
  (function () {
    var expected = '';
    try {
      expected = new URLSearchParams(window.location.search).get('shop') || '';
    } catch (e) {
      return;   // cannot read the URL: nothing to compare against
    }
    expected = expected.trim().toLowerCase();
    if (!expected) return;   // no shop asked for; the page decides on its own

    var served = String((window.SSAP && window.SSAP.shopHandle) || '').trim().toLowerCase();
    if (!served || served === expected) return;   // agreed: nothing to do

    var FLAG = 'ss_admin_shop_retry';
    var already = '';
    try { already = sessionStorage.getItem(FLAG) || ''; } catch (e) {}

    if (already !== expected) {
      // First disagreement: force a fresh render rather than accusing the
      // page of anything. A cache-busting parameter is the only lever
      // available from here — Liquid cannot set a response header.
      try { sessionStorage.setItem(FLAG, expected); } catch (e) {}
      var url = new URL(window.location.href);
      url.searchParams.set('_ssr', Date.now().toString(36));
      window.location.replace(url.toString());
      return;
    }

    // Second disagreement for the same store: the reload did not help, so stop
    // rather than let someone act on another store's control centre.
    try { sessionStorage.removeItem(FLAG); } catch (e) {}

    var wrap = document.querySelector('.ap-wrap');
    if (wrap) wrap.setAttribute('hidden', 'hidden');

    var notice = document.createElement('div');
    notice.setAttribute('role', 'alert');
    notice.style.cssText =
      'max-width:640px;margin:64px auto;padding:26px 28px;border-radius:18px;' +
      'border:1px solid rgba(180,35,24,.28);background:#fff6f5;color:#3d1512;' +
      'font:500 15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;';
    notice.innerHTML =
      '<div style="font-weight:800;font-size:18px;margin-bottom:8px;">This page loaded the wrong store</div>' +
      '<p style="margin:0 0 14px;">You asked for <strong>' + expected.replace(/[<>&]/g, '') +
      '</strong> but the page came back for <strong>' + served.replace(/[<>&]/g, '') +
      '</strong>, so it has been stopped. Nothing here would have applied to the store you wanted.</p>' +
      '<p style="margin:0 0 18px;">Open it again from your dashboard. If this keeps happening, tell us which store — it means a page is being cached and served to the wrong request.</p>' +
      '<a href="/pages/portal" style="display:inline-block;padding:11px 18px;border-radius:999px;' +
      'background:#11100e;color:#fff;text-decoration:none;font-weight:700;">← Back to dashboard</a>';

    (document.body || document.documentElement).appendChild(notice);
  })();
</script>

{%- comment -%}
  ADMIN COMMAND CENTER POLISH
  This snippet is rendered only by Admin Powers, which makes it a safe place
  for the visual/interaction layer without touching the shared storefront.
{%- endcomment -%}
<script>
  (function () {
    document.documentElement.classList.add('ss-admin-command-center');

    var mq = window.matchMedia('(max-width: 700px)');

    function rememberAndSet(el, mobileText) {
      if (!el) return;
      if (!el.dataset.ssDesktopLabel) {
        el.dataset.ssDesktopLabel = (el.textContent || '').trim();
      }
      if (!el.getAttribute('aria-label')) {
        el.setAttribute('aria-label', el.dataset.ssDesktopLabel || mobileText);
      }
      el.textContent = mq.matches ? mobileText : el.dataset.ssDesktopLabel;
    }

    function syncMobileHero() {
      var actions = document.querySelector('.ap-hero-actions');
      if (!actions) return;

      var share = document.getElementById('apBtnShareStore');
      var launch = document.getElementById('apFrLaunchBtn');
      var details = document.getElementById('apFrDetailsBtn');
      var actionLinks = actions.querySelectorAll('a.ap-btn');
      var shopLink = actionLinks.length > 0 ? actionLinks[0] : null;
      var dashLink = actionLinks.length > 1 ? actionLinks[1] : null;

      rememberAndSet(share, 'Share');
      rememberAndSet(shopLink, 'Shop Store');
      rememberAndSet(dashLink, 'Dashboard');
      rememberAndSet(launch, 'Fundraiser');
      rememberAndSet(details, 'Fundraiser');
    }

    function hardenHeroRoutes() {
      var actions = document.querySelector('.ap-hero-actions');
      if (!actions) return;
      var links = actions.querySelectorAll('a.ap-btn');
      if (links[0] && window.SSAP && SSAP.collectionHandle) {
        links[0].setAttribute('href', '/collections/' + encodeURIComponent(SSAP.collectionHandle));
      }
      if (links[1]) {
        links[1].setAttribute('href', (window.SSAP && SSAP.dashboardUrl) || '/pages/portal');
      }
    }

    // Defensive fallbacks: the regular admin assets still own these actions.
    // These only step in if a handler failed to attach, so a cached/late asset
    // cannot leave the four hero controls looking live but doing nothing.
    function installHeroFallbacks() {
      var share = document.getElementById('apBtnShareStore');
      var shareOverlay = document.getElementById('apShareOverlay');
      if (share && shareOverlay && !share.dataset.ssFallbackBound) {
        share.dataset.ssFallbackBound = '1';
        share.addEventListener('click', function () {
          window.setTimeout(function () {
            if (!shareOverlay.classList.contains('open')) {
              shareOverlay.classList.add('open');
              shareOverlay.setAttribute('aria-hidden', 'false');
            }
          }, 0);
        });
      }

      var fundraiser = document.getElementById('apFrLaunchBtn');
      var fundraiserOverlay = document.getElementById('apFrwOverlay');
      if (fundraiser && fundraiserOverlay && !fundraiser.dataset.ssFallbackBound) {
        fundraiser.dataset.ssFallbackBound = '1';
        fundraiser.addEventListener('click', function () {
          window.setTimeout(function () {
            if (!fundraiserOverlay.classList.contains('open')) {
              fundraiserOverlay.classList.add('open');
              fundraiserOverlay.setAttribute('aria-hidden', 'false');
              document.body.style.overflow = 'hidden';
            }
          }, 0);
        });
      }
    }

    // Same idea for the main Admin Powers tabs: core JS remains authoritative,
    // but this keeps navigation usable if a cached asset misses its listener.
    function installTabFallback() {
      if (document.documentElement.dataset.ssAdminTabsFallback === '1') return;
      document.documentElement.dataset.ssAdminTabsFallback = '1';
      document.addEventListener('click', function (event) {
        var btn = event.target.closest && event.target.closest('.ap-main-tab-btn[data-main-tab]');
        if (!btn) return;
        window.setTimeout(function () {
          var targetId = btn.getAttribute('data-main-tab');
          var target = targetId && document.getElementById(targetId);
          if (!target || target.classList.contains('active')) return;
          document.querySelectorAll('.ap-main-tab-btn[data-main-tab]').forEach(function (b) {
            var on = b === btn;
            b.classList.toggle('active', on);
            b.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          document.querySelectorAll('.ap-main-panel').forEach(function (panel) {
            panel.classList.toggle('active', panel === target);
          });
        }, 0);
      });
    }

    function boot() {
      syncMobileHero();
      hardenHeroRoutes();
      installHeroFallbacks();
      installTabFallback();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    } else {
      boot();
    }

    if (mq.addEventListener) mq.addEventListener('change', syncMobileHero);
    else if (mq.addListener) mq.addListener(syncMobileHero);

    // Fundraiser state and product rows are filled asynchronously. Re-run the
    // tiny label/layout sync when those nodes change without rebuilding them.
    var queued = false;
    new MutationObserver(function () {
      if (queued) return;
      queued = true;
      requestAnimationFrame(function () {
        queued = false;
        syncMobileHero();
        hardenHeroRoutes();
        installHeroFallbacks();
      });
    }).observe(document.documentElement, { childList: true, subtree: true });
  })();
</script>

