{%- doc -%}
  Picks a frame background that the store's logo can actually be seen against.

  Store logos are uploaded by customers and we do not get to choose them. A
  mostly-white mark — a drilling company wordmark, a fire department crest, a
  school shield — vanishes completely against a white frame, and the card reads
  as broken or empty.

  Liquid cannot inspect an image, so the measurement happens in the browser:
  the logo is drawn to a tiny canvas and its visible pixels averaged. Light
  logos get a dark frame; dark and colourful ones keep white.

  MEASURING A COPY, NOT THE ON-PAGE IMAGE
  ---------------------------------------
  The page's <img> is loaded without a crossorigin attribute, which taints any
  canvas it is drawn to — getImageData then throws and every logo silently
  measures as "unknown". That is why the first version of this changed nothing
  on real cards. So a second Image is loaded with crossOrigin='anonymous' and
  measured instead. Shopify's CDN serves the header this needs; a host that
  does not simply leaves the frame at its default.

  Only pixels with real opacity are counted. Background-removed logos are
  mostly transparent, and averaging the empty space would make every one of
  them look light regardless of the mark itself.

  Runs on any surface that shows a store logo — the dashboard, the join card,
  the storefront hero, the admin portal — by matching a broad set of frames.
{%- enddoc -%}
<script>
  (function () {
    if (window.__ssLogoContrast) return;   // one instance per page
    window.__ssLogoContrast = true;

    // Above this mean luminance (0-255) a logo is "light" and needs a dark
    // frame. Set well above mid-grey on purpose: the failure being prevented
    // is a near-white mark disappearing, and darkening a merely pale logo
    // costs more than it gains.
    var LIGHT_THRESHOLD = 186;
    var SAMPLE = 24;
    var MIN_INK = 12;

    // Every place a store logo is framed. A logo that is invisible on the
    // dashboard is just as invisible on the join card and the store hero, so
    // one rule covers all of them.
    var SELECTORS = [
      '.ss-logo-frame img',        // seller dashboard cards
      '.sf-logo-area img',         // join-store invite card
      '.ps-logo img',              // private storefront hero
      '.ap-hero-logo img',         // admin powers header
      '#ssOnboardingLogoShell img' // new-store tutorial
    ].join(',');

    var FRAME_SELECTOR =
      '.ss-logo-frame, .sf-logo-area, .ps-logo, .ap-hero-logo, #ssOnboardingLogoShell';

    // A 64px copy is plenty to average colour from, and it is the difference
    // between a second full-size download per logo and a negligible one.
    //
    // A CORS probe cannot reuse the browser's cached copy of the on-page image
    // — CORS and non-CORS responses are cached separately — so every logo was
    // being fetched twice, at whatever width the card displayed. On a
    // dashboard with many stores that is what made loading stutter.
    function thumbOf(src) {
      try {
        var url = new URL(src, window.location.origin);
        if (url.hostname.indexOf('cdn.shopify.com') === -1) return src;
        url.searchParams.set('width', '64');
        return url.toString();
      } catch (e) {
        return src;
      }
    }

    function luminanceOf(sample) {
      var canvas = document.createElement('canvas');
      canvas.width = SAMPLE;
      canvas.height = SAMPLE;
      var ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) return null;
      try {
        ctx.drawImage(sample, 0, 0, SAMPLE, SAMPLE);
        var data = ctx.getImageData(0, 0, SAMPLE, SAMPLE).data;
        var sum = 0, counted = 0;
        for (var i = 0; i < data.length; i += 4) {
          if (data[i + 3] < 40) continue;   // transparent padding is not the logo
          // Rec. 601 luma — how bright a colour looks, which is the question
          // being asked, rather than a flat channel average.
          sum += 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
          counted++;
        }
        if (counted < MIN_INK) return null;  // too little ink to judge
        return sum / counted;
      } catch (e) {
        return null;   // tainted canvas — leave the frame alone
      }
    }

    function setDark(frame) {
      frame.classList.add('ss-logo-frame--dark');
      // Also written inline with !important, which outranks every stylesheet
      // rule regardless of source order or selector weight.
      //
      // The class alone was not enough on the dashboard, and only there: it is
      // outgunned by ".ss-portal .ss-logo-frame { background: ... !important }"
      // on specificity, and tied-but-later-declared by a second
      // ".ss-logo-frame { background: ... !important }" further down the same
      // section. Both are dashboard-only, which is exactly why the storefront
      // hero and admin portal picked the dark frame up and the store cards did
      // not. Escalating specificity here would just be the next move in an
      // arms race with stylesheets this snippet does not own.
      frame.dataset.ssContrastApplied = '1';
      frame.style.setProperty('background', '#2f3542', 'important');
      frame.style.setProperty('border-color', 'rgba(255,255,255,0.14)', 'important');
    }

    function apply(img) {
      if (!img) return;
      var src = img.currentSrc || img.getAttribute('src') || '';
      if (!src) return;

      var frame = img.closest(FRAME_SELECTOR);
      if (!frame) return;
      // An inline background is a deliberate choice by whoever wrote the
      // markup (the onboarding sample tiles set their own); do not override
      // it. Our own inline style does not count — see setDark.
      var inline = frame.getAttribute('style') || '';
      if (/background/.test(inline) && frame.dataset.ssContrastApplied !== '1') return;

      // Measured once per resolved source. Re-measuring on every load event
      // meant a fresh full-size download each time an image settled.
      if (img.dataset.ssContrastSrc === src) return;
      img.dataset.ssContrastSrc = src;

      var probe = new Image();
      probe.crossOrigin = 'anonymous';
      probe.onload = function () {
        var luma = luminanceOf(probe);
        if (luma !== null && luma > LIGHT_THRESHOLD) setDark(frame);
      };
      probe.onerror = function () { /* no CORS copy available; keep default */ };
      probe.src = thumbOf(src);
    }

    function watch(img) {
      if (img.complete && img.naturalWidth) apply(img);
      else img.addEventListener('load', function () { apply(img); }, { once: true });
    }

    function sweep(root) {
      var imgs = (root || document).querySelectorAll(SELECTORS);
      for (var i = 0; i < imgs.length; i++) watch(imgs[i]);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { sweep(); }, { once: true });
    } else {
      sweep();
    }

    // Cards are lazy-rendered, the tutorial swaps its own image, and stores
    // wake and sleep. The observer only reads images and toggles a class — it
    // never inserts or removes nodes, and it does not watch attributes, so it
    // cannot retrigger itself.
    if (window.MutationObserver) {
      // Batched onto one animation frame. Sweeping synchronously inside the
      // callback meant a full-document querySelectorAll per mutation, and the
      // dashboard mutates constantly while product counts and fundraiser
      // strips land — dozens of scans competing with the scroll.
      var sweepQueued = false;
      new MutationObserver(function (records) {
        if (sweepQueued) return;
        for (var i = 0; i < records.length; i++) {
          if (records[i].addedNodes.length) {
            sweepQueued = true;
            requestAnimationFrame(function () { sweepQueued = false; sweep(); });
            return;
          }
        }
      }).observe(document.documentElement, { childList: true, subtree: true });
    }

    // The tutorial replaces its logo's src after the element already exists,
    // so a one-shot measurement per element would miss the real image.
    document.addEventListener('load', function (e) {
      var el = e.target;
      if (el && el.tagName === 'IMG' && el.matches && el.matches(SELECTORS)) {
        apply(el);   // apply() no-ops unless the source actually changed
      }
    }, true);
  })();
</script>
<style>
  .ss-logo-frame--dark {
    background: #2f3542 !important;
    border-color: rgba(255, 255, 255, 0.14) !important;
  }
  /* The join card and storefront hero frames have no background of their own,
     so they need one before the dark treatment reads as deliberate. */
  .sf-logo-area.ss-logo-frame--dark,
  .ps-logo.ss-logo-frame--dark,
  .ap-hero-logo.ss-logo-frame--dark,
  #ssOnboardingLogoShell.ss-logo-frame--dark {
    background: #2f3542 !important;
    border-radius: 16px;
    padding: 8px;
  }
</style>
