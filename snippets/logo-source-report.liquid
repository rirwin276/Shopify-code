{%- comment -%}
  Dashboard image safeguards.

  1. Remove responsive candidates from the small dashboard logos so every
     card uses the exact URL emitted in its own src attribute.
  2. Bind the new-store onboarding modal to the exact handle that was just
     submitted. Never borrow a logo from a neighbouring card.
  3. If the customer tag has not propagated yet, briefly poll the rendered
     portal until that exact store card exists, then place its logo in the
     tutorial.

  A compact read-only source report remains available at:
    /pages/portal?logodebug=1
{%- endcomment -%}

<script>
  (function () {
    var CONTEXT_KEY = 'ss_new_store_context';
    var CONTEXT_TTL = 30 * 60 * 1000;
    var params = new URLSearchParams(window.location.search || '');
    var isNewStoreVisit = params.get('new_store') === '1' || !!params.get('store_handle');

    function readStoredContext() {
      var raw = '';
      try { raw = sessionStorage.getItem(CONTEXT_KEY) || ''; } catch (e) {}
      if (!raw) {
        try { raw = localStorage.getItem(CONTEXT_KEY) || ''; } catch (e) {}
      }
      if (!raw) return null;

      try {
        var parsed = JSON.parse(raw);
        var savedAt = Number(parsed.savedAt || 0);
        if (!parsed.handle || !savedAt || Date.now() - savedAt > CONTEXT_TTL) {
          clearStoredContext();
          return null;
        }
        return parsed;
      } catch (e) {
        clearStoredContext();
        return null;
      }
    }

    function clearStoredContext() {
      try { sessionStorage.removeItem(CONTEXT_KEY); } catch (e) {}
      try { localStorage.removeItem(CONTEXT_KEY); } catch (e) {}
    }

    function cardsFor(root) {
      return Array.prototype.slice.call(
        (root || document).querySelectorAll('.ss-store-card[data-ss-handle]')
      );
    }

    function cardForHandle(root, handle) {
      if (!handle) return null;
      var cards = cardsFor(root);
      for (var i = 0; i < cards.length; i++) {
        if ((cards[i].getAttribute('data-ss-handle') || '').trim() === handle) {
          return cards[i];
        }
      }
      return null;
    }

    var context = readStoredContext();
    var exactHandle = (params.get('store_handle') || (context && context.handle) || '').trim();

    // Older provisioning redirects sometimes returned only ?new_store=1. If
    // there is exactly one admin-owned card currently building, it is safe to
    // identify it; with zero or multiple candidates we deliberately do not
    // guess.
    if (!exactHandle && params.get('new_store') === '1') {
      var building = Array.prototype.slice.call(
        document.querySelectorAll('.ss-store-card[data-ss-building="1"][data-ss-onboarding-admin="1"]')
      );
      if (building.length === 1) {
        exactHandle = (building[0].getAttribute('data-ss-handle') || '').trim();
      }
    }

    // The main onboarding script runs later in seller-dashboard.liquid and
    // reads the URL. Restore the missing handle before it executes, so its own
    // exact-card lookup cannot fall back to a different store.
    if (isNewStoreVisit && exactHandle && !params.get('store_handle')) {
      params.set('store_handle', exactHandle);
      try {
        window.history.replaceState(
          {},
          document.title,
          window.location.pathname + '?' + params.toString() + window.location.hash
        );
      } catch (e) {}
    }

    // Hide the tutorial image until the exact card has been verified. This
    // prevents even a brief flash of a neighbouring store's logo.
    var guardStyle = null;
    if (isNewStoreVisit) {
      guardStyle = document.createElement('style');
      guardStyle.id = 'ss-onboarding-exact-logo-guard';
      guardStyle.textContent =
        '#ssNewStoreOnboarding #ssOnboardingLogoImg{visibility:hidden!important;}';
      (document.head || document.documentElement).appendChild(guardStyle);
    }

    function forceSingleLogoSource(root) {
      var images = (root || document).querySelectorAll('.ss-logo-frame[data-ss-logo-for] img');
      for (var i = 0; i < images.length; i++) {
        images[i].removeAttribute('srcset');
        images[i].removeAttribute('sizes');
      }
    }

    // This snippet is rendered immediately after the dashboard cards.
    forceSingleLogoSource(document);

    function initials(name, handle) {
      var source = String(name || handle || 'S S')
        .replace(/-\d{4}\s*$/i, '')
        .replace(/-/g, ' ')
        .trim();
      var words = source.split(/\s+/).filter(Boolean).slice(0, 2);
      var out = words.map(function (word) { return word.charAt(0); }).join('').toUpperCase();
      return out || 'S&S';
    }

    function freshUrl(url) {
      if (!url) return '';
      return url + (url.indexOf('?') === -1 ? '?' : '&') + 'ssv=' + Date.now();
    }

    function modalParts() {
      return {
        modal: document.getElementById('ssNewStoreOnboarding'),
        shell: document.getElementById('ssOnboardingLogoShell'),
        image: document.getElementById('ssOnboardingLogoImg'),
        fallback: document.getElementById('ssOnboardingLogoFallback')
      };
    }

    function revealVerifiedImage() {
      if (guardStyle && guardStyle.parentNode) guardStyle.parentNode.removeChild(guardStyle);
      guardStyle = null;
      var image = document.getElementById('ssOnboardingLogoImg');
      if (image) image.style.visibility = 'visible';
    }

    function showSafeFallback(name) {
      var parts = modalParts();
      if (!parts.shell || !parts.image) return;
      parts.image.removeAttribute('src');
      parts.image.removeAttribute('srcset');
      parts.image.removeAttribute('sizes');
      parts.shell.classList.remove('has-img');
      if (parts.fallback) parts.fallback.textContent = initials(name, exactHandle);
      revealVerifiedImage();
    }

    function applyExactCard(card) {
      if (!card) return false;

      var title = card.querySelector('.ss-card-title');
      var name = title ? (title.textContent || '').trim() : ((context && context.name) || exactHandle);
      var cardImage = card.querySelector('.ss-logo-frame img');
      var url = (card.getAttribute('data-ss-onboarding-image') || '').trim();
      if (!url && cardImage) url = (cardImage.getAttribute('src') || '').trim();

      if (!url) {
        showSafeFallback(name);
        return false;
      }

      var parts = modalParts();
      if (!parts.shell || !parts.image) return false;

      parts.image.removeAttribute('srcset');
      parts.image.removeAttribute('sizes');
      parts.image.src = freshUrl(url);
      parts.shell.classList.add('has-img');
      if (parts.fallback) parts.fallback.textContent = initials(name, exactHandle);
      revealVerifiedImage();
      clearStoredContext();
      return true;
    }

    function probeForExactCard(attempt) {
      if (!exactHandle || attempt > 24) return;

      var current = cardForHandle(document, exactHandle);
      if (current && applyExactCard(current)) return;

      fetch('/pages/portal?ss_onboarding_probe=1&ts=' + Date.now(), {
        credentials: 'same-origin',
        cache: 'no-store',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      })
        .then(function (response) {
          if (!response.ok) throw new Error('Portal probe failed: ' + response.status);
          return response.text();
        })
        .then(function (html) {
          var parsed = new DOMParser().parseFromString(html, 'text/html');
          var exact = cardForHandle(parsed, exactHandle);
          if (exact && applyExactCard(exact)) return;
          window.setTimeout(function () { probeForExactCard(attempt + 1); }, 1500);
        })
        .catch(function () {
          window.setTimeout(function () { probeForExactCard(attempt + 1); }, 2000);
        });
    }

    function startExactOnboardingLogo() {
      forceSingleLogoSource(document);
      if (!isNewStoreVisit) return;

      if (!exactHandle) {
        // No exact identity is available. A neutral fallback is intentionally
        // better than confidently displaying another customer's/store's logo.
        showSafeFallback(context && context.name);
        return;
      }

      var exact = cardForHandle(document, exactHandle);
      if (exact && applyExactCard(exact)) return;

      // The customer tag can take a few seconds to appear after provisioning.
      showSafeFallback((context && context.name) || exactHandle);
      probeForExactCard(0);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startExactOnboardingLogo, { once: true });
    } else {
      startExactOnboardingLogo();
    }

    // Compact read-only diagnostic retained for future source-selection bugs.
    if (window.location.search.indexOf('logodebug=1') !== -1) {
      function sourceReport() {
        var frames = document.querySelectorAll('.ss-logo-frame[data-ss-logo-for]');
        // `why` is the server's own account of what it found for this card:
        // file / clean if it drew a logo, shared if a clean URL was dropped
        // because another store had the same one, missing if the metaobject
        // offered nothing. Read down the list: 'missing' starting abruptly at
        // a position is a per-request budget running out, while 'shared' and
        // 'missing' scattered by store is a provisioning problem. Those two
        // want opposite fixes, and nothing else on the page distinguishes them.
        var lines = ['# | handle | why | src | currentSrc | flags'];
        var summary = {};
        for (var i = 0; i < frames.length; i++) {
          var img = frames[i].querySelector('img');
          var src = img ? (img.getAttribute('src') || '') : '';
          var live = img ? (img.currentSrc || '') : '';
          var why = frames[i].getAttribute('data-ss-logo-why') || '?';
          summary[why] = (summary[why] || 0) + 1;
          var flags = [];
          if (img && img.getAttribute('srcset')) flags.push('HAS SRCSET');
          if (src && live && src !== live) flags.push('MISMATCH');
          lines.push(
            (i + 1) + ' | ' +
            (frames[i].getAttribute('data-ss-logo-for') || '') + ' | ' +
            why + ' | ' +
            src + ' | ' + live + ' | ' + flags.join(' ')
          );
        }
        var counts = Object.keys(summary).map(function (k) { return k + '=' + summary[k]; });
        lines.push('');
        lines.push('totals: ' + counts.join(' ') + ' of ' + frames.length + ' cards');

        // Where the first card without a logo is. A clean break part way down
        // is the signature of a budget; a scatter is the signature of data.
        var firstBad = -1;
        for (var j = 0; j < frames.length; j++) {
          var w = frames[j].getAttribute('data-ss-logo-why');
          if (w === 'missing' || w === 'shared') { firstBad = j + 1; break; }
        }
        lines.push('first card without a logo: ' + (firstBad === -1 ? 'none' : '#' + firstBad));
        return lines.join('\n');
      }

      function makePanel() {
        var box = document.createElement('div');
        box.style.cssText =
          'position:fixed;left:8px;right:8px;bottom:8px;max-height:52vh;z-index:2147483647;' +
          'background:#11100e;color:#e8e8e8;font:11px/1.5 ui-monospace,Menlo,Consolas,monospace;' +
          'border-radius:10px;padding:10px;overflow:auto;box-shadow:0 8px 30px rgba(0,0,0,.5)';

        var bar = document.createElement('div');
        bar.style.cssText = 'display:flex;gap:8px;margin-bottom:8px;position:sticky;top:0;background:#11100e;padding-bottom:6px';
        var pre = document.createElement('pre');
        pre.style.cssText = 'margin:0;white-space:pre-wrap;word-break:break-all';

        function button(label, action) {
          var btn = document.createElement('button');
          btn.textContent = label;
          btn.style.cssText = 'font:600 11px/1 system-ui;padding:7px 10px;border-radius:6px;border:0;background:#3b82f6;color:#fff;cursor:pointer';
          btn.addEventListener('click', action);
          return btn;
        }

        function refresh() { pre.textContent = sourceReport(); }
        bar.appendChild(button('Refresh', refresh));
        bar.appendChild(button('Copy', function () {
          if (navigator.clipboard) navigator.clipboard.writeText(pre.textContent);
        }));
        bar.appendChild(button('Close', function () { box.remove(); }));
        box.appendChild(bar);
        box.appendChild(pre);
        document.body.appendChild(box);
        refresh();
        window.setTimeout(refresh, 1500);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', makePanel, { once: true });
      } else {
        makePanel();
      }
    }
  })();
</script>
