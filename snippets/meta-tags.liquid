<script>
  /*
   * Legacy storefront-form routing used localStorage flags to redirect the
   * dashboard, blog posts, policies, and other unrelated pages. Navigation is
   * explicit now, so permanently ignore those legacy keys until the remaining
   * old theme code is removed.
   */
  (function () {
    var blockedKeys = {
      sf_pending_form_v1: true,
      sf_pending_form_v2: true,
      sf_pending_signin_v1: true
    };

    try {
      var originalGetItem = Storage.prototype.getItem;
      var originalSetItem = Storage.prototype.setItem;
      var originalRemoveItem = Storage.prototype.removeItem;

      Object.keys(blockedKeys).forEach(function (key) {
        originalRemoveItem.call(localStorage, key);
      });

      Storage.prototype.getItem = function (key) {
        if (blockedKeys[String(key)]) return null;
        return originalGetItem.call(this, key);
      };

      Storage.prototype.setItem = function (key, value) {
        if (blockedKeys[String(key)]) return;
        return originalSetItem.call(this, key, value);
      };

      window.SS_LEGACY_FORM_ROUTING_DISABLED = true;
    } catch (e) {}
  })();
</script>

{%- unless primary_metadata_in_layout -%}
<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
{%- endunless -%}
<meta
  name="view-transition"
  content="same-origin"
>
{%- unless primary_metadata_in_layout -%}
<meta
  name="theme-color"
  content=""
>
{%- endunless -%}

{%- liquid
  assign og_title = seo_title | default: page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: page_description | default: shop.description | default: shop.name
  if store_preview_image != blank and store_preview_entry != blank
    assign og_title = store_preview_entry.name | append: ' | Private Studio'
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- liquid
  assign ss_social_image = store_preview_image | default: page_image
  if ss_social_image != blank
    assign ss_social_image_url = ss_social_image | image_url: width: 1200
    assign ss_social_image_prefix = ss_social_image_url | slice: 0, 2
    if ss_social_image_prefix == '//'
      assign ss_social_image_url = ss_social_image_url | prepend: 'https:'
    endif
    assign ss_social_image_url = ss_social_image_url | replace: 'http:', 'https:'
  endif
-%}
{%- if ss_social_image != blank -%}
  <meta property="og:image" content="{{ ss_social_image_url | escape }}">
  <meta property="og:image:secure_url" content="{{ ss_social_image_url | escape }}">
  <meta name="twitter:image" content="{{ ss_social_image_url | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

{%- unless primary_metadata_in_layout -%}
<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if page_description %}
  <meta
    name="description"
    content="{{ page_description | escape }}"
  >
{% endif %}
{%- endunless -%}
