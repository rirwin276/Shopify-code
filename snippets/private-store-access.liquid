{%- doc -%}
  Echoes this visitor's access level for one private store, or nothing.

  Values: "admin", "member", "preview", or empty.

  MEMBER / ADMIN
  --------------
  Signed-in customers keep the existing tag-based access rules. Super admins
  are treated as admins everywhere.

  PREVIEW
  -------
  Preview is intentionally much narrower than member access. It exists only
  for prospect stores that were provisioned with owner_customer_id="unclaimed".
  Those are the stores Stella & Sage built for someone before that person has
  claimed ownership.

  Once a real owner exists, ?preview=... can never open the store. This matters
  because normal team members should not be able to browse all the way into a
  product and only then discover they cannot purchase. They must join the
  private store first.

  For an unclaimed store, join_code remains the preferred preview token. Older
  unclaimed builds without a join_code may still use any nonblank preview value
  (the join page uses ?preview=1). Explicitly requiring the "unclaimed" owner
  sentinel prevents a malformed or already-owned store from becoming previewable
  just because it lacks a join_code.

  @param {string} handle - The store handle (collection handle).

  @example
  {%- capture ps_access -%}{%- render 'private-store-access', handle: handle -%}{%- endcapture -%}
  {%- assign ps_access = ps_access | strip -%}
{%- enddoc -%}
{%- liquid
  assign ps_handle = handle | downcase | strip
  assign ps_level = ''

  if customer and ps_handle != blank
    assign ps_member_tag = 'storefront-member--' | append: ps_handle
    assign ps_admin_tag = 'storefront-admin--' | append: ps_handle
    assign ps_legacy_member_tag = 'b2b-' | append: ps_handle
    assign ps_legacy_admin_tag = 'b2b-admin-' | append: ps_handle
    for tag in customer.tags
      assign t = tag | downcase | strip
      if t == 'super-admin' or t == ps_admin_tag or t == ps_legacy_admin_tag
        assign ps_level = 'admin'
        break
      endif
      if t == ps_member_tag or t == ps_legacy_member_tag
        assign ps_level = 'member'
      endif
    endfor
  endif

  if ps_level == blank and ps_handle != blank
    assign ps_supplied = ''
    assign ps_page_url = content_for_header | split: '"pageurl":"' | last | split: '"' | first
    assign ps_page_url = ps_page_url | replace: '\u0026', '&'

    if ps_page_url contains '?'
      assign ps_pairs = ps_page_url | split: '?' | last | split: '&'
      for ps_pair in ps_pairs
        assign ps_kv = ps_pair | split: '='
        if ps_kv[0] == 'preview'
          assign ps_supplied = ps_kv[1] | default: '' | strip
        endif
      endfor
    endif

    if ps_supplied != blank
      assign ps_entry = shop.metaobjects.custom_shop[ps_handle]
      if ps_entry
        assign ps_owner = ps_entry.owner_customer_id.value | default: ps_entry.owner_customer_id | default: '' | strip | downcase

        # Critical rule: only explicitly-unclaimed prospect stores may preview.
        if ps_owner == 'unclaimed'
          assign ps_code = ps_entry.join_code.value | default: ps_entry.join_code | default: '' | strip
          if ps_code != blank
            if ps_supplied == ps_code
              assign ps_level = 'preview'
            endif
          else
            assign ps_level = 'preview'
          endif
        endif
      endif
    endif
  endif

  echo ps_level
-%}
