{%- doc -%}
  Keeps a preview session alive as the visitor moves around the store.

  A preview is unlocked by ?preview=<token> on the URL, so any link that drops
  the token lands the visitor on "Sign in to access your private store". A
  prospect who has just watched their own name render on the back of a jersey
  reads that as the platform being broken.

  Rewriting happens in two passes, because one is not enough:

  1. On load, every in-store link on the page is rewritten immediately. This
     matters because the theme does its own things with hrefs — the
     back-to-storefront button is filled in by an inline script, product cards
     carry view-transition wiring, and anything that reads an href before a
     click would otherwise read the tokenless one.

  2. A click handler in the capture phase catches links added after load
     (recommendations, quick views, anything lazily rendered).

  Neither pass is a guarantee on its own, which is why the no-access screens
  also carry private-store-preview-resume as the final backstop.

  @param {string} handle - The store handle this preview belongs to.
{%- enddoc -%}
<script>
  (function () {
    var token = new URLSearchParams(window.location.search).get('preview');
    if (!token) return;

    // Remembered so a navigation that loses the token can be recovered — see
    // private-store-preview-resume.
    //
    // Keyed by store. A single shared key would mean previewing one store
    // hands out a token that the resume path then replays at every other
    // store, quietly unlocking stores nobody sent this person a link to.
    try {
      sessionStorage.setItem('ss_preview_token__{{ handle }}', token);
    } catch (e) {}

    function withToken(a) {
      if (!a || !a.getAttribute) return;
      var raw = a.getAttribute('href');
      if (!raw) return;

      var url;
      try { url = new URL(raw, window.location.origin); } catch (err) { return; }

      if (url.origin !== window.location.origin) return;
      // Only store pages. Account, cart and marketing links are meant to leave
      // the preview, and tagging them would be noise on a URL a prospect may
      // well copy and send to someone else.
      if (!/^\/(products|collections)\//.test(url.pathname)) return;
      if (url.searchParams.get('preview')) return;

      url.searchParams.set('preview', token);
      a.setAttribute('href', url.toString());
    }

    function sweep(root) {
      var links = (root || document).querySelectorAll('a[href]');
      for (var i = 0; i < links.length; i++) withToken(links[i]);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { sweep(); }, { once: true });
    } else {
      sweep();
    }

    // Backstop for links that appear later. Capture phase, so it still wins
    // against handlers that read the href on the way up.
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href]');
      if (a) withToken(a);
    }, true);

    // A middle-click or ctrl-click opens a new tab without firing 'click'.
    document.addEventListener('auxclick', function (e) {
      var a = e.target.closest && e.target.closest('a[href]');
      if (a) withToken(a);
    }, true);

    // Shopify sections re-render on variant and filter changes, replacing
    // whole blocks of markup and every link inside them.
    //
    // The observer only reads and rewrites hrefs — it never adds or removes
    // nodes — so it cannot retrigger itself. Attribute changes are not
    // watched, for the same reason: rewriting an href would be an attribute
    // change, and watching those is how an observer feeds itself into a loop
    // that starves the main thread.
    if (window.MutationObserver) {
      var observer = new MutationObserver(function (records) {
        for (var i = 0; i < records.length; i++) {
          var added = records[i].addedNodes;
          for (var j = 0; j < added.length; j++) {
            var node = added[j];
            if (node.nodeType !== 1) continue;
            if (node.tagName === 'A') withToken(node);
            else if (node.querySelectorAll) sweep(node);
          }
        }
      });
      observer.observe(document.documentElement, { childList: true, subtree: true });
    }
  })();
</script>
