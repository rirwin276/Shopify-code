{%- comment -%}
  STELLA & SAGE — PREMIUM CATALOG SYNC
  ✅ Logic: Unchanged (Safe AI Wiring Intact)
  ✅ Visuals: Upgraded to "SaaS Studio" aesthetic
  ✅ Mobile: Optimized for touch feedback & responsive sizing
{%- endcomment -%}

{%- liquid
  assign p = product_card_product | default: product
  assign lock_code = p.metafields.custom.logo_position | default: ''

  # --- LOGO SOURCE (DYNAMIC + PIXELCUT CLEAN URL) ---
  assign store_handle = ''
  if collection and collection.handle != blank
    assign store_handle = collection.handle
  endif
  if store_handle == blank
    assign store_handle = request.params.shop | default: '' | strip
  endif

  assign logo_url = ''
  if store_handle != blank
    assign _shop_meta = shop.metaobjects.custom_shop[store_handle]
    if _shop_meta
      assign _clean = _shop_meta.logo_clean_url.value | default: _shop_meta.logo_clean_url
      if _clean != blank
        assign logo_url = _clean
      else
        assign _logo = _shop_meta.logo.value | default: _shop_meta.logo
        if _logo != blank
          assign logo_url = _logo | image_url: width: 400
        endif
      endif
    endif
  endif

  # --- MASTER BOX SETTINGS ---
  assign pixel_ratio = p.featured_media.aspect_ratio | default: 1.0
  assign media_width = p.featured_media.width | default: 600
  assign media_height = p.featured_media.height | default: 600

  # --- SECOND IMAGE ---
  assign second_media = p.media[1]

  # --- ZONE READER ---
  # --- WHAT THIS LISTING INCLUDES ---
  #
  # This card is rendered with a `children` capture that the theme fills with
  # product-card-badges (and quick-add). It has never output `children`, so
  # every badge the theme produced — sale, sold out, and now the pro-builder
  # inclusion — was assembled and thrown away. Rendering `children` wholesale
  # would drop quick-add markup into a hand-built layout that has no place for
  # it, so the one badge that has to reach shoppers is drawn here directly,
  # from the same shared rule the theme card uses.
  assign zone_style = "top: 20%; left: 20%; width: 60%; height: 60%;"
  for tag in p.tags
    assign tag_down = tag | downcase
    if tag_down contains 'zone:'
      assign zone_parts = tag_down | remove: 'zone:' | split: '-'
      if zone_parts.size == 4
        capture zone_style
          echo "top:" | append: zone_parts[0] | append: "%; "
          echo "left:" | append: zone_parts[1] | append: "%; "
          echo "width:" | append: zone_parts[2] | append: "%; "
          echo "height:" | append: zone_parts[3] | append: "%;"
        endcapture
        break
      endif
    endif
  endfor
-%}

<div class="product-card ss-card-shell{% if second_media != nil %} ss-has-alt{% endif %}" data-product-id="{{ p.id }}">
  <a href="{{ p.url }}" class="ss-link-wrapper">
    
    {%- comment -%} IMAGE AREA {%- endcomment -%}
    <div class="ss-image-stage">
      {%- capture pro_extra -%}{%- render 'pro-listing-includes', product: p -%}{%- endcapture -%}
      {%- assign pro_extra = pro_extra | strip -%}
      {%- if pro_extra != blank -%}
        <span class="ss-includes-badge">{{ pro_extra }}</span>
      {%- endif -%}
      <div class="ss-master-box" style="aspect-ratio: {{ pixel_ratio }};">
        <div class="ss-image-layers">
          {%- if p.featured_media -%}
            <img src="{{ p.featured_media | image_url: width: 600 }}"
                 class="ss-shirt-img ss-img-primary"
                 loading="lazy"
                 width="{{ media_width }}"
                 height="{{ media_height }}"
                 alt="{{ p.featured_media.alt | escape }}">

            {%- if second_media != nil -%}
              <img src="{{ second_media | image_url: width: 600 }}"
                   class="ss-shirt-img ss-img-secondary"
                   loading="lazy"
                   width="{{ second_media.width | default: media_width }}"
                   height="{{ second_media.height | default: media_height }}"
                   alt="">
            {%- endif -%}

            {%- comment -%} OVERLAY LOGIC {%- endcomment -%}
            {%- if lock_code != blank and lock_code != 'approved' and lock_code != 'DELETED' -%}
              <div class="ss-zone-box" style="{{ zone_style }}">
                <div class="ss-logo-wrapper" style="{{ lock_code | replace: '|', ';' }}">
                  {%- if logo_url != blank -%}
                    <img src="{{ logo_url }}" class="ss-logo-img" width="200" height="200" alt="Logo">
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}

          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'ss-shirt-img ss-img-primary' }}
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- comment -%} INFO AREA {%- endcomment -%}
    <div class="ss-info-deck">
      {%- comment -%}
        The badge on the image already says "Front & Back" / "Name & Number",
        so the title drops the matching suffix here. It keeps it everywhere a
        badge cannot reach — cart, order emails, search.
      {%- endcomment -%}
      {%- capture ss_card_title -%}
        {%- render 'pro-listing-title', product: p, badge: pro_extra -%}
      {%- endcapture -%}
      <h3 class="ss-title">{{ ss_card_title | strip }}</h3>

      {%- comment -%}
        Which colours this garment comes in.

        A team store is browsed by someone outfitting a roster, and their first
        question about any garment is whether it comes in their colours. The
        card shows one mockup in whichever colour happened to be first, so
        until now the answer meant opening all fifteen products.

        The swatches come from custom.color_swatches — the exact hex Printful
        gave us, written at publish time — rather than from Shopify's native
        swatches, which would mean hand-configuring every colour of every blank
        in Settings and would show a blank circle for each one missed.

        Purely visual: this card is one big anchor, so an interactive swatch
        here would be a link inside a link.
      {%- endcomment -%}
      {%- assign swatches = p.metafields.custom.color_swatches.value -%}
      {%- if swatches and swatches.size > 1 -%}
        {%- assign swatch_limit = 6 -%}
        <div class="ss-swatch-row" aria-label="Available in {{ swatches.size }} colors">
          {%- comment -%}
            Skip anything without a hex rather than emitting an empty
            background. If the metafield ever arrives as a raw string instead
            of a parsed array — no definition, a hand-edited value — iterating
            it yields entries whose .hex is nil, and "background: ;" renders as
            a row of invisible circles that is harder to diagnose than nothing
            at all.
          {%- endcomment -%}
          {%- for swatch in swatches limit: swatch_limit -%}
            {%- if swatch.hex != blank -%}
              <span
                class="ss-swatch"
                style="background: {{ swatch.hex }};"
                title="{{ swatch.name | escape }}"
              ></span>
            {%- endif -%}
          {%- endfor -%}
          {%- if swatches.size > swatch_limit -%}
            {%- assign more = swatches.size | minus: swatch_limit -%}
            <span class="ss-swatch-more">+{{ more }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%}
        ss-card-sizes

        What sizes it comes in, opposite the price.

        The deck is title, swatches, price — and on a product with one colour
        the swatch row is absent, so the card ends in a band of empty white
        with a small price floating in it. That space is worth something: the
        question a parent outfitting a kid asks second, right after the price,
        is whether it comes in their size. Answering it on the card saves
        opening every product to find out which ones run youth.

        Read off the product's own Size option, so it is the real range and
        never a guess. Shopify keeps option values in the order they were
        created and our builders write them smallest-first, which is why the
        ends of that list are the ends of the range — sorting them would give
        "3XL - XS", since size names do not sort alphabetically.

        Nothing is shown for a product with one size or no size option: "S - S"
        is noise, and a card that says nothing is better than a card that says
        something empty.
      {%- endcomment -%}
      {%- assign ss_size_range = '' -%}
      {%- for opt in p.options_with_values -%}
        {%- assign opt_name = opt.name | downcase | strip -%}
        {%- if opt_name == 'size' and opt.values.size > 1 -%}
          {%- assign _first = opt.values | first -%}
          {%- assign _last = opt.values | last -%}
          {%- assign _first = _first.name | default: _first | strip -%}
          {%- assign _last = _last.name | default: _last | strip -%}
          {%- if _first != blank and _last != blank and _first != _last -%}
            {%- capture ss_size_range -%}{{ _first }}–{{ _last }}{%- endcapture -%}
          {%- endif -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      <div class="ss-meta-row">
        <span class="ss-price">{{ p.price | money_without_trailing_zeros }}</span>
        {%- if ss_size_range != blank -%}
          <span class="ss-sizes">{{ ss_size_range }}</span>
        {%- endif -%}
      </div>
    </div>
  </a>
</div>

<style>
  /* --- THE CONTAINER (The "Physical" Card) --- */
  .ss-card-shell {
    display: flex !important;
    flex-direction: column !important;
    background: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(0,0,0,0.06);
    height: 100%;
    position: relative;
    /* Hardware acceleration for smooth mobile animation */
    transform: translateZ(0); 
    -webkit-transform: translateZ(0);
  }

  /* --- DESKTOP INTERACTION (Mouse Only) --- */
  @media (hover: hover) {
    /* Image swap: only when a second image exists */
    .ss-card-shell.ss-has-alt:hover .ss-img-primary {
      opacity: 0;
    }
    .ss-card-shell.ss-has-alt:hover .ss-img-secondary {
      opacity: 1;
    }
  }

  /* --- MOBILE INTERACTION (Touch Feedback) --- */
  .ss-card-shell:active {
    /* Slight "press down" effect when tapped on phone */
    transform: scale(0.98);
    border-color: rgba(0,0,0,0.15);
  }

  /* --- THE IMAGE STAGE --- */
  .ss-image-stage {
    width: 100%;
    position: relative;
    background-color: #f8f9fa;
    padding: 20px; /* Desktop Padding */
    box-sizing: border-box;
  }
  
  /* Reads as information about the product, not as a discount: a shopper who
     mistakes an inclusion for a promotion is worse off than one who missed it.
     Sits above .ss-zone-box (z-index 10) and .ss-logo-wrapper (11) so the
     admin logo overlay cannot cover it. */
  /* Legible on a white stage AND on a black hoodie.

     It used to be a near-black pill, which is invisible on exactly the
     products that most need the label: the dark garments a team orders. It
     sits on the photo, so it has to survive both extremes rather than
     whichever one the first mockup happened to be.

     A light pill with dark ink does that. On the pale stage the ring and
     shadow give it an edge; on a black hoodie it is the brightest thing in
     the corner. The backdrop blur keeps it readable over a busy print.

     The store's own colours cannot help here. The only per-store colour on
     the metaobject is primary_color, which is a NAME ("Navy") describing a
     requested GARMENT, not a brand colour and not a hex — so any attempt to
     tint this from it would be both unreliable and wrong. */
  .ss-includes-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 12;
    display: inline-block;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.94);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(17, 16, 14, 0.12);
    box-shadow: 0 1px 4px rgba(17, 16, 14, 0.18);
    color: #16150f;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.02em;
    pointer-events: none;
  }

  /* --- COLOUR SWATCHES --- */
  .ss-swatch-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px;
    margin-top: 8px;
  }

  .ss-swatch {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    /* Inset rather than an outline so a white or cream blank still reads as a
       circle against the card, without a ring heavy enough to distort the
       colour it is meant to be showing. */
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.18);
    flex: 0 0 auto;
  }

  .ss-swatch-more {
    font-size: 11px;
    font-weight: 600;
    color: rgba(0, 0, 0, 0.5);
    line-height: 1;
  }

  .ss-link-wrapper {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .ss-master-box {
    position: relative;
    width: 100%;
    height: auto;
    display: block;
    mix-blend-mode: multiply;
  }

  /* --- IMAGE LAYERS WRAPPER --- */
  .ss-image-layers {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
  }

  /* --- IMAGES & LAYERS --- */
  .ss-shirt-img {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: contain;
    display: block;
    z-index: 1;
    transition: opacity 0.4s ease-in-out;
  }

  /* Primary always visible by default; secondary hidden */
  .ss-img-primary {
    opacity: 1;
  }
  .ss-img-secondary {
    opacity: 0;
  }

  .ss-zone-box { position: absolute; pointer-events: none; z-index: 10; overflow: hidden; }
  .ss-logo-wrapper { position: absolute; z-index: 11; }
  .ss-logo-img { width: 100%; height: auto; display: block; }

  /* --- TYPOGRAPHY --- */
  .ss-info-deck {
    padding: 16px 20px 20px 20px;
    text-align: left;
    background: #fff;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .ss-title {
    font-weight: 600;
    font-size: 15px;
    margin: 0 0 8px 0;
    color: #1a1a1a;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  /* The price is what a shopper is actually looking for, and it was the
     faintest thing on the card: 14px, weight 500, mid-grey. Against a white
     deck on a phone held at arm's length that reads as almost not there.
     It is now the strongest line in the deck after the title. */
  .ss-price {
    font-size: 16px;
    color: #111111;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  /* --- WHAT SIZES IT COMES IN --- */
  .ss-meta-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .ss-sizes {
    font-size: 12px;
    font-weight: 600;
    color: #5b6b82;
    white-space: nowrap;
  }

  /* --- MOBILE SPECIFIC OVERRIDES (Screens smaller than 768px) --- */
  @media screen and (max-width: 767px) {
    .ss-image-stage {
      padding: 10px; /* Tighten padding so image is bigger on phone */
    }
    .ss-info-deck {
      padding: 12px 14px; /* Less whitespace for text area */
    }
    .ss-title {
      font-size: 14px; /* Slightly smaller text prevents wrapping */
    }
    .ss-card-shell {
      border-radius: 8px; /* Slightly tighter corners on small screens */
    }
    /* Said again for phones rather than left to inherit. The price reading as
       near-invisible on mobile is what prompted this, and whatever washed it
       out, an explicit rule at the breakpoint cannot be washed out quietly. */
    .ss-price {
      font-size: 16px;
      color: #111111;
      font-weight: 700;
    }
    .ss-sizes {
      font-size: 11px;
    }
  }
</style>