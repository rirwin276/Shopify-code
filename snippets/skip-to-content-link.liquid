{%- doc -%}
  Renders a skip to content link, visible on focus only.
  Parent element must have position: relative to ensure proper positioning.

  @param {string} href - The URL to skip to, usually an id like "#MainContent".
  @param {string} text - The text to display, in the form of a translation key for a locale file.

  @example
  {% render 'skip-to-content-link', href: '#MainContent', text: 'Skip to main content' %}
{%- enddoc -%}

{%- unless request.design_mode -%}
  {%- if request.path == '/collections/all' or request.path == '/collections' -%}
    <script>
      window.location.replace("{{ pages['portal'].url | default: '/pages/portal' }}");
    </script>
    <style>html, body { display: none !important; }</style>
  {%- endif -%}

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var continueShopping = document.querySelector('.cart-items__empty-button');
      if (continueShopping) {
        continueShopping.setAttribute('href', "{{ pages['portal'].url | default: '/pages/portal' }}");
      }
    });
  </script>
{%- endunless -%}

<a
  class="skip-to-content-link button-secondary"
  href="{{ href }}"
>
  {{ text | t }}
</a>
