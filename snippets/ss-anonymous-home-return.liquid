<div
  class="ss-preview-return"
  data-ss-preview-return
  data-api-base="https://anonymous-demo-preview-production.up.railway.app"
  data-signed-in="{% if customer %}true{% else %}false{% endif %}"
  role="region"
  aria-label="Your saved store"
  hidden
>
  <div class="ss-preview-return__inner">
    <span class="ss-preview-return__logo" aria-hidden="true">
      <img data-preview-return-logo alt="" width="44" height="44" hidden>
      <svg data-preview-return-fallback width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 10v10h16V10M3 10l2-6h14l2 6M3 10h18M9 20v-6h6v6"/></svg>
    </span>
    <span class="ss-preview-return__copy">
      <strong data-preview-return-title aria-live="polite">Your preview store is building</strong>
      <small data-preview-return-detail>Return anytime from this device.</small>
    </span>
    <span class="ss-preview-return__actions">
      <a class="ss-preview-return__action" data-preview-return-link href="/pages/request-storefront-form?view=start-team-store"><span data-preview-return-action>Return to waiting room →</span></a>
      <a class="ss-preview-return__claim" data-preview-return-claim href="/pages/join-store" hidden>Sign in &amp; claim</a>
    </span>
  </div>
</div>
<style>
  .ss-preview-return[hidden],.ss-preview-return [hidden]{display:none!important}
  .ss-preview-return{position:relative;z-index:4;background:#172234;color:#fff;border-bottom:3px solid #c9a832}
  .ss-preview-return__inner{box-sizing:border-box;max-width:1180px;min-height:80px;margin:0 auto;padding:12px 24px;display:grid;grid-template-columns:48px minmax(0,1fr) auto;align-items:center;gap:14px}
  .ss-preview-return__logo{width:48px;height:48px;display:grid;place-items:center;border-radius:12px;background:#fff;color:#172234;overflow:hidden}
  .ss-preview-return__logo img{width:44px;height:44px;object-fit:contain}
  .ss-preview-return__copy{display:grid;gap:4px;min-width:0}
  .ss-preview-return__copy strong{font-size:15px;line-height:1.3;overflow-wrap:anywhere}
  .ss-preview-return__copy small{font-size:12px;line-height:1.4;color:#dce4e0}
  .ss-preview-return__actions{display:flex;align-items:center;gap:8px}
  .ss-preview-return__action,.ss-preview-return__claim{box-sizing:border-box;display:inline-flex;justify-content:center;align-items:center;min-height:44px;border-radius:999px;padding:10px 16px;font-size:12px;line-height:1.3;font-weight:750;text-decoration:none;text-align:center}
  .ss-preview-return__action{background:#fff;color:#172234}
  .ss-preview-return__claim{border:1px solid #b9cebf;color:#fff}
  .ss-preview-return__actions a:focus-visible{outline:3px solid #edcf6c;outline-offset:3px}
  .ss-preview-return[data-phase="ready"]{background:#143324;border-bottom-color:#77b486}
  .ss-preview-return[data-phase="ready"] .ss-preview-return__action{color:#143324}
  @media(max-width:680px){.ss-preview-return__inner{padding:12px 16px;grid-template-columns:44px minmax(0,1fr);gap:10px 12px}.ss-preview-return__logo{width:44px;height:44px}.ss-preview-return__copy strong{font-size:14px}.ss-preview-return__actions{grid-column:1/-1}.ss-preview-return__actions a{flex:1;padding:10px 12px}}
</style>
<script src="{{ 'ss-anonymous-home-return.js' | asset_url }}" defer></script>
