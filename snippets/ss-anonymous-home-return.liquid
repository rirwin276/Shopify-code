<div
  class="ss-preview-return"
  data-ss-preview-return
  data-api-base="https://anonymous-demo-preview-production.up.railway.app"
  hidden
>
  <a class="ss-preview-return__inner" data-preview-return-link href="/pages/request-storefront-form?view=start-team-store">
    <span class="ss-preview-return__pulse" aria-hidden="true"></span>
    <span class="ss-preview-return__copy">
      <strong data-preview-return-title>Your preview store is building</strong>
      <small data-preview-return-detail>Return anytime from this device.</small>
    </span>
    <span class="ss-preview-return__action" data-preview-return-action>Return to waiting room →</span>
  </a>
</div>
<style>
  .ss-preview-return[hidden]{display:none!important}.ss-preview-return{position:relative;z-index:4;background:#172234;color:#fff;border-bottom:3px solid #c9a832}.ss-preview-return__inner{max-width:1180px;min-height:62px;margin:0 auto;padding:10px 24px;display:flex;align-items:center;gap:13px;color:inherit;text-decoration:none}.ss-preview-return__pulse{width:11px;height:11px;flex:none;border-radius:50%;background:#d4b64b;box-shadow:0 0 0 0 rgba(212,182,75,.65);animation:ssPreviewReturnPulse 1.8s infinite}.ss-preview-return__copy{display:grid;gap:1px;min-width:0}.ss-preview-return__copy strong{font-size:14px;line-height:1.25}.ss-preview-return__copy small{font-size:11px;line-height:1.35;color:#cbd4df}.ss-preview-return__action{margin-left:auto;flex:none;border-radius:999px;background:#fff;color:#172234;padding:9px 14px;font-size:12px;font-weight:850}.ss-preview-return[data-phase="ready"]{background:#143324;border-bottom-color:#77b486}.ss-preview-return[data-phase="ready"] .ss-preview-return__pulse{background:#8ed09e;animation:none}.ss-preview-return[data-phase="ready"] .ss-preview-return__action{color:#143324}@keyframes ssPreviewReturnPulse{70%{box-shadow:0 0 0 8px rgba(212,182,75,0)}100%{box-shadow:0 0 0 0 rgba(212,182,75,0)}}@media(max-width:680px){.ss-preview-return__inner{padding:10px 14px;gap:10px}.ss-preview-return__copy strong{font-size:13px}.ss-preview-return__copy small{display:none}.ss-preview-return__action{padding:8px 11px;font-size:11px}}@media(prefers-reduced-motion:reduce){.ss-preview-return__pulse{animation:none}}
</style>
<script src="{{ 'ss-anonymous-home-return.js' | asset_url }}" defer></script>
