{% comment %}
  STELLA & SAGE - DATA LAYER
  Passes the "Grandma-Proofed" Pixelcut URL to JavaScript.
  Also upgrades dashboard store-logo thumbnails using the original Shopify MediaImage when available.
{% endcomment %}

<script>
  window.SS = window.SS || {};
  window.SS.config = window.SS.config || {};
  // dashboardLogoMap removed: the dashboard sizes logos in Liquid now, and
  // nothing reads a JS-side image map. See sharpenDashboardLogos.
  //
  /* The store config below is unrelated and still live — ss-canvas-overlay.js
     reads config.logoUrl to draw the logo onto product previews. This is a
     block comment so Liquid whitespace trimming cannot swallow the IIFE below. */

  {%- if collection and collection.handle -%}
    {%- assign store_handle = collection.handle -%}
    {%- assign store_meta = shop.metaobjects.custom_shop[store_handle] -%}
    {%- if store_meta -%}
      window.SS.config.storeHandle = "{{ store_handle }}";
      {%- if store_meta.logo_clean_url != blank -%}
        window.SS.config.logoUrl = "{{ store_meta.logo_clean_url }}";
      {%- elsif store_meta.logo != blank -%}
        window.SS.config.logoUrl = "{{ store_meta.logo | image_url: width: 1600 }}";
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  (function () {
    var path = window.location.pathname || '';
    if (path.indexOf('/pages/portal') !== 0) return;

    // Deliberately does NOT touch src or srcset.
    //
    // This used to rewrite both from a handle-keyed map built by walking
    // customer.tags. That made a "sharpening" pass the deciding vote on WHICH
    // logo a card shows, and it got it wrong — one store's picture on several
    // cards, worst at the end of a long list. It also ran in full on every DOM
    // mutation, re-querying the document and re-setting attributes on every
    // card while the fundraiser strips and product counts were still landing,
    // which is what made a dashboard with many stores stutter under a scroll.
    //
    // The logo is now sized in Liquid with a real Shopify srcset, so the
    // resolution problem this was written to solve no longer needs any
    // JavaScript. Nothing here can change which image is displayed.
    function sharpenDashboardLogos() {
      var imgs = document.querySelectorAll('.ss-store-card[data-ss-handle] .ss-logo-frame img');
      for (var i = 0; i < imgs.length; i++) {
        var img = imgs[i];
        if (img.dataset.ssDecodeHinted === '1') continue;
        img.dataset.ssDecodeHinted = '1';
        img.setAttribute('decoding', 'async');
      }
    }

    function addProductCounts() {
      document.querySelectorAll('.ss-store-card[data-ss-products]').forEach(function (card) {
        if (card.dataset.ssProductCountInjected === '1') return;
        var count = parseInt(card.getAttribute('data-ss-products') || '0', 10);
        var title = card.querySelector('.ss-card-title');
        if (!title || !count || count < 1) return;
        var line = document.createElement('span');
        line.className = 'ss-card-product-count';
        line.textContent = count + ' live product' + (count === 1 ? '' : 's');
        title.insertAdjacentElement('afterend', line);
        card.dataset.ssProductCountInjected = '1';
      });
    }

    function polishDashboardCards() {
      sharpenDashboardLogos();
      addProductCounts();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', polishDashboardCards, { once: true });
    } else {
      polishDashboardCards();
    }

    // Batched onto one animation frame.
    //
    // polishDashboardCards ran in full on every mutation, and addProductCounts
    // inserts an element — so each pass fed the next. With fundraiser strips,
    // ready-status polling and image loads all mutating the page at once, a
    // long dashboard spent its scroll budget re-scanning itself.
    var polishQueued = false;
    var observer = new MutationObserver(function (records) {
      if (polishQueued) return;
      for (var i = 0; i < records.length; i++) {
        if (records[i].addedNodes.length) {
          polishQueued = true;
          requestAnimationFrame(function () { polishQueued = false; polishDashboardCards(); });
          return;
        }
      }
    });
    if (document.body) observer.observe(document.body, { childList: true, subtree: true });
  })();
</script>


{% comment %}Dashboard presentation belongs to assets/ss-dashboard-home-theme.css. Keeping it there prevents late global styles from overriding the card layout.{% endcomment %}