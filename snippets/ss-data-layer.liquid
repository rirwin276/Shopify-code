{% comment %}
  STELLA & SAGE - DATA LAYER
  Passes the "Grandma-Proofed" Pixelcut URL to JavaScript.
  Also upgrades dashboard store-logo thumbnails using the original Shopify MediaImage when available.
{% endcomment %}

<script>
  window.SS = window.SS || {};
  window.SS.config = window.SS.config || {};
  // dashboardLogoMap removed: the dashboard sizes logos in Liquid now, and
  // nothing reads a JS-side image map. See sharpenDashboardLogos.
  //
  // The store config below is unrelated and still live — ss-canvas-overlay.js
  // reads config.logoUrl to draw the logo onto product previews.

  {%- if collection and collection.handle -%}
    {%- assign store_handle = collection.handle -%}
    {%- assign store_meta = shop.metaobjects.custom_shop[store_handle] -%}
    {%- if store_meta -%}
      window.SS.config.storeHandle = "{{ store_handle }}";
      {%- if store_meta.logo_clean_url != blank -%}
        window.SS.config.logoUrl = "{{ store_meta.logo_clean_url }}";
      {%- elsif store_meta.logo != blank -%}
        window.SS.config.logoUrl = "{{ store_meta.logo | image_url: width: 1600 }}";
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  (function () {
    var path = window.location.pathname || '';
    if (path.indexOf('/pages/portal') !== 0) return;

    // Deliberately does NOT touch src or srcset.
    //
    // This used to rewrite both from a handle-keyed map built by walking
    // customer.tags. That made a "sharpening" pass the deciding vote on WHICH
    // logo a card shows, and it got it wrong — one store's picture on several
    // cards, worst at the end of a long list. It also ran in full on every DOM
    // mutation, re-querying the document and re-setting attributes on every
    // card while the fundraiser strips and product counts were still landing,
    // which is what made a dashboard with many stores stutter under a scroll.
    //
    // The logo is now sized in Liquid with a real Shopify srcset, so the
    // resolution problem this was written to solve no longer needs any
    // JavaScript. Nothing here can change which image is displayed.
    function sharpenDashboardLogos() {
      var imgs = document.querySelectorAll('.ss-store-card[data-ss-handle] .ss-logo-frame img');
      for (var i = 0; i < imgs.length; i++) {
        var img = imgs[i];
        if (img.dataset.ssDecodeHinted === '1') continue;
        img.dataset.ssDecodeHinted = '1';
        img.setAttribute('decoding', 'async');
      }
    }

    function addProductCounts() {
      document.querySelectorAll('.ss-store-card[data-ss-products]').forEach(function (card) {
        if (card.dataset.ssProductCountInjected === '1') return;
        var count = parseInt(card.getAttribute('data-ss-products') || '0', 10);
        var title = card.querySelector('.ss-card-title');
        if (!title || !count || count < 1) return;
        var line = document.createElement('span');
        line.className = 'ss-card-product-count';
        line.textContent = count + ' live product' + (count === 1 ? '' : 's');
        title.insertAdjacentElement('afterend', line);
        card.dataset.ssProductCountInjected = '1';
      });
    }

    function polishDashboardCards() {
      sharpenDashboardLogos();
      addProductCounts();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', polishDashboardCards, { once: true });
    } else {
      polishDashboardCards();
    }

    // Batched onto one animation frame.
    //
    // polishDashboardCards ran in full on every mutation, and addProductCounts
    // inserts an element — so each pass fed the next. With fundraiser strips,
    // ready-status polling and image loads all mutating the page at once, a
    // long dashboard spent its scroll budget re-scanning itself.
    var polishQueued = false;
    var observer = new MutationObserver(function (records) {
      if (polishQueued) return;
      for (var i = 0; i < records.length; i++) {
        if (records[i].addedNodes.length) {
          polishQueued = true;
          requestAnimationFrame(function () { polishQueued = false; polishDashboardCards(); });
          return;
        }
      }
    });
    if (document.body) observer.observe(document.body, { childList: true, subtree: true });
  })();
</script>

<style>
  @media (max-width: 850px) {
    .ss-portal .ss-bg { padding-top: 18px !important; padding-bottom: 26px !important; }
    .ss-portal .ss-wrap { padding-left: 12px !important; padding-right: 12px !important; }
    .ss-portal .ss-store-grid { gap: 8px !important; }
    .ss-portal .ss-store-card {
      border-radius: 20px !important;
      overflow: hidden !important;
      border-color: rgba(15,23,42,.052) !important;
      box-shadow: 0 10px 26px rgba(15,23,42,.045), inset 0 1px 0 rgba(255,255,255,.86) !important;
    }
    .ss-portal .ss-col-identity {
      padding: 9px 12px 4px !important;
      gap: 10px !important;
      align-items: center !important;
    }
    .ss-portal .ss-logo-frame {
      width: 104px !important;
      height: 104px !important;
      min-width: 104px !important;
      border-radius: 19px !important;
      background: rgba(255,255,255,.84) !important;
      border: 1px solid rgba(15,23,42,.065) !important;
      box-shadow: 0 8px 20px rgba(15,23,42,.055) !important;
    }
    .ss-portal .ss-logo-frame img {
      padding: 9% !important;
      image-rendering: auto !important;
      object-fit: contain !important;
      transform: translateZ(0) !important;
      filter: contrast(1.055) saturate(1.055) !important;
    }
    .ss-portal .ss-identity-text { min-width: 0 !important; padding-top: 0 !important; }
    .ss-portal .ss-card-title {
      font-size: 17px !important;
      line-height: 1.02 !important;
      margin-bottom: 3px !important;
      letter-spacing: -.04em !important;
    }
    .ss-portal .ss-card-subtitle {
      display: inline-flex !important;
      width: fit-content !important;
      font-size: 9px !important;
      padding: 3px 7px !important;
      border-radius: 999px !important;
      letter-spacing: .11em !important;
      text-transform: uppercase !important;
    }
    .ss-portal .ss-card-product-count {
      display: block !important;
      margin: 0 0 5px !important;
      font-size: 11px !important;
      font-weight: 850 !important;
      color: rgba(15,23,42,.46) !important;
      letter-spacing: .01em !important;
    }
    .ss-portal .ss-col-engine { padding: 4px 12px 5px !important; }
    .ss-portal .ss-status-finished, .ss-portal .ss-status-building {
      padding: 5px 10px !important;
      border-radius: 999px !important;
      min-height: 32px !important;
    }
    .ss-portal .ss-status-text, .ss-portal .ss-status-text-building { font-size: 9px !important; letter-spacing: .095em !important; }
    .ss-portal .ss-col-controls { padding: 5px 10px 10px !important; gap: 6px !important; }
    .ss-portal .ss-admin-btn {
      min-height: 34px !important;
      padding: 6px 11px !important;
      font-size: 10px !important;
      border-radius: 999px !important;
      letter-spacing: .13em !important;
      background: rgba(255,255,255,.78) !important;
      color: rgba(87,73,36,.96) !important;
      border-color: rgba(87,73,36,.15) !important;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.78) !important;
    }
    .ss-portal .ss-open-btn {
      min-height: 44px !important;
      padding: 8px 14px !important;
      font-size: 14px !important;
      border-radius: 999px !important;
      box-shadow: 0 11px 24px rgba(15,23,42,.145) !important;
    }
    .ss-portal .ss-open-btn svg { width: 14px !important; height: 14px !important; }
    .ss-portal .ss-leave-btn { min-height: 30px !important; padding: 6px 11px !important; font-size: 9px !important; border-radius: 999px !important; }
  }

  @media (max-width: 400px) {
    .ss-portal .ss-logo-frame {
      width: 94px !important;
      height: 94px !important;
      min-width: 94px !important;
    }
    .ss-portal .ss-card-title { font-size: 16px !important; }
    .ss-portal .ss-open-btn { min-height: 42px !important; }
  }

  @media (min-width: 851px) {
    .ss-portal .ss-logo-frame {
      width: 88px !important;
      height: 88px !important;
      min-width: 88px !important;
      border-radius: 18px !important;
    }
    .ss-portal .ss-card-product-count { display: block; margin: 3px 0 5px; font-size: 11px; font-weight: 780; color: rgba(91,107,130,.72); }
    .ss-portal .ss-admin-btn { padding: 8px 12px !important; font-size: 11px !important; letter-spacing: .09em !important; }
    .ss-portal .ss-logo-frame img { padding: 9% !important; filter: contrast(1.045) saturate(1.045) !important; }
  }
</style>