{%- comment -%}Visual approximations only when Printful/native swatch metadata is absent. Unknown names return blank.{%- endcomment -%}
{%- liquid
  assign color = name | downcase | strip
  case color
    when 'black', 'solid black', 'black heather', 'vintage black', 'black triblend'
      echo '#202020'
    when 'charcoal', 'dark grey', 'dark gray', 'dark grey heather', 'dark heather', 'dark grey heather triblend', 'pepper'
      echo '#484848'
    when 'grey', 'gray', 'grey heather', 'gray heather', 'sport grey', 'athletic heather', 'heather grey', 'heather gray', 'grey triblend', 'athletic grey'
      echo '#a5a5a5'
    when 'white', 'solid white'
      echo '#ffffff'
    when 'cream', 'natural', 'ivory', 'oyster', 'vintage white'
      echo '#eee9d8'
    when 'tan', 'sand', 'sand dune', 'latte', 'khaki'
      echo '#c5b38e'
    when 'navy', 'navy blue', 'heather navy', 'navy triblend', 'french navy'
      echo '#202d48'
    when 'royal', 'royal blue', 'true royal', 'true royal triblend'
      echo '#2856b3'
    when 'light blue', 'baby blue', 'carolina blue'
      echo '#9cc6e3'
    when 'red', 'true red', 'heather red', 'red triblend'
      echo '#b92530'
    when 'maroon', 'burgundy', 'cardinal'
      echo '#742633'
    when 'forest', 'forest green', 'dark green', 'heather forest'
      echo '#254637'
    when 'kelly', 'kelly green', 'green'
      echo '#288443'
    when 'military green', 'olive', 'army'
      echo '#60664c'
    when 'mint', 'mint green', 'seafoam'
      echo '#a5ddcb'
    when 'pink', 'light pink', 'soft pink', 'heather prism peach'
      echo '#edb5c7'
    when 'purple', 'team purple'
      echo '#68448d'
    when 'gold', 'yellow', 'mustard'
      echo '#e6be35'
    when 'orange', 'burnt orange'
      echo '#d47735'
    when 'brown', 'chocolate'
      echo '#694b3c'
  endcase
-%}
