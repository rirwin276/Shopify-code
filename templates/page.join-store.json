    "custom_liquid_wQHtpP": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{% comment %}\n  JOIN STORE LANDING PAGE (SAFE MODE + DELAY SEQUENCE)\n  - \"Backup URL Parser\" included.\n  - \"Design Mode\" check added.\n  - ADDED: 20-second \"Gated Access\" loading sequence to allow API propagation.\n  - UPDATED: Uses 'storefront_login_url' + 'return_to' for seamless New Customer Account loops.\n  - UPDATED: Final redirect goes to Dashboard (/pages/portal).\n{% endcomment %}\n\n{%- comment -%} --- 1. ROBUST URL PARSING --- {%- endcomment -%}\n{%- assign shop_handle = request.params.shop | default: '' | strip -%}\n{%- assign code = request.params.code | default: '' | strip -%}\n\n{%- if shop_handle == blank -%}\n  {%- assign _cfh = content_for_header -%}\n  {%- assign _url_part = _cfh | split: '\"pageurl\":\"' | last | split: '\"' | first -%}\n  {%- assign _url_part = _url_part | replace: '\\u0026', '&' -%}\n  {%- if _url_part contains '?' -%}\n    {%- assign _qs = _url_part | split: '?' | last -%}\n    {%- assign _pairs = _qs | split: '&' -%}\n    {%- for p in _pairs -%}\n      {%- assign kv = p | split: '=' -%}\n      {%- if kv[0] == 'shop' -%}{%- assign shop_handle = kv[1] | default: '' | strip -%}{%- endif -%}\n      {%- if kv[0] == 'code' -%}{%- assign code = kv[1] | default: '' | strip -%}{%- endif -%}\n    {%- endfor -%}\n  {%- endif -%}\n{%- endif -%}\n\n{%- assign shop_handle = shop_handle | replace: '%2D', '-' | replace: '%5F', '_' | strip | downcase -%}\n\n{%- comment -%} --- 2. GET STORE DATA --- {%- endcomment -%}\n{%- assign store_entry = shop.metaobjects.custom_shop[shop_handle] -%}\n{%- assign store_name = store_entry.name | default: shop_handle -%}\n{%- assign store_logo = store_entry.logo.value | default: store_entry.logo -%}\n{%- assign collection_url = '/collections/' | append: shop_handle -%}\n\n{% render 'logo-frame-contrast' %}\n\n<div class=\"sf-join-container\">\n\n  {%- if customer == nil -%}\n    {%- comment -%}\n      GUEST VIEW: SHOW THE STORE, THEN OFFER THE ACCOUNT.\n\n      This used to redirect straight to Shopify account creation. Someone who\n      clicked a cold email saw \"Redirecting to login...\" and never saw a logo,\n      a product or a price — while the email that sent them here promised a\n      working store they could look at.\n\n      So the invite card renders for guests too, with two doors. Preview needs\n      no account and opens the real store read-only. Join is the same flow it\n      always was, taken by someone who has now seen what they are joining.\n    {%- endcomment -%}\n    {%- comment -%}\n      Preview always has a door. Stores that carry a join_code use it as the\n      token; stores without one accept ?preview=1, because their join link\n      already lets any holder become a member — looking is less than that.\n      Gating the button on a code most stores do not have is exactly why it\n      failed to render at all.\n    {%- endcomment -%}\n    {%- assign join_code = store_entry.join_code.value | default: store_entry.join_code | default: '' | strip -%}\n    {%- assign preview_token = join_code | default: '1' -%}\n    {%- if preview_token == blank -%}{%- assign preview_token = '1' -%}{%- endif -%}\n    {%- assign preview_url = collection_url | append: '?preview=' | append: preview_token -%}\n\n    {%- if store_entry == nil -%}\n      <div class=\"sf-card sf-card--error\">\n        <h2>Store Not Found</h2>\n        <p>The link you used seems to be invalid or the store \"<strong>{{ shop_handle }}</strong>\" does not exist.</p>\n      </div>\n    {%- else -%}\n      <div class=\"sf-card\">\n        <div class=\"sf-logo-area\">\n          {%- if store_logo != blank -%}\n            {{ store_logo | image_url: width: 300 | image_tag: class: 'sf-store-logo', loading: 'eager' }}\n          {%- else -%}\n            <div class=\"sf-logo-fallback\">{{ store_name | slice: 0, 2 | upcase }}</div>\n          {%- endif -%}\n        </div>\n\n        <div class=\"sf-content\">\n          <span class=\"sf-badge\">A private store built for</span>\n          <h1 class=\"sf-title\">{{ store_name }}</h1>\n          <p class=\"sf-sub\">\n            Take a look first &mdash; no account needed. Pick colors and sizes, and add a\n            name &amp; number to see it on the shirt.\n          </p>\n\n          {%- comment -%}\n            Preview leads. It is the smaller ask, and someone who has seen the\n            store is a far better candidate for an account than someone being\n            asked to make one sight unseen. Joining stays one tap away here and\n            is repeated inside the preview itself.\n          {%- endcomment -%}\n          <div class=\"sf-btn-stack\">\n            <a class=\"sf-btn sf-btn--primary\" href=\"{{ preview_url }}\">Preview the store</a>\n            {%- comment -%}\n              return_to must carry the join code as well as the handle. The\n              guest redirect this replaced used the full pathname + search, so\n              dropping code here would send a code-gated store's visitor back\n              from sign-in without the thing that lets them join.\n            {%- endcomment -%}\n            {%- capture return_path -%}\n              {{ request.path }}?shop={{ shop_handle }}{% if code != blank %}&code={{ code }}{% endif %}\n            {%- endcapture -%}\n            <a class=\"sf-btn sf-btn--outline\"\n               href=\"{{ routes.storefront_login_url }}?return_to={{ return_path | strip | url_encode }}\">\n              Sign in to join\n            </a>\n          </div>\n\n          <p class=\"sf-note\">Ordering opens once you join. Nothing here is public.</p>\n        </div>\n      </div>\n    {%- endif -%}\n\n  {%- elsif store_entry == nil and shop_handle != blank -%}\n    <div class=\"sf-card sf-card--error\">\n      <h2>Store Not Found</h2>\n      <p>The link you used seems to be invalid or the store \"<strong>{{ shop_handle }}</strong>\" does not exist.</p>\n      <a href=\"/pages/portal\" class=\"sf-btn sf-btn--outline\">Back to Dashboard</a>\n    </div>\n\n  {%- elsif shop_handle == blank -%}\n    <div class=\"sf-card sf-card--error\">\n      <h2>Invalid Link</h2>\n      <p>This link is missing the shop ID. Please check the URL.</p>\n      <a href=\"/pages/portal\" class=\"sf-btn sf-btn--outline\">Back to Dashboard</a>\n    </div>\n\n  {%- else -%}\n    {%- comment -%} SUCCESS VIEW: SHOW PREVIEW CARD {%- endcomment -%}\n    <div class=\"sf-card\">\n      <div class=\"sf-logo-area\">\n        {%- if store_logo != blank -%}\n          {{ store_logo | image_url: width: 300 | image_tag: class: 'sf-store-logo', loading: 'eager' }}\n        {%- else -%}\n          <div class=\"sf-logo-fallback\">{{ store_name | slice: 0, 2 | upcase }}</div>\n        {%- endif -%}\n      </div>\n\n      <div class=\"sf-content\">\n        <span class=\"sf-badge\">You have been invited to join</span>\n        <h1 class=\"sf-title\">{{ store_name }}</h1>\n        <p class=\"sf-sub\">Click below to add this private collection to your dashboard.</p>\n        \n        <button id=\"btnJoin\" class=\"sf-btn sf-btn--primary\" onclick=\"joinStore()\">\n          Join Storefront\n        </button>\n        \n        <div id=\"joinStatus\" class=\"sf-status\"></div>\n      </div>\n    </div>\n\n    <script>\n      function joinStore() {\n        var btn = document.getElementById('btnJoin');\n        var statusEl = document.getElementById('joinStatus');\n        \n        // 1. Lock the Button immediately\n        btn.disabled = true;\n        btn.innerHTML = '<span class=\"sf-spinner-small\"></span> Processing...';\n        statusEl.innerHTML = \"Initializing secure connection...\";\n        statusEl.classList.add('active');\n        \n        // Route the join through our OWN backend: the Printful_Automation App\n        // Proxy relay forwards to studio-uploader. The App Proxy signs the\n        // request and injects the VERIFIED logged-in customer id server-side,\n        // so we deliberately send no id here. This adds MEMBER access only.\n        var joinUrl = \"/apps/ss/relay/storefront/{{ shop_handle }}/join\";\n\n        var didError = false;\n\n        // 2. Call the backend. On confirmed success, wait for Shopify tag propagation\n        // then redirect. The clock starts when the backend responds — not when\n        // the button is clicked — so the customer always gets the full wait.\n        fetch(joinUrl, {\n          method: 'POST',\n          headers: {'Content-Type':'application/json'},\n          body: '{}'\n        })\n        .then(function(res){\n          return res.json().catch(function(){ return {}; }).then(function(data){\n            if(!res.ok || !data.ok){\n              throw new Error(((data && data.error) || 'Join failed') + ' [HTTP ' + res.status + ']');\n            }\n            // Tag written on backend — give Shopify 12 s to propagate it before\n            // the customer lands on the dashboard and the gate check runs.\n            setTimeout(function(){\n              if (didError) return;\n              statusEl.style.opacity = '0';\n              setTimeout(function(){\n                if (didError) return;\n                statusEl.innerHTML = '<b>Access granted!</b> Loading your dashboard…';\n                statusEl.style.opacity = '1';\n              }, 300);\n              setTimeout(function(){\n                if (didError) return;\n                window.location.href = '/pages/portal';\n              }, 1500);\n            }, 11500);\n          });\n        })\n        .catch(function(err){\n          console.error(err);\n          didError = true;\n          btn.disabled = false;\n          btn.innerHTML = 'Try Again';\n          statusEl.innerHTML = (err && err.message) ? err.message : 'Connection Error. Please try again.';\n          statusEl.style.color = 'red';\n        });\n\n        // 3. Progress steps — visual feedback during the backend call + propagation wait.\n        // Success message and redirect are driven by the .then() block above.\n        var steps = [\n          { time: 1500, text: \"Verifying invite...\" },\n          { time: 4000, text: \"Granting access permissions...\" },\n          { time: 7000, text: \"Syncing your dashboard...\" },\n          { time: 10500, text: \"Almost ready…\" }\n        ];\n\n        steps.forEach(function(step) {\n          setTimeout(function() {\n            if (didError) return;\n            statusEl.style.opacity = '0';\n            setTimeout(function(){\n              if (didError) return;\n              statusEl.innerHTML = step.text;\n              statusEl.style.opacity = '1';\n            }, 300);\n          }, step.time);\n        });\n      }\n    </script>\n  {%- endif -%}\n\n</div>\n\n<style>\n  /* CLEAN UI - MATCHING DASHBOARD THEME */\n  .sf-join-container { max-width: 500px; margin: 60px auto; padding: 0 20px; font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif; text-align: center; }\n  .sf-card { background: #fff; border: 1px solid rgba(0,0,0,0.08); border-radius: 24px; padding: 40px; box-shadow: 0 10px 40px rgba(0,0,0,0.06); overflow: hidden; }\n  .sf-card--error { border-color: #fee; background: #fffafa; }\n  .sf-card--info { border-color: #e0f2fe; background: #f0f9ff; color: #0369a1; padding: 20px; }\n  \n  .sf-logo-area { width: 100px; height: 100px; margin: 0 auto 24px; border-radius: 20px; background: #f8fafc; border: 1px solid rgba(0,0,0,0.06); display: flex; align-items: center; justify-content: center; overflow: hidden; }\n  .sf-store-logo { width: 100%; height: 100%; object-fit: contain; padding: 10px; }\n  .sf-logo-fallback { font-size: 28px; font-weight: 800; color: #94a3b8; }\n  \n  .sf-badge { display: inline-block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; color: #64748b; margin-bottom: 8px; background: #f1f5f9; padding: 4px 10px; border-radius: 99px; }\n  .sf-title { font-size: 26px; font-weight: 900; margin: 0 0 12px; color: #0f172a; letter-spacing: -0.02em; }\n  .sf-sub { font-size: 15px; color: #64748b; margin: 0 0 30px; line-height: 1.5; }\n  \n  .sf-btn { width: 100%; border: none; padding: 16px; border-radius: 99px; font-size: 16px; font-weight: 700; cursor: pointer; transition: all 0.2s; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px; }\n  .sf-btn--primary { background: #0f172a; color: #fff; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.2); }\n  .sf-btn--primary:hover { background: #000; transform: translateY(-1px); }\n  .sf-btn--primary:disabled { opacity: 0.7; cursor: not-allowed; transform: none; background: #334155; }\n  .sf-btn--outline { background: transparent; border: 1px solid #e2e8f0; color: #0f172a; width: auto; padding: 12px 24px; }\n  \n  /* STATUS ANIMATION STYLES */\n  .sf-status { \n    margin-top: 20px; \n    font-size: 13px; \n    font-weight: 500; \n    color: #64748b; \n    min-height: 24px; \n    transition: opacity 0.3s ease; \n    opacity: 0; \n  }\n  .sf-status.active { opacity: 1; }\n  .sf-status b { color: #10b981; }\n\n  .sf-spinner-small { width: 16px; height: 16px; border: 2px solid rgba(255,255,255,0.3); border-top-color: #fff; border-radius: 50%; animation: spin 0.8s linear infinite; }\n  @keyframes spin { to { transform: rotate(360deg); } }\n  .sf-spinner { width: 40px; height: 40px; border: 4px solid #e2e8f0; border-top-color: #0f172a; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 16px; }\n  .sf-loading-state { margin-top: 60px; color: #64748b; }\n  .sf-btn--outline { background: transparent; border: 1px solid rgba(0,0,0,.18); color: #17150f; }\n  .sf-note { margin-top: 12px; font-size: 12.5px; color: #64748b; }\n  .sf-btn-stack { display: flex; flex-direction: column; gap: 10px; align-items: stretch; }\n  .sf-btn-stack .sf-btn { width: 100%; box-sizing: border-box; }\n</style>",
        "color_scheme": "",
