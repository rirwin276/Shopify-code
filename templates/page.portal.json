            "custom_liquid": "<style>\n  .ss-store-card {\n    contain: none !important;\n    content-visibility: visible !important;\n    contain-intrinsic-size: auto !important;\n  }\n</style>\n\n<script>\n/*\n  Safety net for dashboard cards, not the source of truth.\n\n  This used to walk every custom_shop metaobject on the platform and, for each\n  one, look up its collection and resolve its logo media — work that grows with\n  the total number of stores in the business, on every dashboard load, for every\n  seller, whether or not any of it was needed. Then it rewrote each card's\n  title, logo, link and product count on DOMContentLoaded, on pageshow, again at\n  150ms and again at 800ms. That is the flicker: the server rendered a card and\n  a moment later JavaScript redrew it, twice.\n\n  So it now carries only what it can supply cheaply and only repairs what is\n  actually wrong:\n\n  - name and collection handle come straight off the metaobject. No\n    collections[] lookup, no image_url, so the Liquid cost no longer scales\n    with the platform.\n  - logos and product counts are left to the section. It has the dedup logic\n    for shared logo URLs, and a script that rewrites an <img> src is the known\n    cause of one store wearing another's picture.\n  - a value is written only when it differs from what the server rendered. When\n    the section is right — which is the normal case — this changes nothing and\n    there is nothing to see.\n*/\n(function(){\n  var stores = {\n    {% for portal_store in shop.metaobjects.custom_shop.values %}\n      {% assign portal_handle = portal_store.system.handle | default: '' | strip %}\n      {% if portal_handle != blank %}\n        {% assign portal_name = portal_store.name.value | default: portal_store.name | default: portal_handle %}\n        {% assign portal_collection_handle = portal_store.collection_handle.value | default: portal_store.collection_handle | default: portal_handle | strip %}\n        {{ portal_handle | json }}: {\n          name: {{ portal_name | json }},\n          collectionHandle: {{ portal_collection_handle | json }}\n        },\n      {% endif %}\n    {% endfor %}\n  };\n\n  function setAttrIfChanged(el, attr, value){\n    if(el.getAttribute(attr) !== value) el.setAttribute(attr, value);\n  }\n\n  function repairDashboardCards(){\n    document.querySelectorAll('.ss-store-card[data-ss-handle]').forEach(function(card){\n      var handle = (card.getAttribute('data-ss-handle') || '').trim();\n      var store = stores[handle];\n      if(!handle || !store) return;\n\n      var collectionHandle = store.collectionHandle || handle;\n      var shopHref = '/collections/' + encodeURIComponent(collectionHandle);\n      var adminHref = '/pages/admin-powers?shop=' + encodeURIComponent(handle);\n\n      setAttrIfChanged(card, 'data-href', shopHref);\n      setAttrIfChanged(card, 'data-admin-href', adminHref);\n\n      var title = card.querySelector('.ss-card-title');\n      var wanted = store.name || handle;\n      if(title && title.textContent.trim() !== wanted) title.textContent = wanted;\n\n      card.querySelectorAll('a.ss-open-btn').forEach(function(link){\n        setAttrIfChanged(link, 'href', shopHref);\n      });\n\n      card.querySelectorAll('.ss-admin-btn, [data-admin-href]').forEach(function(control){\n        setAttrIfChanged(control, 'data-admin-href', adminHref);\n        if(control.tagName && control.tagName.toLowerCase() === 'a') setAttrIfChanged(control, 'href', adminHref);\n      });\n    });\n  }\n\n  if(document.readyState === 'loading'){\n    document.addEventListener('DOMContentLoaded', repairDashboardCards);\n  } else {\n    repairDashboardCards();\n  }\n  window.addEventListener('pageshow', repairDashboardCards);\n})();\n</script>"
