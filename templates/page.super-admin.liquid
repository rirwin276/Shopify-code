      document.getElementById('manageLastPurchase').textContent = store ? purchaseText(store) : 'Statistics have not loaded yet';
      document.getElementById('manageLastOtherSession').textContent = store ? otherVisitText(store) : 'Statistics have not loaded yet';
      document.getElementById('manageLastCustomer').textContent = store ? lastCustomerText(store) : 'Statistics have not loaded yet';
