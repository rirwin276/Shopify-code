      document.getElementById('manageProductTotal').textContent = store ? (observable.products === false ? '—' : formatNumber(products.total)) : '—';
      document.getElementById('manageProductLive').textContent = store ? (observable.products === false ? '—' : formatNumber(products.live)) : '—';
      document.getElementById('manageProductDraft').textContent = store ? (observable.products === false ? '—' : formatNumber(products.draft)) : '—';
      document.getElementById('manageProductArchived').textContent = store ? (observable.products === false ? '—' : formatNumber(products.archived)) : '—';
      document.getElementById('manageProductNewest').textContent = store ? (observable.products === false ? 'Product data is unavailable' : productText(products.newest_product, 'created_at')) : 'Statistics have not loaded yet';
      document.getElementById('manageProductUpdated').textContent = store ? (observable.products === false ? 'Product data is unavailable' : productText(products.last_product_update, 'updated_at')) : 'Statistics have not loaded yet';
      renderActivityLog(store);
      document.getElementById('manageCoverage').textContent = store
        ? coverageLabel(sales.coverage) + ' Sessions are counted only from ' + (activity.tracking_started_at ? formatDate(activity.tracking_started_at) : 'tracker deployment') + '. Monitoring never deletes a store automatically.'
        : 'Loading store statistics…';
    }

    function renderCommandCenterSummary(data) {
      var totals = data.totals || {};
      var highlights = data.highlights || {};
      GM_STATE.dataQuality = data.data_quality || {};
      GM_STATE.summaryByHandle = {};
      (data.stores || []).forEach(function(store){
        GM_STATE.summaryByHandle[String(store.handle || '')] = store;
        ensureStoreCard(store);
        renderStoreMetrics(store);
      });
      var statuses = { active: 0, sleeping: 0, waking: 0, closed: 0 };
      (data.stores || []).forEach(function(store){
        var status = String(store.status || 'active').toLowerCase();
        if (!Object.prototype.hasOwnProperty.call(statuses, status)) status = 'active';
        statuses[status] += 1;
      });
      document.getElementById('totalStoresHeader').textContent = formatNumber(totals.stores) + ' stores';
      document.getElementById('statusTotal').textContent = formatNumber(totals.stores);
      document.getElementById('statusActive').textContent = formatNumber(statuses.active);
      document.getElementById('statusSleeping').textContent = formatNumber(statuses.sleeping);
      document.getElementById('statusWaking').textContent = formatNumber(statuses.waking);
      document.getElementById('statusClosed').textContent = formatNumber(statuses.closed);
      GM_STATE.closedCount = statuses.closed;
      var closedToggle = document.getElementById('toggleGraveyard');
      if (closedToggle) {
        closedToggle.textContent = (document.getElementById('graveyardContent').hasAttribute('hidden') ? 'Show' : 'Hide')
          + ' Closed Stores (' + formatNumber(statuses.closed) + ')';
      }
      window.GM_ALL_STORES = (data.stores || []).map(function(store){
        return { handle: store.handle, name: store.name, collection_handle: store.collection_handle || store.handle };
      });
      renderNewStoreBanner();
      GM_STATE.metricsLoaded = true;
      document.getElementById('totalStoreCount').textContent = formatNumber(totals.stores);
      document.getElementById('totalGrossSales').textContent = totals.sales_observable === false ? 'Unavailable' : formatMoney(totals.gross_sales, totals.currency);
      document.getElementById('totalPaidOrders').textContent = totals.sales_observable === false ? 'Unavailable' : formatNumber(totals.paid_orders);
      document.getElementById('totalTrackedSessions').textContent = totals.sessions_observable === false ? 'Unavailable' : formatNumber(totals.tracked_sessions);
      document.getElementById('totalTaggedCustomers').textContent = totals.customers_observable === false ? 'Unavailable' : formatNumber(totals.unique_tagged_customers);
      document.getElementById('totalShoppers').textContent = totals.customers_observable === false ? 'Unavailable' : formatNumber(totals.unique_shoppers);
      document.getElementById('totalProducts').textContent = totals.products_observable === false ? 'Unavailable' : formatNumber(totals.products);
      document.getElementById('totalNeedsAttention').textContent = formatNumber(totals.needs_attention);
      document.getElementById('adminCoverage').textContent = 'Platform super-admins: ' + formatNumber(totals.platform_admins)
        + ' · Store-admin assignments: ' + formatNumber(totals.store_admin_memberships)
        + ' · No-traction reviews: ' + formatNumber(totals.review_candidates) + '.';
      document.getElementById('metricsCoverage').textContent = coverageLabel(totals.sales_coverage)
        + ' Session totals include all tracked visits; each store separately shows non-founder activity.';
      document.getElementById('performanceCard').setAttribute('aria-busy', 'false');

      var newestStore = highlights.newest_store;
      var newestProduct = highlights.newest_product;
      var latestSale = highlights.latest_purchase;
      var latestVisit = highlights.latest_non_super_admin_session;
      document.getElementById('highlightNewestStore').textContent = newestStore
        ? (newestStore.name + ' · ' + (newestStore.age_days === 0 ? 'today' : formatNumber(newestStore.age_days) + 'd old') + ' · ' + formatDate(newestStore.created_at))
        : 'Store age is not observable';
      document.getElementById('highlightNewestProduct').textContent = newestProduct
        ? (newestProduct.title + ' · ' + newestProduct.store_name + ' · ' + formatDate(newestProduct.created_at))
        : 'No attributed product found';
      document.getElementById('highlightLatestSale').textContent = latestSale
        ? ((latestSale.order_name || 'Order') + ' · ' + (latestSale.store_handle || 'store') + ' · ' + formatMoney(latestSale.gross_amount, latestSale.currency) + ' · ' + formatDate(latestSale.created_at))
        : (totals.sales_coverage === 'unavailable' ? 'Sales are not observable' : 'No attributed paid sale found');
      document.getElementById('highlightLatestVisit').textContent = latestVisit
        ? ((latestVisit.store_name || latestVisit.store_handle) + ' · ' + (latestVisit.customer_display_name || (latestVisit.visitor_type === 'anonymous' ? 'Anonymous visitor' : 'Signed-in member')) + ' · ' + formatDate(latestVisit.at))
        : 'No non-founder visit tracked yet';
      document.getElementById('latestChangesCard').setAttribute('aria-busy', 'false');

      var quality = data.data_quality || {};
      var qualityKeys = Object.keys(quality);
      var qualityBox = document.getElementById('metricsQuality');
      if (qualityKeys.length) {
        qualityBox.style.display = 'block';
        qualityBox.textContent = 'Some reporting is incomplete: ' + qualityKeys.join(', ').replace(/_/g, ' ') + '.';
      } else {
        qualityBox.style.display = 'none';
        qualityBox.textContent = '';
      }
      if (GM_STATE.currentStore) {
        renderManageStats(GM_STATE.summaryByHandle[GM_STATE.currentStore.handle]);
      }
      applyStoreFilters();
    }

    function loadCommandCenterSummary(forceRefresh) {
      var button = document.getElementById('refreshMetricsBtn');
      var coverage = document.getElementById('metricsCoverage');
      document.getElementById('performanceCard').setAttribute('aria-busy', 'true');
      if (button) button.disabled = true;
      if (coverage) coverage.textContent = forceRefresh ? 'Refreshing verified store data…' : 'Loading verified Shopify and storefront activity…';
      var endpoint = RAILWAY_URL + '/admin/command-center/summary' + (forceRefresh ? '?refresh=1' : '');
      fetch(endpoint, { method: 'GET', headers: railwayHeaders(), cache: 'no-store' })
        .then(function(response){
          return response.json().catch(function(){ return {}; }).then(function(body){
            if (!response.ok || !body.ok) throw new Error(body.error || 'Statistics request failed');
            return body;
          });
        })
        .then(renderCommandCenterSummary)
        .catch(function(error){
          GM_STATE.metricsLoaded = false;
          document.getElementById('performanceCard').setAttribute('aria-busy', 'false');
          document.getElementById('latestChangesCard').setAttribute('aria-busy', 'false');
          document.getElementById('metricsCoverage').textContent = 'Store statistics are unavailable: ' + error.message;
          document.getElementById('highlightNewestStore').textContent = 'Unavailable';
          document.getElementById('highlightNewestProduct').textContent = 'Unavailable';
          document.getElementById('highlightLatestSale').textContent = 'Unavailable';
          document.getElementById('highlightLatestVisit').textContent = 'Unavailable';
          showToast('Could not load store statistics', true);
        })
        .finally(function(){ if (button) button.disabled = false; });
    }

    function setStatus(id, text, color) {
      var el = document.getElementById(id);
      if (!el) return;
      el.textContent = text;
      if (color) el.style.color = color;
    }

    function showToast(msg, isError) {
      var el = document.getElementById('gmToast');
      if (!el) return;
      el.textContent = msg;
      el.style.background = isError ? 'var(--danger)' : 'var(--text)';
      el.style.display = 'block';
      clearTimeout(el._t);
      el._t = setTimeout(function(){ el.style.display = 'none'; }, 3200);
    }

    function getSeenStores() {
      return (localStorage.getItem('gm-seen-stores') || '').split(',').map(function(v){ return v.trim(); }).filter(Boolean);
    }

    function saveSeenStores(handles) {
      localStorage.setItem('gm-seen-stores', handles.join(','));
    }

    function markStoreSeen(handle) {
      var seen = getSeenStores();
      if (seen.indexOf(handle) === -1) {
        seen.push(handle);
        saveSeenStores(seen);
      }
      renderNewStoreBanner();
    }

    function markAllStoresSeen() {
      var allHandles = (window.GM_ALL_STORES || []).map(function(s){ return String(s.handle || '').trim(); }).filter(Boolean);
      saveSeenStores(allHandles);
      renderNewStoreBanner();
    }

    function renderNewStoreBanner() {
      var banner = document.getElementById('newStoreBanner');
      var list = document.getElementById('newStoreList');
      var title = document.getElementById('newStoreTitle');
      if (!banner || !list || !title) return;

      var seen = getSeenStores();
      var newStores = (window.GM_ALL_STORES || []).filter(function(store){
        var h = String(store.handle || '').trim();
        return h && seen.indexOf(h) === -1;
      });

      if (!newStores.length) {
        banner.style.display = 'none';
        list.innerHTML = '';
        return;
      }

      title.textContent = '🆕  ' + newStores.length + ' New Stores Built';
      list.innerHTML = newStores.map(function(store){
        var collectionHandle = store.collection_handle || store.handle;
        return '<div class="gm-banner-row">'
          + '<div class="gm-banner-name">' + escapeHtml(store.name || store.handle) + '</div>'
          + '<button type="button" class="gm-btn gm-btn-primary" data-peek-store="' + escapeHtml(store.handle) + '" data-peek-collection="' + escapeHtml(collectionHandle) + '">Peek →</button>'
          + '</div>';
      }).join('');

      banner.style.display = '';
    }

    function applyStoreFilters() {
      var search = String((document.getElementById('storeSearch') || {}).value || '').toLowerCase().trim();
      var allCards = Array.prototype.slice.call(document.querySelectorAll('.gm-store-card'));
      allCards.forEach(function(card){
        var name = String(card.getAttribute('data-name') || '').toLowerCase();
        var status = String(card.getAttribute('data-status') || 'active');
        var orderCountRaw = card.getAttribute('data-order-count') || 'unknown';
        var orderCount = orderCountRaw === 'unknown' ? null : parseInt(orderCountRaw, 10);
        var memberCountRaw = card.getAttribute('data-member-count') || 'unknown';
        var memberCount = memberCountRaw === 'unknown' ? null : parseInt(memberCountRaw, 10);
        var sessionCountRaw = card.getAttribute('data-session-count') || 'unknown';
        var sessionCount = sessionCountRaw === 'unknown' ? null : parseInt(sessionCountRaw, 10);
        var ageDaysRaw = card.getAttribute('data-age-days') || 'unknown';
        var ageDays = ageDaysRaw === 'unknown' ? null : parseInt(ageDaysRaw, 10);
        var inClosedGrid = card.closest('#closedStoreGrid') !== null;

        var statusMatches = true;
        if (GM_STATE.activeStatFilter === 'closed') statusMatches = inClosedGrid;
        else if (GM_STATE.activeStatFilter === 'sleeping') statusMatches = !inClosedGrid && status === 'sleeping';
        else if (GM_STATE.activeStatFilter === 'waking') statusMatches = !inClosedGrid && status === 'waking';
        else if (GM_STATE.activeStatFilter === 'active') statusMatches = !inClosedGrid && status !== 'sleeping' && status !== 'waking';
        else statusMatches = !inClosedGrid || !document.getElementById('graveyardContent').hasAttribute('hidden');

        var decisionMatches = true;
        if (GM_STATE.activeGridFilter === 'no-sales') {
          decisionMatches = !GM_STATE.dataQuality.sales && orderCount === 0;
        } else if (GM_STATE.activeGridFilter === 'no-members') {
          decisionMatches = !GM_STATE.dataQuality.customers && memberCount === 0;
        } else if (GM_STATE.activeGridFilter === 'no-sessions') {
          decisionMatches = !GM_STATE.dataQuality.sessions && card.getAttribute('data-tracking-started') === 'true' && sessionCount === 0;
        } else if (GM_STATE.activeGridFilter === 'attention') {
          decisionMatches = card.getAttribute('data-needs-attention') === 'true';
        } else if (GM_STATE.activeGridFilter === 'review') {
          decisionMatches = card.getAttribute('data-review-candidate') === 'true';
        } else if (GM_STATE.activeGridFilter === 'new') {
          decisionMatches = ageDays !== null && ageDays < 7;
        }

        var handle = String(card.getAttribute('data-handle') || '').toLowerCase();
        var matchesSearch = !search || name.indexOf(search) !== -1 || handle.indexOf(search) !== -1;
        card.style.display = statusMatches && decisionMatches && matchesSearch ? '' : 'none';
      });
      sortStoreCards();
    }

    function sortStoreCards() {
      var sort = String((document.getElementById('storeSort') || {}).value || GM_STATE.storeSort || 'newest');
      GM_STATE.storeSort = sort;
      document.querySelectorAll('.gm-store-grid').forEach(function(grid){
        var cards = Array.prototype.slice.call(grid.querySelectorAll(':scope > .gm-store-card'));
        cards.sort(function(a, b){
          function number(card, attr) {
            var raw = card.getAttribute(attr);
            var value = Number(raw);
            return raw && raw !== 'unknown' && Number.isFinite(value) ? value : null;
          }
          function descending(attr) {
            var av = number(a, attr);
            var bv = number(b, attr);
            if (av === null && bv === null) return 0;
            if (av === null) return 1;
            if (bv === null) return -1;
            return bv - av;
          }
          var compared = 0;
          if (sort === 'newest' || sort === 'oldest') {
            var at = Date.parse(a.getAttribute('data-created-at') || '');
            var bt = Date.parse(b.getAttribute('data-created-at') || '');
            var aValid = Number.isFinite(at);
            var bValid = Number.isFinite(bt);
            if (aValid && bValid) compared = sort === 'newest' ? bt - at : at - bt;
            else if (aValid !== bValid) compared = aValid ? -1 : 1;
          } else if (sort === 'sales') compared = descending('data-gross-sales');
          else if (sort === 'orders') compared = descending('data-order-count');
          else if (sort === 'members') compared = descending('data-member-count');
          else if (sort === 'sessions') compared = descending('data-session-count');
          else if (sort === 'products') compared = descending('data-products');
          if (compared !== 0) return compared;
          return String(a.getAttribute('data-name') || '').localeCompare(String(b.getAttribute('data-name') || ''));
        });
        cards.forEach(function(card){ grid.appendChild(card); });
      });
    }

    function setActiveClass(selector, targetAttr, value) {
      document.querySelectorAll(selector).forEach(function(btn){
        if (btn.getAttribute(targetAttr) === value) btn.classList.add('is-active-filter');
        else btn.classList.remove('is-active-filter');
      });
    }

    function syncGraveyardVisibilityForFilters() {
      var wantsClosed = GM_STATE.activeStatFilter === 'closed';
      var content = document.getElementById('graveyardContent');
      var toggle = document.getElementById('toggleGraveyard');
      if (!content || !toggle) return;
      if (wantsClosed && content.hasAttribute('hidden')) {
        content.removeAttribute('hidden');
        toggle.textContent = 'Hide Closed Stores (' + formatNumber(GM_STATE.closedCount) + ')';
      }
    }

    function openSheet(id) {
      var overlay = document.getElementById('sheetOverlay');
      if (overlay) overlay.classList.add('show');
      document.querySelectorAll('.gm-sheet').forEach(function(s){ s.classList.remove('show'); });
      var sheet = document.getElementById(id);
      if (sheet) sheet.classList.add('show');
    }

    function closeSheets() {
      var overlay = document.getElementById('sheetOverlay');
      if (overlay) overlay.classList.remove('show');
      document.querySelectorAll('.gm-sheet').forEach(function(s){ s.classList.remove('show'); });
    }

    function switchManageTab(tab) {
      document.querySelectorAll('.gm-sheet-tab[data-manage-tab]').forEach(function(btn){
        btn.classList.toggle('active', btn.getAttribute('data-manage-tab') === tab);
      });
      document.querySelectorAll('.gm-tab-pane[data-pane]').forEach(function(pane){
        pane.classList.toggle('active', pane.getAttribute('data-pane') === tab);
      });
      if (tab === 'people') loadMembers();
      if ((tab === 'overview' || tab === 'activity' || tab === 'products') && GM_STATE.currentStore) {
        renderManageStats(GM_STATE.summaryByHandle[GM_STATE.currentStore.handle]);
      }
    }

    function openManageFromCard(card) {
      if (!card) return;
      var handle = card.getAttribute('data-handle') || '';
      var collection = card.getAttribute('data-collection') || handle;
      var name = card.getAttribute('data-store-name') || handle;
      var products = parseInt(card.getAttribute('data-products') || '0', 10);

      GM_STATE.currentStore = {
        handle: handle,
        collection_handle: collection,
        name: name,
        products: products
      };

      document.getElementById('manageTitle').textContent = name;
      document.getElementById('manageHandle').textContent = '@' + handle;
      document.getElementById('openFullAdminBtn').href = '/pages/admin-powers?shop=' + encodeURIComponent(handle);
      document.getElementById('openProductAdminBtn').href = '/pages/admin-powers?shop=' + encodeURIComponent(handle);
      document.getElementById('infoHandle').textContent = handle;
      document.getElementById('infoJoinLink').textContent = 'https://stellasageco.com/pages/join-store?shop=' + handle;
      document.getElementById('infoProductCount').textContent = String(products);
      document.getElementById('infoVisitBtn').href = '/collections/' + encodeURIComponent(collection || handle);
      renderManageStats(GM_STATE.summaryByHandle[handle]);
      switchManageTab('overview');
      openSheet('manageSheet');
    }

    function copyText(text, successMsg) {
      if (!navigator.clipboard || !navigator.clipboard.writeText) {
        showToast('Clipboard not available', true);
        return;
      }
      navigator.clipboard.writeText(String(text || '')).then(function(){
        showToast(successMsg || 'Copied');
      }).catch(function(){
        showToast('Copy failed', true);
      });
    }

    function handleMemberAction(mode) {
      var store = GM_STATE.currentStore;
      if (!store || !store.handle) return;
      var email = String((document.getElementById('memberEmail') || {}).value || '').trim();
      if (!email) {
        setStatus('memberStatus', 'Please enter an email.', 'var(--danger)');
        return;
      }

      var role = String((document.getElementById('memberRole') || {}).value || 'member');
      var endpoint = '';
      if (mode === 'add') endpoint = role === 'admin' ? '/store/' + encodeURIComponent(store.handle) + '/add-admin' : '/store/' + encodeURIComponent(store.handle) + '/add-member';
      if (mode === 'remove-member') endpoint = '/store/' + encodeURIComponent(store.handle) + '/remove-member';
      if (mode === 'remove-admin') endpoint = '/store/' + encodeURIComponent(store.handle) + '/remove-admin';

      setStatus('memberStatus', 'Saving member changes...', 'var(--gray)');
      fetch(RAILWAY_URL + endpoint, {
        method: 'POST',
        headers: railwayHeaders(),
        body: JSON.stringify({ email: email })
      })
      .then(function(r){ return r.json(); })
      .then(function(data){
        if (data.ok || data.status === 'ok') {
          setStatus('memberStatus', '✅ Member update complete.', 'var(--success)');
          document.getElementById('memberEmail').value = '';
          loadMembers();
        } else {
          setStatus('memberStatus', '❌ ' + (data.error || 'Request failed'), 'var(--danger)');
        }
      })
      .catch(function(err){
        setStatus('memberStatus', '❌ ' + err.message, 'var(--danger)');
      });
    }

    function loadMembers() {
      var list = document.getElementById('memberList');
      var store = GM_STATE.currentStore;
      if (!list || !store || !store.handle) return;
      list.innerHTML = '<div class="gm-member-row"><span>Loading members...</span></div>';
      fetch(RAILWAY_URL + '/store/' + encodeURIComponent(store.handle) + '/members', {
        method: 'GET',
        headers: railwayHeaders()
      })
      .then(function(r){ return r.json(); })
      .then(function(data){
        var rows = [];
        var members = [];
        if (Array.isArray(data.members)) members = data.members;
        else if (Array.isArray(data.items)) members = data.items;
        else if (Array.isArray(data.data)) members = data.data;

        members.forEach(function(item){
          var email = item.email || item.customer_email || item.value || '';
          if (!email) return;
          var role = 'Member';
          if (item.role) role = item.role;
          else if (item.is_admin) role = 'Admin';
          rows.push('<div class="gm-member-row"><span>' + escapeHtml(email) + '</span><strong>' + escapeHtml(role) + '</strong></div>');
        });

        if (!rows.length) rows.push('<div class="gm-member-row"><span>No members found.</span></div>');
        list.innerHTML = rows.join('');
      })
      .catch(function(){
        list.innerHTML = '<div class="gm-member-row"><span>Could not load members.</span></div>';
      });
    }

    function updateVisibility(visibility) {
      var store = GM_STATE.currentStore;
      if (!store || !store.handle) return;
      setStatus('settingsStatus', 'Updating visibility...', 'var(--gray)');
      fetch(RAILWAY_URL + '/store/' + encodeURIComponent(store.handle) + '/visibility', {
        method: 'POST',
        headers: railwayHeaders(),
        body: JSON.stringify({ visibility: visibility })
      })
      .then(function(r){ return r.json(); })
      .then(function(data){
        if (data.ok || data.status === 'ok') setStatus('settingsStatus', '✅ Visibility updated.', 'var(--success)');
        else setStatus('settingsStatus', '❌ ' + (data.error || 'Failed'), 'var(--danger)');
      })
      .catch(function(err){ setStatus('settingsStatus', '❌ ' + err.message, 'var(--danger)'); });
    }

    function sleepStore(handle) {
      if (!handle || !confirm('Put store "' + handle + '" to sleep?')) return;
      fetch(RAILWAY_URL + '/store/' + encodeURIComponent(handle) + '/sleep', {
        method: 'POST',
        headers: railwayHeaders()
      })
      .then(function(r){ return r.json(); })
      .then(function(data){
        if (data.job_id || data.status === 'ok') {
          showToast('✅ Store put to sleep.');
          window.location.reload();
        } else {
          showToast('❌ ' + (data.error || 'Sleep failed'), true);
        }
      })
      .catch(function(err){ showToast('❌ ' + err.message, true); });
    }

    function wakeStore(handle) {
      if (!handle || !confirm('Wake store "' + handle + '" now?')) return;
      fetch(RAILWAY_URL + '/store/' + encodeURIComponent(handle) + '/wakeup', {
        method: 'POST',
        headers: railwayHeaders()
      })
      .then(function(r){ return r.json(); })
      .then(function(data){
        if (data.job_id || data.status === 'ok') {
          showToast('✅ Store waking up.');
          window.location.reload();
        } else {
          showToast('❌ ' + (data.error || 'Wake failed'), true);
        }
      })
      .catch(function(err){ showToast('❌ ' + err.message, true); });
    }

    function nukeStore(handle) {
      if (!handle) return;
      var summary = GM_STATE.summaryByHandle[handle];
      if (!summary || !(summary.decision || {}).review_candidate) {
        if (!confirm('Monitoring has not established a complete 7-day no-traction window for "' + handle + '". Continue to the deletion confirmation anyway?')) return;
      }
      var typed = prompt('This permanently deletes store "' + handle + '". Type the exact store handle to continue:');
      if (String(typed || '').trim().toLowerCase() !== String(handle).toLowerCase()) {
        showToast('Deletion cancelled — handle did not match.', true);
        return;
      }
      fetch(RAILWAY_URL + '/storefront/' + encodeURIComponent(handle) + '/nuke', {
        method: 'POST',
        headers: railwayHeaders(),
        body: JSON.stringify({})
      })
      .then(function(r){ return r.json(); })
      .then(function(data){
        if (!data.job_id) {
          showToast('❌ ' + (data.error || 'Nuke failed'), true);
          return;
        }
        showToast('☢️ Nuke started.');
        var tries = 0;
        var timer = setInterval(function(){
          tries += 1;
          fetch(RAILWAY_URL + '/job/' + encodeURIComponent(data.job_id), { headers: railwayHeaders() })
            .then(function(r){ return r.json(); })
            .then(function(job){
              if (job.status === 'done') {
                clearInterval(timer);
                showToast('✅ Store nuked.');
                window.location.reload();
              } else if (job.status === 'error') {
                clearInterval(timer);
                showToast('❌ ' + (job.error || 'Nuke failed'), true);
              }
            })
            .catch(function(){});
          if (tries > 35) {
            clearInterval(timer);
            showToast('⚠️ Nuke status timed out.', true);
          }
        }, 3000);
      })
      .catch(function(err){ showToast('❌ ' + err.message, true); });
    }

    function runPrintful(inputId, statusId) {
      var handle = String((document.getElementById(inputId) || {}).value || '').trim();
      if (!handle) {
        setStatus(statusId, 'Enter a store handle.', 'var(--danger)');
        return;
      }
      setStatus(statusId, 'Running Printful wake...', 'var(--gray)');
      fetch(RAILWAY_URL + '/store/' + encodeURIComponent(handle) + '/wakeup', {
        method: 'POST',
        headers: railwayHeaders()
      })
      .then(function(r){ return r.json(); })
      .then(function(data){
        if (data.job_id || data.status === 'ok') setStatus(statusId, '✅ Printful started for ' + handle, 'var(--success)');
        else setStatus(statusId, '❌ ' + (data.error || 'Failed'), 'var(--danger)');
      })
      .catch(function(err){ setStatus(statusId, '❌ ' + err.message, 'var(--danger)'); });
    }

    function sleepAllInactive() {
      if (!confirm('Run sleep-check for inactive stores?')) return;
      setStatus('sleepAllStatus', 'Running...', 'var(--gray)');
      setStatus('sleepAllStatus_m', 'Running...', 'var(--gray)');
      fetch(RAILWAY_URL + '/admin/sleep-check', {
        method: 'POST',
        headers: railwayHeaders()
      })
      .then(function(r){ return r.json(); })
      .then(function(data){
        var msg = (data.ok || data.status === 'ok' || data.slept !== undefined)
          ? ('✅ Done' + (data.slept !== undefined ? '. ' + data.slept + ' slept.' : '.'))
          : ('❌ ' + (data.error || 'Failed'));
        var color = (data.ok || data.status === 'ok' || data.slept !== undefined) ? 'var(--success)' : 'var(--danger)';
        setStatus('sleepAllStatus', msg, color);
        setStatus('sleepAllStatus_m', msg, color);
      })
      .catch(function(err){
        setStatus('sleepAllStatus', '❌ ' + err.message, 'var(--danger)');
        setStatus('sleepAllStatus_m', '❌ ' + err.message, 'var(--danger)');
      });
    }

    function bindPriceOverride(buttonId, tagId, priceId, statusId) {
      var button = document.getElementById(buttonId);
      if (!button) return;
      button.addEventListener('click', function(){
        var tag = String((document.getElementById(tagId) || {}).value || '').trim();
        var price = String((document.getElementById(priceId) || {}).value || '').trim();
        if (!tag || !price) {
          setStatus(statusId, 'Please fill in tag and price.', 'var(--danger)');
          return;
        }
        setStatus(statusId, 'Updating prices...', 'var(--gray)');
        fetch(RAILWAY_URL + '/admin/price-override', {
          method: 'POST',
          headers: railwayHeaders(),
          body: JSON.stringify({ tag: tag, price: parseFloat(price) })
        })
        .then(function(r){ return r.json(); })
        .then(function(data){
          if (data.ok || data.status === 'ok') setStatus(statusId, '✅ Prices updated.', 'var(--success)');
          else setStatus(statusId, '❌ ' + (data.error || 'Failed'), 'var(--danger)');
        })
        .catch(function(err){ setStatus(statusId, '❌ ' + err.message, 'var(--danger)'); });
      });
    }

    document.getElementById('focusSearch').addEventListener('click', function(){
      var input = document.getElementById('storeSearch');
      if (input) input.focus();
    });

    document.getElementById('storeSearch').addEventListener('input', applyStoreFilters);
    document.getElementById('storeSort').addEventListener('change', applyStoreFilters);

    document.querySelectorAll('[data-grid-filter]').forEach(function(btn){
      btn.addEventListener('click', function(){
        GM_STATE.activeGridFilter = btn.getAttribute('data-grid-filter') || 'all';
        setActiveClass('[data-grid-filter]', 'data-grid-filter', GM_STATE.activeGridFilter);
        syncGraveyardVisibilityForFilters();
        applyStoreFilters();
      });
    });

    document.querySelectorAll('[data-stat-filter]').forEach(function(btn){
      btn.addEventListener('click', function(){
        GM_STATE.activeStatFilter = btn.getAttribute('data-stat-filter') || 'all';
        setActiveClass('[data-stat-filter]', 'data-stat-filter', GM_STATE.activeStatFilter);
        syncGraveyardVisibilityForFilters();
        applyStoreFilters();
      });
    });

    document.getElementById('toggleGraveyard').addEventListener('click', function(){
      var content = document.getElementById('graveyardContent');
      var isHidden = content.hasAttribute('hidden');
      if (isHidden) {
        content.removeAttribute('hidden');
        this.textContent = 'Hide Closed Stores (' + formatNumber(GM_STATE.closedCount) + ')';
      } else {
        content.setAttribute('hidden', 'hidden');
        this.textContent = 'Show Closed Stores (' + formatNumber(GM_STATE.closedCount) + ')';
      }
      applyStoreFilters();
    });

    document.querySelectorAll('.gm-store-grid').forEach(function(grid){
      grid.addEventListener('click', function(event){
        var wakeTarget = event.target.closest('[data-wake-handle]');
        if (wakeTarget) {
          wakeStore(wakeTarget.getAttribute('data-wake-handle') || '');
          return;
        }
        var target = event.target.closest('[data-open-manage]');
        if (!target) return;
        var card = target.closest('.gm-store-card');
        openManageFromCard(card);
      });
    });

    document.getElementById('sheetOverlay').addEventListener('click', closeSheets);
    document.getElementById('closeManage').addEventListener('click', closeSheets);
    document.getElementById('openToolsFab').addEventListener('click', function(){ openSheet('toolsSheet'); });
    document.getElementById('closeTools').addEventListener('click', closeSheets);

    document.querySelectorAll('.gm-sheet-tab[data-manage-tab]').forEach(function(tabBtn){
      tabBtn.addEventListener('click', function(){ switchManageTab(tabBtn.getAttribute('data-manage-tab')); });
    });

    document.getElementById('addMemberBtn').addEventListener('click', function(){ handleMemberAction('add'); });
    document.getElementById('removeMemberBtn').addEventListener('click', function(){ handleMemberAction('remove-member'); });
    document.getElementById('removeAdminBtn').addEventListener('click', function(){ handleMemberAction('remove-admin'); });

    document.getElementById('makePublicBtn').addEventListener('click', function(){ updateVisibility('public'); });
    document.getElementById('makePrivateBtn').addEventListener('click', function(){ updateVisibility('private'); });
    document.getElementById('sleepStoreBtn').addEventListener('click', function(){ if (GM_STATE.currentStore) sleepStore(GM_STATE.currentStore.handle); });
    document.getElementById('wakeStoreBtn').addEventListener('click', function(){ if (GM_STATE.currentStore) wakeStore(GM_STATE.currentStore.handle); });
    document.getElementById('nukeStoreBtn').addEventListener('click', function(){ if (GM_STATE.currentStore) nukeStore(GM_STATE.currentStore.handle); });

    document.getElementById('copyHandleBtn').addEventListener('click', function(){
      if (!GM_STATE.currentStore) return;
      copyText(GM_STATE.currentStore.handle, 'Handle copied');
    });

    document.getElementById('copyJoinBtn').addEventListener('click', function(){
      if (!GM_STATE.currentStore) return;
      copyText('https://stellasageco.com/pages/join-store?shop=' + GM_STATE.currentStore.handle, 'Join link copied');
    });

    document.getElementById('newStoreBanner').addEventListener('click', function(event){
      var peekBtn = event.target.closest('[data-peek-store]');
      if (!peekBtn) return;
      var storeHandle = peekBtn.getAttribute('data-peek-store') || '';
      var collection = peekBtn.getAttribute('data-peek-collection') || storeHandle;
      if (collection) window.open('/collections/' + encodeURIComponent(collection), '_blank', 'noopener');
      if (storeHandle) markStoreSeen(storeHandle);
    });

    document.getElementById('markAllSeenBtn').addEventListener('click', markAllStoresSeen);
    document.getElementById('refreshMetricsBtn').addEventListener('click', function(){
      loadCommandCenterSummary(true);
    });

    bindPriceOverride('btnUpdatePrice', 'targetTag', 'newPrice', 'priceStatus');
    bindPriceOverride('btnUpdatePrice_m', 'targetTag_m', 'newPrice_m', 'priceStatus_m');

    renderNewStoreBanner();
    applyStoreFilters();
    loadCommandCenterSummary(false);
  </script>
{% endif %}

</body>
