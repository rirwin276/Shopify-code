        ? (observable.products === false ? 'Product data is unavailable' : formatNumber(products.total) + ' total · ' + formatNumber(products.live) + ' live · ' + formatNumber(products.draft) + ' draft · ' + formatNumber(products.archived) + ' archived')
        : 'Statistics have not loaded yet';
