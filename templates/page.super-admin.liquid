{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Stella & Sage — Command Center</title>
<style>
  :root {
    --bg: #f5f5f7;
    --card: #ffffff;
    --border: #d1d1d6;
    --text: #1c1c1e;
    --gray: #6e6e73;
    --accent: #0071e3;
    --danger: #ff3b30;
    --warning: #ff9f0a;
    --success: #34c759;
    --radius: 14px;
    --font: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    padding: 0 0 100px;
  }

  .gm-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 14px 70px;
  }

  .gm-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(245, 245, 247, 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
    margin-bottom: 12px;
  }

  .gm-header-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .gm-title {
    margin: 0;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .gm-count-badge {
    background: var(--card);
    border: 1px solid var(--border);
    color: var(--gray);
    border-radius: 99px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 700;
  }

  .gm-search-icon {
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text);
    border-radius: 10px;
    min-height: 44px;
    min-width: 44px;
    padding: 0;
    font-size: 18px;
    cursor: pointer;
  }

  .gm-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px;
    margin-bottom: 12px;
  }

  .gm-banner-title {
    margin: 0 0 10px;
    font-size: 18px;
    font-weight: 800;
  }

  .gm-banner-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 10px;
  }

  .gm-banner-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 10px;
  }

  .gm-banner-name {
    font-size: 14px;
    font-weight: 700;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gm-pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .gm-pill-row .gm-pill {
    flex: 1 0 calc(33.333% - 6px);
  }

  .gm-filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .gm-filter-tabs .gm-filter-tab {
    flex: 1 0 calc(50% - 4px);
  }

  .gm-pill,
  .gm-filter-tab {
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text);
    border-radius: 999px;
    min-height: 44px;
    padding: 0 14px;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .is-active-filter {
    background: var(--text);
    color: #fff;
    border-color: var(--text);
  }

  .gm-search-input {
    width: 100%;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text);
    border-radius: 12px;
    min-height: 44px;
    padding: 0 14px;
    font-size: 15px;
    margin-bottom: 10px;
  }

  .gm-toolbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 150px;
    gap: 8px;
    align-items: end;
    margin-bottom: 10px;
  }

  .gm-toolbar .gm-search-input { margin-bottom: 0; }

  .gm-sort-label {
    display: grid;
    gap: 4px;
    color: var(--gray);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .gm-highlight-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .gm-highlight {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 10px;
    min-width: 0;
  }

  .gm-highlight span {
    display: block;
    color: var(--gray);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
    margin-bottom: 5px;
  }

  .gm-highlight strong {
    display: block;
    font-size: 13px;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .gm-store-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .gm-store-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px;
  }

  .gm-store-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 10px;
  }

  .gm-store-name {
    margin: 0;
    font-size: 20px;
    font-weight: 800;
    line-height: 1.15;
  }

  .gm-store-handle {
    margin-top: 4px;
    color: var(--gray);
    font-size: 12px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
  }

  .gm-badge {
    border-radius: 999px;
    border: 1px solid var(--border);
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
  }

  .gm-badge.active { color: var(--success); border-color: rgba(52,199,89,0.35); background: rgba(52,199,89,0.08); }
  .gm-badge.sleeping { color: #5856d6; border-color: rgba(88,86,214,0.35); background: rgba(88,86,214,0.08); }
  .gm-badge.waking { color: var(--accent); border-color: rgba(0,113,227,0.35); background: rgba(0,113,227,0.08); }
  .gm-badge.private { color: var(--warning); border-color: rgba(255,159,10,0.35); background: rgba(255,159,10,0.08); }
  .gm-badge.closed { color: var(--gray); }

  .gm-decision-badge {
    display: none;
    width: fit-content;
    margin: -2px 0 10px;
    border-radius: 999px;
    border: 1px solid #fed7aa;
    background: #fff7ed;
    color: #9a3412;
    padding: 5px 9px;
    font-size: 11px;
    font-weight: 800;
  }

  .gm-decision-badge.show { display: block; }

  .gm-decision-badge.good {
    border-color: rgba(52,199,89,0.35);
    background: rgba(52,199,89,0.08);
    color: #167c35;
  }

  .gm-decision-note {
    border: 1px solid #fed7aa;
    background: #fff7ed;
    color: #7c2d12;
    border-radius: 12px;
    padding: 11px;
    margin-bottom: 10px;
    font-size: 12px;
    line-height: 1.45;
  }

  .gm-decision-note.good {
    border-color: rgba(52,199,89,0.35);
    background: rgba(52,199,89,0.08);
    color: #166534;
  }

  .gm-card-actions {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 8px;
  }

  .gm-btn {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card);
    color: var(--text);
    min-height: 44px;
    padding: 0 12px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .gm-btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .gm-btn-danger { background: var(--danger); border-color: var(--danger); color: #fff; }
  .gm-btn-warning { background: #fff7ed; border-color: #fed7aa; color: #9a3412; }

  .gm-section-title {
    margin: 0 0 10px;
    font-size: 15px;
    font-weight: 800;
  }

  .gm-section-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .gm-section-head .gm-section-title { margin-bottom: 3px; }

  .gm-muted {
    margin: 0;
    color: var(--gray);
    font-size: 12px;
    line-height: 1.45;
  }

  .gm-kpi-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .gm-kpi {
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 11px;
    background: #fafafa;
  }

  .gm-kpi-label {
    display: block;
    color: var(--gray);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .gm-kpi-value {
    display: block;
    margin-top: 5px;
    font-size: 20px;
    font-weight: 800;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .gm-store-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px;
    margin: 0 0 10px;
  }

  .gm-store-metric {
    border: 1px solid #e5e5ea;
    border-radius: 10px;
    padding: 8px;
    min-width: 0;
    background: #fafafa;
  }

  .gm-store-metric span {
    display: block;
    color: var(--gray);
    font-size: 10px;
    font-weight: 700;
    margin-bottom: 3px;
  }

  .gm-store-metric strong {
    display: block;
    font-size: 14px;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .gm-store-activity {
    border-top: 1px solid #ececf0;
    padding-top: 9px;
    margin: 0 0 10px;
    display: grid;
    gap: 5px;
    color: var(--gray);
    font-size: 11px;
    line-height: 1.4;
  }

  .gm-store-activity strong { color: var(--text); }

  .gm-detail-list {
    display: grid;
    gap: 8px;
  }

  .gm-detail-row {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px;
  }

  .gm-detail-row span {
    display: block;
    color: var(--gray);
    font-size: 11px;
    font-weight: 700;
    margin-bottom: 4px;
  }

  .gm-detail-row strong {
    display: block;
    font-size: 13px;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .gm-quality-warning {
    display: none;
    margin-top: 10px;
    border: 1px solid #fed7aa;
    background: #fff7ed;
    color: #9a3412;
    border-radius: 10px;
    padding: 9px 10px;
    font-size: 11px;
    line-height: 1.45;
  }

  .gm-graveyard-toggle {
    width: 100%;
  }

  .gm-graveyard-content[hidden] { display: none; }

  .gm-closed-card {
    opacity: 0.7;
    border-style: dashed;
  }

  .gm-sheet-overlay {
    position: fixed;
    inset: 0;
    background: rgba(28,28,30,0.35);
    z-index: 90;
    display: none;
  }

  .gm-sheet-overlay.show { display: block; }

  .gm-sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--card);
    border-top: 1px solid var(--border);
    border-radius: 16px 16px 0 0;
    z-index: 100;
    transform: translateY(102%);
    transition: transform .22s ease;
    max-height: 88vh;
    overflow: auto;
    padding: 14px;
  }

  .gm-sheet.show { transform: translateY(0); }

  .gm-sheet-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .gm-sheet-title {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.15;
  }

  .gm-sheet-sub {
    margin: 4px 0 0;
    color: var(--gray);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size: 12px;
  }

  .gm-close {
    border: 1px solid var(--border);
    background: var(--card);
    border-radius: 10px;
    min-height: 44px;
    min-width: 44px;
    font-size: 20px;
    cursor: pointer;
  }

  .gm-sheet-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 10px;
    overflow-x: auto;
    padding-bottom: 2px;
    -webkit-overflow-scrolling: touch;
  }

  .gm-sheet-tab {
    flex: 0 0 auto;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--card);
    font-weight: 700;
    cursor: pointer;
  }

  .gm-sheet-tab.active {
    background: var(--text);
    border-color: var(--text);
    color: #fff;
  }

  .gm-tab-pane { display: none; }
  .gm-tab-pane.active { display: block; }

  .gm-field { margin-bottom: 10px; }
  .gm-label { display: block; margin-bottom: 6px; font-size: 12px; color: var(--gray); font-weight: 700; }

  .gm-input,
  .gm-select {
    width: 100%;
    min-height: 44px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card);
    color: var(--text);
    padding: 0 12px;
    font-size: 14px;
  }

  .gm-member-grid,
  .gm-setting-grid,
  .gm-tools-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .gm-status-text {
    margin-top: 8px;
    min-height: 18px;
    font-size: 12px;
    color: var(--gray);
  }

  .gm-member-list {
    margin-top: 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
  }

  .gm-member-row {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 10px;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
  }

  .gm-member-row:last-child { border-bottom: none; }

  .gm-log-row {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 10px;
    padding: 10px;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
    line-height: 1.4;
  }

  .gm-log-row:last-child { border-bottom: none; }
  .gm-log-time { color: var(--gray); }
  .gm-log-event { overflow-wrap: anywhere; }

  .gm-copy-row {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px;
    margin-bottom: 8px;
  }

  .gm-copy-label {
    font-size: 11px;
    color: var(--gray);
    font-weight: 700;
    margin-bottom: 4px;
  }

  .gm-copy-value {
    word-break: break-all;
    font-size: 13px;
    margin-bottom: 8px;
  }

  .gm-fab {
    position: fixed;
    right: 14px;
    bottom: 14px;
    z-index: 50;
    min-width: 52px;
    min-height: 52px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--text);
    color: #fff;
    font-size: 22px;
    cursor: pointer;
  }

  .gm-tools-desktop { display: none; }

  .gm-toast {
    position: fixed;
    left: 50%;
    bottom: 76px;
    transform: translateX(-50%);
    background: var(--text);
    color: #fff;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 13px;
    z-index: 120;
    display: none;
  }

  @media (min-width: 901px) {
    .gm-page {
      max-width: 1200px;
      padding-right: 320px;
    }

    .gm-header-inner {
      max-width: 1200px;
      padding-right: 334px;
    }

    .gm-store-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    .gm-kpi-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }

    .gm-filter-tabs .gm-filter-tab { flex: 0 0 auto; }

    .gm-pill-row .gm-pill { flex: 0 0 auto; }

    .gm-highlight-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }

    .gm-sheet {
      left: 50%;
      right: auto;
      width: min(680px, calc(100vw - 40px));
      transform: translate(-50%, 102%);
      border-radius: 16px;
      border: 1px solid var(--border);
      bottom: 20px;
      box-shadow: 0 16px 44px rgba(0,0,0,0.16);
    }

    .gm-sheet.show { transform: translate(-50%, 0); }

    .gm-member-grid { grid-template-columns: 1fr 180px; }

    .gm-fab,
    #toolsSheet { display: none; }

    .gm-tools-desktop {
      display: block;
      position: fixed;
      top: 82px;
      right: 14px;
      width: 280px;
      z-index: 20;
    }
  }

  @media (max-width: 480px) {
    .gm-toolbar { grid-template-columns: 1fr; }
    .gm-card-actions { grid-template-columns: 1fr 1fr; }
    .gm-card-actions .gm-btn:first-child { grid-column: span 2; }
  }
</style>
</head>
<body>

{% capture platform_access_value %}{% render 'platform-super-admin' %}{% endcapture %}
{% assign platform_access_value = platform_access_value | strip %}
{% assign is_super = false %}
{% if platform_access_value == 'true' %}{% assign is_super = true %}{% endif %}
{% unless is_super %}
  <script>window.location.replace('/pages/portal');</script>
{% endunless %}

{% if is_super %}
  {% assign total_stores = 0 %}
  {% assign active_count = 0 %}
  {% assign sleeping_count = 0 %}
  {% assign waking_count = 0 %}
  {% assign closed_count = 0 %}

  {% for store in shop.metaobjects.custom_shop.values %}
    {% assign total_stores = total_stores | plus: 1 %}
    {% assign _status = '' %}
    {% for f in store.fields %}
      {% if f.key == 'status' %}{% assign _status = f.value %}{% endif %}
    {% endfor %}
    {% if _status == blank %}{% assign _status = store.status.value | default: store.status | default: '' %}{% endif %}
    {% assign _status = _status | strip | downcase %}
    {% if store.tags contains 'status:closed' %}
      {% assign closed_count = closed_count | plus: 1 %}
    {% elsif _status == 'sleeping' %}
      {% assign sleeping_count = sleeping_count | plus: 1 %}
    {% elsif _status == 'waking' %}
      {% assign waking_count = waking_count | plus: 1 %}
    {% else %}
      {% assign active_count = active_count | plus: 1 %}
    {% endif %}
  {% endfor %}

  <header class="gm-header">
    <div class="gm-header-inner">
      <h1 class="gm-title">Command Center <span class="gm-count-badge" id="totalStoresHeader">{{ total_stores }} stores</span></h1>
      <button class="gm-search-icon" type="button" id="focusSearch" aria-label="Focus search">⌕</button>
    </div>
  </header>

  <div class="gm-page">
    <div class="gm-card" id="newStoreBanner" style="display:none;">
      <h2 class="gm-banner-title" id="newStoreTitle"></h2>
      <div class="gm-banner-list" id="newStoreList"></div>
      <button type="button" class="gm-btn gm-btn-primary" id="markAllSeenBtn">Mark all seen ✓</button>
    </div>

    <section class="gm-card">
      <h2 class="gm-section-title">Store status</h2>
      <div class="gm-pill-row" id="statsPills">
        <button type="button" class="gm-pill is-active-filter" data-stat-filter="all">Total <span id="statusTotal">{{ total_stores }}</span></button>
        <button type="button" class="gm-pill" data-stat-filter="active">Active <span id="statusActive">{{ active_count }}</span></button>
        <button type="button" class="gm-pill" data-stat-filter="sleeping">Sleeping <span id="statusSleeping">{{ sleeping_count }}</span></button>
        <button type="button" class="gm-pill" data-stat-filter="waking">Waking <span id="statusWaking">{{ waking_count }}</span></button>
        <button type="button" class="gm-pill" data-stat-filter="closed">Closed <span id="statusClosed">{{ closed_count }}</span></button>
      </div>
    </section>

    <section class="gm-card" id="performanceCard" aria-busy="true">
      <div class="gm-section-head">
        <div>
          <h2 class="gm-section-title">All-store performance</h2>
          <p class="gm-muted" id="metricsCoverage">Loading verified Shopify and storefront activity…</p>
        </div>
        <button type="button" class="gm-btn" id="refreshMetricsBtn">Refresh</button>
      </div>
      <div class="gm-kpi-grid">
        <div class="gm-kpi"><span class="gm-kpi-label">Stores</span><strong class="gm-kpi-value" id="totalStoreCount">—</strong></div>
        <div class="gm-kpi"><span class="gm-kpi-label">Gross sales</span><strong class="gm-kpi-value" id="totalGrossSales">—</strong></div>
        <div class="gm-kpi"><span class="gm-kpi-label">Paid orders</span><strong class="gm-kpi-value" id="totalPaidOrders">—</strong></div>
        <div class="gm-kpi"><span class="gm-kpi-label">Members</span><strong class="gm-kpi-value" id="totalTaggedCustomers">—</strong></div>
        <div class="gm-kpi"><span class="gm-kpi-label">Non-admin members</span><strong class="gm-kpi-value" id="totalShoppers">—</strong></div>
        <div class="gm-kpi"><span class="gm-kpi-label">Tracked sessions</span><strong class="gm-kpi-value" id="totalTrackedSessions">—</strong></div>
        <div class="gm-kpi"><span class="gm-kpi-label">Products</span><strong class="gm-kpi-value" id="totalProducts">—</strong></div>
        <div class="gm-kpi"><span class="gm-kpi-label">Needs attention</span><strong class="gm-kpi-value" id="totalNeedsAttention">—</strong></div>
      </div>
      <p class="gm-muted" id="adminCoverage" style="margin-top:10px;">Platform admins: —</p>
      <div class="gm-quality-warning" id="metricsQuality"></div>
