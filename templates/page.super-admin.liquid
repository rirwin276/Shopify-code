                <div class="gm-store-metric"><span>Gross sales</span><strong data-metric="gross">—</strong></div>
                <div class="gm-store-metric"><span>Members</span><strong data-metric="members">—</strong></div>
                <div class="gm-store-metric"><span>Sessions</span><strong data-metric="sessions">—</strong></div>
