                {% elsif _is_waking %}
                  <span class="gm-badge waking">Waking</span>
                {% elsif _is_private %}
                  <span class="gm-badge private">Private</span>
                {% else %}
                  <span class="gm-badge active">Active</span>
                {% endif %}
              </div>
              <div class="gm-decision-badge" data-decision-badge></div>
              <div class="gm-store-metrics" data-store-metrics="{{ store.system.handle | escape }}">
