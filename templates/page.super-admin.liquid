  <script>
    // Admin actions are proxied through the Shopify App Proxy relay. The raw
    // admin secret is never exposed to the browser — auth is the App Proxy
    // signature + the logged-in customer's admin tag, verified server-side.
    const RAILWAY_URL = "/apps/ss/relay";

    window.GM_ALL_STORES = [
      {% for store in shop.metaobjects.custom_shop.values %}
        {
          handle: {{ store.system.handle | json }},
          name: {{ store.name | default: store.system.handle | json }},
          collection_handle: {{ store.collection_handle | default: store.system.handle | json }}
        },
      {% endfor %}
    ];

    const GM_STATE = {
      activeGridFilter: 'all',
      activeStatFilter: 'all',
      currentStore: null,
      summaryByHandle: {},
      dataQuality: {},
      metricsLoaded: false,
      storeSort: 'newest',
      closedCount: Number({{ closed_count | json }})
    };

    function railwayHeaders() {
      return {
        'Content-Type': 'application/json'
      };
    }

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function formatNumber(value) {
      var number = Number(value || 0);
      return Number.isFinite(number) ? new Intl.NumberFormat().format(number) : '0';
    }

    function formatMoney(amount, currency) {
      var number = Number(amount || 0);
      if (!Number.isFinite(number)) return '—';
      try {
        return new Intl.NumberFormat(undefined, {
          style: 'currency',
          currency: currency || 'USD',
          maximumFractionDigits: 2
        }).format(number);
      } catch (_error) {
        return '$' + number.toFixed(2);
      }
    }

    function formatDate(value) {
      if (!value) return 'Never';
      var date = new Date(value);
      if (!Number.isFinite(date.getTime())) return 'Unknown time';
      return date.toLocaleString(undefined, {
        year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit'
      });
    }

    function coverageLabel(value) {
      if (value === 'lifetime') return 'Sales coverage: lifetime Shopify order history.';
      if (value === 'last_60_days') return 'Sales coverage: Shopify’s available last 60 days. Add read_all_orders for lifetime totals.';
      if (String(value || '').indexOf('first_') === 0) return 'Sales coverage is capped; totals are partial.';
      return 'Sales coverage is not currently observable.';
    }

    function purchaseText(store) {
      var purchase = store && store.sales && store.sales.last_purchase;
      if (store && store.sales && store.sales.observable === false) return 'Sales are not observable right now';
      if (!purchase) return 'No attributed paid purchase found';
      return (purchase.order_name || 'Order') + ' · '
        + (purchase.customer_display_name || 'Guest') + ' · '
        + formatMoney(purchase.gross_amount, purchase.currency) + ' · '
        + formatDate(purchase.created_at);
    }

    function otherVisitText(store) {
      if (store && store.observability && store.observability.sessions === false) return 'Session data is unavailable';
      var visit = store && store.activity && store.activity.last_non_super_admin_session;
      if (!store || !store.activity || !store.activity.tracking_started_at) return 'Not tracked yet';
      if (!visit) return 'No non-founder session since ' + formatDate(store.activity.tracking_started_at);
      var visitor = visit.customer_display_name
        || (visit.visitor_type === 'anonymous' ? 'Anonymous visitor' : 'Signed-in customer');
      return visitor + ' · ' + formatDate(visit.at);
    }

    function lastCustomerText(store) {
      if (store && store.observability && store.observability.sessions === false) return 'Customer activity is unavailable';
      var activity = store && store.activity && store.activity.last_authenticated_customer_activity;
      if (!activity) return 'No signed-in customer activity tracked yet';
      return (activity.customer_display_name || 'Customer') + ' · ' + formatDate(activity.at);
    }

    function storeAgeText(store) {
      if (store && store.observability && store.observability.store_age === false) return 'Age not observable';
      var decision = (store && store.decision) || {};
      if (decision.age_days === null || decision.age_days === undefined) return 'Age not observable';
      var days = Number(decision.age_days || 0);
      return days === 0 ? 'Built today' : (formatNumber(days) + ' day' + (days === 1 ? '' : 's') + ' old');
    }

    function productText(product, dateField) {
      if (!product) return 'No attributed product found';
      var at = product[dateField || 'created_at'];
      return (product.title || 'Untitled product') + ' · ' + (product.status || 'Unknown') + ' · ' + formatDate(at);
    }

    function decisionLabel(store) {
      var decision = (store && store.decision) || {};
      var labels = {
        converting: 'Converting',
        engaged: 'Has engagement',
        new: 'New store',
        not_observable: 'Data unavailable',
        not_tracked: 'Tracking not started',
        no_traction: 'No traction — review',
        watch: 'Watch'
      };
      return labels[decision.traction] || 'Status unavailable';
    }

    function decisionSummary(store) {
      if (!store) return 'Statistics have not loaded yet.';
      var decision = store.decision || {};
      if (decision.delete_candidate) {
        return 'Cold-outreach deletion candidate. It has at least 7 days of store age and tracking, with no paid orders, non-admin members, or non-founder sessions. Review manually before any action.';
      }
      if (decision.review_candidate) {
        return 'No traction after a complete 7-day observation window. Confirm the store source and owner context before deleting it.';
      }
      if (decision.traction === 'not_tracked') {
        return 'Session tracking has not started, so zero sessions cannot be used as evidence to delete this store.';
      }
      if (decision.traction === 'not_observable') {
        return 'One or more required monitoring sources are unavailable. This store cannot be evaluated for deletion until reporting recovers.';
      }
      if (decision.traction === 'new') {
        return 'This store is still inside its first 7 days. Watch members, non-founder sessions, and paid orders before judging traction.';
      }
      if (decision.traction === 'converting') return 'This store has at least one attributed paid order.';
      if (decision.traction === 'engaged') return 'This store has member or non-founder storefront activity, even if it has not converted yet.';
      return (decision.reasons || []).join(' · ') || 'No monitoring warning is active.';
    }

    function adminText(store) {
      var customers = (store && store.customers) || {};
      var names = [];
      (customers.store_admins || []).forEach(function(admin){
        names.push((admin.display_name || 'Store admin') + (admin.email ? ' (' + admin.email + ')' : ''));
      });
      (customers.platform_admins || []).forEach(function(admin){
        names.push((admin.display_name || 'Platform admin') + ' — platform' + (admin.email ? ' (' + admin.email + ')' : ''));
      });
      return formatNumber(customers.effective_admin_count) + ' effective admin'
        + (Number(customers.effective_admin_count) === 1 ? '' : 's')
        + (names.length ? ': ' + names.join(', ') : '');
    }

    function ensureStoreCard(store) {
      if (!store || !store.handle) return;
      var handle = String(store.handle);
      var exists = Array.prototype.some.call(document.querySelectorAll('.gm-store-card'), function(card){
        return String(card.getAttribute('data-handle') || '') === handle;
      });
      if (exists) return;

      var rawStatus = String(store.status || 'active').toLowerCase();
      var status = ['sleeping', 'waking', 'closed'].indexOf(rawStatus) !== -1 ? rawStatus : 'active';
      var isClosed = status === 'closed';
      var collection = String(store.collection_handle || handle);
      var name = String(store.name || handle);
      var statusLabel = status.charAt(0).toUpperCase() + status.slice(1);
      var grid = document.getElementById(isClosed ? 'closedStoreGrid' : 'activeStoreGrid');
      if (!grid) return;

      var article = document.createElement('article');
      article.className = 'gm-store-card' + (isClosed ? ' gm-closed-card' : '');
      article.setAttribute('data-name', name.toLowerCase());
      article.setAttribute('data-handle', handle);
      article.setAttribute('data-collection', collection);
      article.setAttribute('data-store-name', name);
      article.setAttribute('data-status', status);
      article.setAttribute('data-products', '0');
      article.setAttribute('data-order-count', 'unknown');
      article.setAttribute('data-member-count', 'unknown');
      article.setAttribute('data-session-count', 'unknown');
      article.setAttribute('data-age-days', 'unknown');
      article.setAttribute('data-created-at', '');
      article.setAttribute('data-needs-attention', 'false');
      article.setAttribute('data-review-candidate', 'false');
      article.setAttribute('data-tracking-started', 'false');
      var actions = isClosed
        ? '<a class="gm-btn gm-btn-primary" href="/pages/admin-powers?shop=' + encodeURIComponent(handle) + '" target="_blank" rel="noopener">Admin →</a>'
          + '<button type="button" class="gm-btn" data-open-manage="true">Stats ▾</button>'
          + '<button type="button" class="gm-btn gm-btn-primary" data-wake-handle="' + escapeHtml(handle) + '">Wake Up ☀️</button>'
        : '<a class="gm-btn gm-btn-primary" href="/pages/admin-powers?shop=' + encodeURIComponent(handle) + '" target="_blank" rel="noopener">Admin →</a>'
          + '<a class="gm-btn" href="/collections/' + encodeURIComponent(collection) + '" target="_blank" rel="noopener">Visit ↗</a>'
          + '<button type="button" class="gm-btn" data-open-manage="true">Manage ▾</button>';
      article.innerHTML = '<div class="gm-store-top"><div><h3 class="gm-store-name">' + escapeHtml(name)
        + '</h3><div class="gm-store-handle">' + escapeHtml(handle) + '</div></div><span class="gm-badge ' + status + '">' + escapeHtml(statusLabel) + '</span></div>'
        + '<div class="gm-decision-badge" data-decision-badge></div>'
        + '<div class="gm-store-metrics"><div class="gm-store-metric"><span>Paid orders</span><strong data-metric="orders">—</strong></div>'
        + '<div class="gm-store-metric"><span>Gross sales</span><strong data-metric="gross">—</strong></div>'
        + '<div class="gm-store-metric"><span>Members</span><strong data-metric="members">—</strong></div>'
        + '<div class="gm-store-metric"><span>Sessions</span><strong data-metric="sessions">—</strong></div>'
        + '<div class="gm-store-metric"><span>Products</span><strong data-metric="products">—</strong></div>'
        + '<div class="gm-store-metric"><span>Store age</span><strong data-metric="age">—</strong></div></div>'
        + '<div class="gm-store-activity"><div><strong>Last purchase:</strong> <span data-activity="purchase">Loading…</span></div>'
        + '<div><strong>Last non-founder visit:</strong> <span data-activity="visit">Loading…</span></div>'
        + '<div><strong>Newest product:</strong> <span data-activity="product">Loading…</span></div>'
        + '<div><strong>Admins:</strong> <span data-activity="admins">Loading…</span></div></div>'
        + '<div class="gm-card-actions">' + actions + '</div>';
      grid.appendChild(article);
    }

    function renderActivityLog(store) {
      var container = document.getElementById('manageActivityLog');
      if (!container) return;
      var events = (store && store.recent_activity) || [];
      if (!events.length) {
        container.innerHTML = '<div class="gm-log-row"><span class="gm-log-time">—</span><span class="gm-log-event">No tracked activity yet.</span></div>';
        return;
      }
      container.innerHTML = events.map(function(event){
        var text = '';
        if (event.event_type === 'purchase') {
          text = 'Purchase ' + (event.order_name || '') + ' · '
            + (event.customer_display_name || 'Guest') + ' · '
            + formatMoney(event.gross_amount, event.currency);
        } else {
          var visitor = event.customer_display_name
            || (event.visitor_type === 'super_admin' ? 'Platform super-admin'
              : (event.visitor_type === 'anonymous' ? 'Anonymous visitor'
                : (event.visitor_type === 'role_unknown' ? 'Signed-in visitor (role unavailable)' : 'Signed-in customer')));
          text = 'Storefront session · ' + visitor + (event.path ? ' · ' + event.path : '');
        }
        return '<div class="gm-log-row"><span class="gm-log-time">' + escapeHtml(formatDate(event.at || event.created_at))
          + '</span><span class="gm-log-event">' + escapeHtml(text) + '</span></div>';
      }).join('');
    }

    function renderStoreMetrics(store) {
      if (!store || !store.handle) return;
      var handle = String(store.handle);
      document.querySelectorAll('.gm-store-card').forEach(function(card){
        if (String(card.getAttribute('data-handle') || '') !== handle) return;
        var sales = store.sales || {};
        var activity = store.activity || {};
        var customers = store.customers || {};
        var products = store.products || {};
        var decision = store.decision || {};
        var observable = store.observability || {};
        card.setAttribute('data-order-count', String(Number(sales.order_count || 0)));
        card.setAttribute('data-products', String(Number(products.total || 0)));
        card.setAttribute('data-member-count', String(Number(customers.shopper_count || 0)));
        card.setAttribute('data-session-count', String(Number(activity.non_super_admin_sessions || 0)));
        card.setAttribute('data-age-days', decision.age_days === null || decision.age_days === undefined ? 'unknown' : String(Number(decision.age_days || 0)));
        card.setAttribute('data-created-at', String(store.created_at || ''));
        card.setAttribute('data-gross-sales', String(Number(sales.gross_sales || 0)));
        card.setAttribute('data-needs-attention', decision.needs_attention ? 'true' : 'false');
        card.setAttribute('data-review-candidate', decision.review_candidate ? 'true' : 'false');
        card.setAttribute('data-tracking-started', activity.tracking_started_at ? 'true' : 'false');
        var metrics = card.querySelector('[data-store-metrics]');
        if (metrics) {
          var orders = metrics.querySelector('[data-metric="orders"]');
          var gross = metrics.querySelector('[data-metric="gross"]');
          var sessions = metrics.querySelector('[data-metric="sessions"]');
          var memberCount = metrics.querySelector('[data-metric="members"]');
          var productCount = metrics.querySelector('[data-metric="products"]');
          var age = metrics.querySelector('[data-metric="age"]');
          if (orders) orders.textContent = sales.observable === false ? 'Unavailable' : formatNumber(sales.order_count);
          if (gross) gross.textContent = sales.observable === false ? 'Unavailable' : formatMoney(sales.gross_sales, sales.currency);
          if (sessions) sessions.textContent = observable.sessions === false ? 'Unavailable' : (activity.tracking_started_at
            ? (formatNumber(activity.non_super_admin_sessions) + ' non-founder / ' + formatNumber(activity.total_sessions) + ' total')
            : 'Not tracked');
          if (memberCount) memberCount.textContent = observable.customers === false ? 'Unavailable' : (formatNumber(customers.shopper_count) + ' shoppers / ' + formatNumber(customers.total) + ' tagged');
          if (productCount) productCount.textContent = observable.products === false ? 'Unavailable' : formatNumber(products.total);
          if (age) age.textContent = storeAgeText(store);
        }
        var badge = card.querySelector('[data-decision-badge]');
        if (badge) {
          badge.textContent = decisionLabel(store);
          badge.classList.add('show');
          badge.classList.toggle('good', decision.traction === 'converting' || decision.traction === 'engaged');
        }
        var activityBox = card.querySelector('[data-store-activity]');
        if (activityBox) {
          var purchase = activityBox.querySelector('[data-activity="purchase"]');
          var visit = activityBox.querySelector('[data-activity="visit"]');
          var newestProduct = activityBox.querySelector('[data-activity="product"]');
          var admins = activityBox.querySelector('[data-activity="admins"]');
          if (purchase) purchase.textContent = purchaseText(store);
          if (visit) visit.textContent = otherVisitText(store);
          if (newestProduct) newestProduct.textContent = observable.products === false ? 'Product data is unavailable' : productText(products.newest_product, 'created_at');
          if (admins) admins.textContent = formatNumber(customers.effective_admin_count) + ' effective · ' + formatNumber(customers.store_admin_count) + ' store-scoped';
        }
      });
    }

    function renderManageStats(store) {
      var sales = (store && store.sales) || {};
      var activity = (store && store.activity) || {};
      var customers = (store && store.customers) || {};
      var products = (store && store.products) || {};
